<?xml version="1.0" encoding="UTF-8"?>

<!-- Carrier policy XML for Vodafone.
$Header: $
-->

<policy name        = "generic"
        changelist  = "$Change: $"
        policy_ver  = "120.2.1"
>

  <initial>

    <define_fullrat_config>
      <ue_mode> CSFB </ue_mode>
      <rat_capability base="none">
        <include> C H G W L T </include>
      </rat_capability>
    </define_fullrat_config>

  </initial>


  <if>
    <not> <phone_operating_mode> ONLINE </phone_operating_mode> </not>
    <then> 
      <stop />
    </then>
  </if>

  <if>
    <have_location />
    <then>
      <svc_mode> FULL </svc_mode>
      <ue_mode> NORMAL </ue_mode>
      <continue />
    </then>
  </if>
  
  <if>
    <all_of>
      <any_of>
        <sim_type> 3G </sim_type>
        <sim_type> 2G </sim_type>
      </any_of>
      <not> <fdn_status session="GW"> NONE </fdn_status> </not>
    </all_of>
    <then>
      <if>
        <all_of>
          <fdn_status session="GW"> ENABLED </fdn_status>
          <not> <fdn_has> *99# </fdn_has> </not>
        </all_of>
        <then>
          <rat_capability base = "config" >
            <exclude> LTE </exclude>
          </rat_capability>
        </then>
        <else>
          <rat_capability base = "config" />
        </else>
      </if>
    </then>
  </if>

</policy>
