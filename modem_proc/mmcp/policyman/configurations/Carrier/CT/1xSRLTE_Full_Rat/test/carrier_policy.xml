<?xml version="1.0" encoding="UTF-8"?>

<!-- Carrier Policy file for SRLTE GWL roaming.
     Startup and LPM->online in Full-RAT mode

$Header: //components/rel/mmcp.mpss/7.9.0/policyman/configurations/Carrier/CT/1xSRLTE_Full_Rat/test/carrier_policy.xml#1 $
-->
<policy name        = "generic"
        changelist  = "$Change: 31300932 $"
        policy_ver  = "83.3.11"
>

  <initial>

    <mcc_list name="sxlte_mccs"> 001 002 003 004 005 006 007 008 009 010 011 012 455 460 310 330 374 </mcc_list>

    <mcc_list name="home_mccs">
      460
    </mcc_list>

    <plmn_list name="sxlte_plmns">
      455-02 455-07 460-03 460-11 001-01 330-01 374-01 310-00 310-01
    </plmn_list>

    <define_fullrat_config timer_secs = "1200">
      <ue_mode> CSFB </ue_mode>
      <rat_capability base="none">
        <include> C H G W L </include>
      </rat_capability>
      <rf_bands base="hardware" />
      <scan_optimization tgpp="no_auto_camp_only" tgpp2="wrlf" />
    </define_fullrat_config>

    <define_timer name="1x_oos" interval="1" units="min" id="100" />

    <rat_capability base="none">
      <include> C H G W L </include>
    </rat_capability>

    <feature single_sim="srlte"> dualmmode </feature>

    <ue_mode> CSFB </ue_mode>

    <rf_bands base="hardware" />

    <fullrat_enter />

    <boolean_define name="cm:L1x_before_GW_in_e911" initial="true" />
	
    <boolean_set name="cm:L1x_before_GW_in_e911">
      <current_mcc_in list="sxlte_mccs" />
    </boolean_set>

  </initial>

  <if>
    <not> <phone_operating_mode> ONLINE </phone_operating_mode> </not>
    <then>
      <fullrat_enter />
    </then>
  </if>

  <if>
    <any_of>
      <not> <phone_operating_mode> ONLINE </phone_operating_mode> </not>
      <not> <have_location /> </not>
    </any_of>
    <then>
      <stop />
    </then>
  </if>

  <!-- Beyond this point, the device is ONLINE and has a location. -->
  <svc_mode> FULL </svc_mode>

  <if>
    <have_serving_system />
    <then>
      <if>
        <location_mcc_in list="home_mccs" />
        <then> <ca_band_combos string="5AA-1A-mAll;5A-1AA-mAll;3AA-1A-mAll;3A-1AA-mAll;5AA-3A-mAll;5A-3AA-mAll;5AA-3A-1A-mAll;5A-3AA-1A-mAll;5A-3A-1AA-mAll;" /> </then>
        <else>
         <ca_band_combos string="" />
        </else>
      </if>
      <continue />
    </then>
  </if>

  <select>
    <case>
      <all_of>
        <any_of>
          <sim_type> CSIM </sim_type>
          <sim_type> RUIM </sim_type>
        </any_of>
        <not> <sim_type> 3G </sim_type> </not>
        <location_mcc_in list="sxlte_mccs" />
      </all_of>
      <then>
        <rat_capability base="none">
          <include> C H </include>
        </rat_capability>
        <rf_bands base="hardware" />
        <ue_mode> CSFB </ue_mode>
        <boolean_set name="cm:L1x_before_GW_in_e911" value="true" />
      </then>
    </case>

    <case>
      <location_mcc_in list="sxlte_mccs" />
      <then>
        <rat_capability base="none">
          <include> C H L </include>
        </rat_capability>
        <rf_bands base="hardware" />
        <ue_mode> 1X_CSFB_PREF </ue_mode>
        <boolean_set name="cm:L1x_before_GW_in_e911" value="true" />
      </then>
    </case>

    <case>
      <true />
      <then>
        <rat_capability base="none">
          <include> G W L </include>
        </rat_capability>
        <rf_bands base="hardware" />
        <ue_mode> CSFB </ue_mode>
        <boolean_set name="cm:L1x_before_GW_in_e911" value="false" />
      </then>
    </case>
  </select>

</policy>
