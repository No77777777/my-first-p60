<?xml version="1.0" encoding="UTF-8"?>

<!-- Carrier configuration file for SRLTE with CHGWL roaming 
$Header: //components/rel/mmcp.mpss/7.9.0/policyman/configurations/Carrier/Sprint/1xSRLTE/Ext_PLMN/carrier_policy.xml#1 $
-->
<policy name        = "generic"
        changelist  = "$Change: 31300932 $"
        policy_ver  = "90.1.7"
>

  <initial>

    <!-- List of the MCCs in which SRLTE is allowed -->
    <mcc_list name="sxlte_mccs"> 310 311 312 313 314 315 316 330 </mcc_list>

    <define_fullrat_config>
      <ue_mode> CSFB </ue_mode>
    </define_fullrat_config>

    <!-- These are the serving system PLMNs for which SRLTE will be allowed
     -->
    <!-- NOTE: Proper functioning of the SXLTE policy requires that there
         be an PLMN list named "sxlte_plmns". Do NOT rename this list.
    -->
    <plmn_list name = "sxlte_plmns">
      310-130 310-580 310-620 310-920 311-010 311-040 311-230
      311-530 311-580 311-650 311-810 311-910 311-915 312-290 312-420
      312-430 312-710 330-120 312-280 310-020 310-450 311-990 311-340
      311-670 312-260 312-480 312-720 312-130 313-220 313-010 313-020
      313-030 313-040 313-050
    </plmn_list>

    <rat_capability base="none">
      <include> C H G W L T </include>
    </rat_capability>

    <ue_mode_if> 1X_CSFB_PREF </ue_mode_if>

    <rf_bands base="hardware" />

    <feature single_sim="srlte"> dualmmode </feature>

  </initial>

  <if>
    <not> <sim_type> 3G </sim_type> </not>
    <then>
      <ue_mode> CSFB </ue_mode>
      <continue />
    </then>
  </if>

  <if>
    <any_of>
      <not> <phone_operating_mode> ONLINE </phone_operating_mode> </not>
      <not> <have_location /> </not>
    </any_of>
    <then>
      <stop />
    </then>
  </if>

  <!-- Beyond this point, the device is ONLINE and has a location. -->
  <if>
    <all_of>
      <serving_plmn_in list="sxlte_plmns" />
      <sim_type> 3G </sim_type>
    </all_of>
    <then> <ue_mode> 1X_CSFB_PREF </ue_mode> </then>
    <else> <ue_mode> CSFB </ue_mode> </else>
  </if>

</policy>
