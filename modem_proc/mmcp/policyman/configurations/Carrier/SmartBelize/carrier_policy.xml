<?xml version="1.0" encoding="UTF-8"?>

<!-- Configuration file for Smart Belize - SRLTE with CHGWL roaming
$Header: //components/rel/mmcp.mpss/7.9.0/policyman/configurations/Carrier/SmartBelize/carrier_policy.xml#1 $
-->
<policy name        = "generic"
        changelist  = "$Change: 31300932 $"
        policy_ver  = "108.1.3"
>

  <initial>

    <mcc_list name="sxlte_mccs"> 702 </mcc_list>

    <feature single_sim="srlte"> dualmmode </feature>

    <define_fullrat_config timer_secs = "60">
      <ue_mode> CSFB </ue_mode>
      <rat_capability base="none">
        <include> C H G W L </include>
      </rat_capability>
    </define_fullrat_config>

    <rat_capability base = "none">
      <include> C H L </include>
    </rat_capability>

    <rf_bands base="hardware" />

    <ue_mode> 1XSRLTE_ONLY </ue_mode>

  </initial>

  <if>
    <not> <phone_operating_mode> ONLINE </phone_operating_mode> </not>
    <then>
      <fullrat_enter />
    </then>
  </if>

  <if>
    <any_of>
      <not> <phone_operating_mode> ONLINE </phone_operating_mode> </not>
      <not> <have_location /> </not>
    </any_of>
    <then>
      <stop />
    </then>
  </if>

  <!-- Beyond this point, the device is ONLINE and has a location. -->
  <svc_mode> FULL </svc_mode>

  <if>
    <location_mcc_in list="sxlte_mccs" />
    <then>
      <ue_mode> 1XSRLTE_ONLY </ue_mode>
      <rat_capability base="none">
        <include> C H L </include>
      </rat_capability>
    </then>
    <else>
      <ue_mode> CSFB </ue_mode>
      <rat_capability base="none">
        <include> C H G W L </include>
      </rat_capability>
    </else>
  </if>

</policy>
