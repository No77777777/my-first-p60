# --------------------------------------------------------------------------- #
#                    Import MBS (Modem Build System)                          #
# --------------------------------------------------------------------------- #
Import('mbs')

# --------------------------------------------------------------------------- #
#                            Build Component                                  #
# --------------------------------------------------------------------------- #
# Get our config
config = mbs.get_attribute('my_config')

# Build the component from source
mbs.build_source(incdirs=['.','rtpersrc', 'rtsrc', 'rtxsrc'],
                 srcdirs=['rtpersrc', 'rtsrc', 'rtxsrc'],
                 bypass_cmi=True, ship_as_lib=True, bypass_bypass=['.'])
