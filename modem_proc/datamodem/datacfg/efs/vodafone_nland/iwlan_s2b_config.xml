<?xml version="1.0" ?>
<IWLAN_S2B_CONFIG>
    <GENERIC_VARIANT>
        <epdg_addr_info>
            <static_fqdn_enabled>FALSE</static_fqdn_enabled>
            <plmn_list/>            
        </epdg_addr_info>
        <ikev2_info>
            <self_id>
                <id_type>ID_RFC822_ADDR</id_type>
                <mac_enabled>FALSE</mac_enabled>
                <identifier/>
            </self_id>
            <ikev2_sa_rekey_timer>
                <soft_sec>43200</soft_sec>
                <hard_sec>43300</hard_sec>
            </ikev2_sa_rekey_timer>
            <esp_rekey_timer>
                <soft_sec>43200</soft_sec>
                <hard_sec>43300</hard_sec>
            </esp_rekey_timer>
            <ke_payload_enabled>FALSE</ke_payload_enabled>
            <ikev2_encr_algo_list>
                <encr_algo value="12"/>
                <encr_algo value="3"/>
                <encr_algo value="13">
                    <key_size>128</key_size>
                </encr_algo>
            </ikev2_encr_algo_list>
            <ikev2_hash_algo_list>
                <algo value="12"/>
                <algo value="2"/>
                <algo value="5"/>
            </ikev2_hash_algo_list>
            <ikev2_prf_algo_list>
                <prf_algo value="5"/>
                <prf_algo value="4"/>
                <prf_algo value="2"/>
            </ikev2_prf_algo_list>
            <ikev2_dh_group_list>
                <dh_group value="14"/>
                <dh_group value="5"/>
                <dh_group value="2"/>
            </ikev2_dh_group_list>
            <esp_encr_algo_list>
                <encr_algo value="12"/>
                <encr_algo value="3"/>
                <encr_algo value="13">
                    <key_size>128</key_size>
                </encr_algo>
            </esp_encr_algo_list>
            <esp_auth_algo_list>
                <algo value="12"/>
                <algo value="2"/>
                <algo value="5"/>
            </esp_auth_algo_list>
            <peer_auth_req_type>CERT_REQ</peer_auth_req_type>
            <cert_lookup_settings>
                <enabled>TRUE</enabled>
                <lookup_timer_sec>1000</lookup_timer_sec>
            </cert_lookup_settings>
            <fragmentation>
                <enabled>TRUE</enabled>
                <ipv4_fragment_size>1024</ipv4_fragment_size>
                <ipv6_fragment_size>1024</ipv6_fragment_size>
            </fragmentation>
            <dyn_cert_retrieval_info>
                <enabled>TRUE</enabled>
            </dyn_cert_retrieval_info>
        </ikev2_info>
        <err_code_info>
            <pdn_throttling>
                <throttling_series id="1">
                    <throttling_values>
                        <seconds>1800</seconds>
                    </throttling_values>
                    <throttling_cause_codes>
                        <cause_code>9002</cause_code>
                    </throttling_cause_codes>
                </throttling_series>
            </pdn_throttling>	        	
            <level_throttling_disabled>FALSE</level_throttling_disabled>
        </err_code_info>         
    </GENERIC_VARIANT>
    <WP_VARIANT>
        <ikev2_info>
            <esp_auth_algo_list>
                <algo value="12"/>
                <algo value="2"/>
            </esp_auth_algo_list>
            <configured_ike_port>4500</configured_ike_port>
        </ikev2_info>
    </WP_VARIANT>
</IWLAN_S2B_CONFIG>
