/*========================================================================
  TCM overlay checks.
  Validate that required overlay combinations can be loaded together.
  ========================================================================*/

__tcm_overlay_available__ =  __tcm_max_size__ - __tcm_static_max_size__ ; 


__assert_sink__ = ASSERT( (__tcm_cdma1x_traffic_overlay_size__ + __tcm_mcdo_traffic_overlay_size__) <= __tcm_overlay_available__ , "Failed overlay check SVDO");
__assert_sink__ = ASSERT( (__tcm_cdma1x_traffic_overlay_size__ + __tcm_lte_traffic_overlay_size__ + __tcm_lte_paging_overlay_size__)  <= __tcm_overlay_available__ , "Failed overlay check SVLTE");
__assert_sink__ = ASSERT( (__tcm_gfw_traffic_overlay_size__ + __tcm_lte_traffic_overlay_size__ + __tcm_lte_paging_overlay_size__)  <= __tcm_overlay_available__ , "Failed overlay check SGLTE");

/* __assert_sink__ = ASSERT( (__tcm_wfw_traffic_overlay_size__ + __tcm_wfw_paging_overlay_size__ + __tcm_cdma1x_traffic_overlay_size__)  <= __tcm_overlay_available__ , "Failed overlay check W+1X DSDS");*/
__assert_sink__ = ASSERT( (__tcm_tfw_traffic_overlay_size__ + __tcm_tfw_paging_overlay_size__ + __tcm_cdma1x_traffic_overlay_size__)  <= __tcm_overlay_available__ , "Failed overlay check T+1X DSDS");
__assert_sink__ = ASSERT( (__tcm_lte_traffic_overlay_size__ + __tcm_lte_paging_overlay_size__ + __tcm_cdma1x_traffic_overlay_size__)  <= __tcm_overlay_available__ , "Failed overlay check L+1X DSDS");

__assert_sink__ = ASSERT( ((DEFINED(__tcm_xlte_sw_overlay_max_size__) ? __tcm_xlte_sw_overlay_max_size__ : 0) + __tcm_lte_traffic_overlay_size__ + __tcm_cdma1x_traffic_overlay_size__)  <= __tcm_overlay_available__ , "Failed overlay check 1X Traffic + LTE Traffic + XLTE");

__assert_sink__ = ASSERT( (__tcm_cdma1x_traffic_overlay_size__ + __tcm_tfw_traffic_overlay_size__ + __tcm_tfw_paging_overlay_size__)  <= __tcm_overlay_available__ , "Failed overlay check T Traffic + T Paging + 1X Traffic");
__assert_sink__ = ASSERT( (__tcm_wfw_paging_overlay_size__ + __tcm_tfw_traffic_overlay_size__ + __tcm_tfw_paging_overlay_size__)  <= __tcm_overlay_available__ , "Failed overlay check T Traffic + T Paging + W paging");

__assert_sink__ = ASSERT( (__tcm_lte_traffic_overlay_size__ + (DEFINED(__has_lte_plus_wpage__) ? __tcm_wfw_paging_overlay_size__ : 0))  <= __tcm_overlay_available__ , "Failed overlay check L traffic + W page");


