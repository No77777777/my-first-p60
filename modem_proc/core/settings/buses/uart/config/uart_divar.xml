<?xml version="1.0" encoding="utf-8"?>
<driver name="Uart">
<include file="DALSys.h"/>
<include file="uart_device_props.h"/>
<include file="DDITlmm.h"/>
<include file="icbarb.h"/>

<!-- ======================================================================================================
     PnocIBval or PnocABval value = required bandwidth(in terms of bytes)
                                  = required bandwidth/8(in terms of bits).
     In case of UART we can support the maximum baudrate 4Mbps, so we are voting for the max
     bandwidth(500000).

     The BAM IRQ for BLSP1 is the only BAM IRQ that is routed to MSS.  You must use a UART on BLSP1
     if you want to use it with BAM.

======================================================================================================= -->

  <global_def>
    <var_seq name="qupv3_0_ahb_m_clock_name"  type="DALPROP_DATA_TYPE_STRING">gcc_qupv3_wrap_0_m_ahb_clk</var_seq>
    <var_seq name="qupv3_0_ahb_s_clock_name"  type="DALPROP_DATA_TYPE_STRING">gcc_qupv3_wrap_0_s_ahb_clk</var_seq>
    <var_seq name="qupv3_1_ahb_m_clock_name"  type="DALPROP_DATA_TYPE_STRING">gcc_qupv3_wrap_1_m_ahb_clk</var_seq>
    <var_seq name="qupv3_1_ahb_s_clock_name"  type="DALPROP_DATA_TYPE_STRING">gcc_qupv3_wrap_1_s_ahb_clk</var_seq>
    
	<var_seq name="uart_1_clock_name"  type="DALPROP_DATA_TYPE_STRING">gcc_qupv3_wrap0_s0_clk</var_seq>
    <var_seq name="uart_3_clock_name"  type="DALPROP_DATA_TYPE_STRING">gcc_qupv3_wrap0_s2_clk</var_seq>	
    <var_seq name="uart_7_clock_name"  type="DALPROP_DATA_TYPE_STRING">gcc_qupv3_wrap1_s0_clk</var_seq>
    <var_seq name="uart_9_clock_name"  type="DALPROP_DATA_TYPE_STRING">gcc_qupv3_wrap1_s2_clk</var_seq>
    <var_seq name="uart_10_clock_name"  type="DALPROP_DATA_TYPE_STRING">gcc_qupv3_wrap1_s3_clk</var_seq>	
	
	<var_seq name="uart_1_tx_name"  type="DALPROP_DATA_TYPE_STRING">qup0_l2[0]</var_seq>
    <var_seq name="uart_1_rx_name"  type="DALPROP_DATA_TYPE_STRING">qup0_l3[0]</var_seq>

	<var_seq name="uart_3_tx_name"  type="DALPROP_DATA_TYPE_STRING">qup0_l2[2]</var_seq>
    <var_seq name="uart_3_rx_name"  type="DALPROP_DATA_TYPE_STRING">qup0_l3[2]</var_seq>	
	<var_seq name="uart_3_cts_name" type="DALPROP_DATA_TYPE_STRING">qup0_l0[2]</var_seq>
    <var_seq name="uart_3_rfr_name" type="DALPROP_DATA_TYPE_STRING">qup0_l1[2]</var_seq>
	
	<var_seq name="uart_7_tx_name"  type="DALPROP_DATA_TYPE_STRING">qup1_l2[0]</var_seq>
    <var_seq name="uart_7_rx_name"  type="DALPROP_DATA_TYPE_STRING">qup1_l3[0]</var_seq>
	<var_seq name="uart_7_cts_name"  type="DALPROP_DATA_TYPE_STRING">qup1_l0[0]</var_seq>
    <var_seq name="uart_7_rfr_name"  type="DALPROP_DATA_TYPE_STRING">qup1_l1[0]</var_seq>
	
    <var_seq name="uart_9_tx_name"  type="DALPROP_DATA_TYPE_STRING">qup1_l2[2]</var_seq>
    <var_seq name="uart_9_rx_name"  type="DALPROP_DATA_TYPE_STRING">qup1_l3[2]</var_seq>
	<var_seq name="uart_9_cts_name"  type="DALPROP_DATA_TYPE_STRING">qup1_l0[2]</var_seq>
    <var_seq name="uart_9_rfr_name"  type="DALPROP_DATA_TYPE_STRING">qup1_l1[2]</var_seq>
	
	<var_seq name="uart_10_tx_name"  type="DALPROP_DATA_TYPE_STRING">qup1_l2[3]</var_seq>
    <var_seq name="uart_10_rx_name"  type="DALPROP_DATA_TYPE_STRING">qup1_l3[3]</var_seq>
	<var_seq name="uart_10_cts_name"  type="DALPROP_DATA_TYPE_STRING">qup1_l0[3]</var_seq>
    <var_seq name="uart_10_rfr_name"  type="DALPROP_DATA_TYPE_STRING">qup1_l1[3]</var_seq>	
	
    <var_seq name="uartcxm_bus_clock_name"  type="DALPROP_DATA_TYPE_STRING">mss_cc_coxm_bus_clk</var_seq>
    <var_seq name="uartcxm_core_clock_name" type="DALPROP_DATA_TYPE_STRING">mss_cc_bit_coxm_clk</var_seq>
    <var_seq name="uartcxm_tx_name"  type="DALPROP_DATA_TYPE_STRING">mss_lte_coxm_txd</var_seq>
    <var_seq name="uartcxm_rx_name"  type="DALPROP_DATA_TYPE_STRING">mss_lte_coxm_rxd</var_seq>

  </global_def>

  <!-- =================================================================== -->
  <!-- Build specific properties                                           -->
  <!-- =================================================================== -->

  <device name="uart_build_props">
      <props name="FEATURE_FIRST_UART"        type="DALPROP_ATTR_TYPE_UINT32"> TRUE                         </props>
      <props name="UART_FIRST_DALDEVICEID"    type="DALPROP_ATTR_TYPE_UINT32"> UART_INVALID_DALDEVICEID    </props>
      <props name="UART_FIRST_DRIVER_TYPE"    type="DALPROP_ATTR_TYPE_UINT32"> NO_DRIVER                   </props>
      <props name="UART_FIRST_PD_WAKE_ON_RX"  type="DALPROP_ATTR_TYPE_UINT32"> TRUE                         </props>

      <props name="FEATURE_SECOND_UART"       type="DALPROP_ATTR_TYPE_UINT32"> FALSE                        </props>
      <props name="UART_SECOND_DALDEVICEID"   type="DALPROP_ATTR_TYPE_UINT32"> UART_INVALID_DALDEVICEID     </props>
      <props name="UART_SECOND_DRIVER_TYPE"   type="DALPROP_ATTR_TYPE_UINT32"> NO_DRIVER                    </props>
      <props name="UART_SECOND_PD_WAKE_ON_RX" type="DALPROP_ATTR_TYPE_UINT32"> FALSE                        </props>

      <props name="FEATURE_THIRD_UART"        type="DALPROP_ATTR_TYPE_UINT32"> FALSE                        </props>
      <props name="UART_THIRD_DALDEVICEID"    type="DALPROP_ATTR_TYPE_UINT32"> UART_INVALID_DALDEVICEID     </props>
      <props name="UART_THIRD_DRIVER_TYPE"    type="DALPROP_ATTR_TYPE_UINT32"> NO_DRIVER                    </props>
      <props name="UART_THIRD_PD_WAKE_ON_RX"  type="DALPROP_ATTR_TYPE_UINT32"> FALSE                        </props>

      <props name="FEATURE_CXM_UART"          type="DALPROP_ATTR_TYPE_UINT32"> TRUE                         </props>
      <props name="UART_CXM_DALDEVICEID"      type="DALPROP_ATTR_TYPE_UINT32"> DALDEVICEID_UARTCXM          </props>
      <props name="UART_CXM_DRIVER_TYPE"      type="DALPROP_ATTR_TYPE_UINT32"> PIO_DRIVER                   </props>

      <props name="UART_DAL_LOG_LEVEL"        type="DALPROP_ATTR_TYPE_UINT32"> DALSYS_LOGEVENT_ERROR        </props>
  </device>

