{
    "comment" : [
        "***********************************************************************************",
        " This file stores all features supported by an image. It will be used to determine ",
        " the contents of 'sources_aarch32.cfg', 'sources_aarch64.cfg' as well as the config",
        " files (cfg.c and cfg.h)                                                           ",
        " Each image that uses uclib, needs to have its own json config file as this.       ",
        " This file needs to be updated only when a new feature has been added to an image. ",
        "                                                                                   ",
        " There are few nodes in the beginning of this JSON data structure - 'image-name',  ",
        " 'heap-lite-required', 'default-prng-cb', 'default-engines' etc. to store some     ",
        " specific information.                                                             ",
        " From there onwards the nodes are organized in hierarchial way that represent the  ",
        " algorithm, mode, engine, key-size combinations supported by the image.            ",
        " The hierarchy is as follows:                                                      ",
        "     category-level-node (HASH, CIPHER, MAC)                                       ",
        "       algorithm-node    (SHA2_256, AES, TDES, HMAC)                               ",
        "         mode-node       (CCM, XTS etc.)                                           ",
        "           engine-node   (SW, HWIO, ARMV8, BAM)                                    ",
        "             key-size    (128, 192, 256 - for AES algorithm only)                  ",
        "                                                                                   ",
        "***********************************************************************************"
    ],
    "image-name": "MODEM",
    "heap-lite-required": false,
    "uclib-debug-build": false,
    "compiler-config": {},
    "linker-config": {},
    "default-prng-cb": {
        "DEFAULT_get_prng_data_cb" : "get_prng_data_sw"
    },
    "default-engines": {
        "DEFAULT_HASH_ENGINE"     : "UCLIB_CE_SW",
        "DEFAULT_CIPHER_ENGINE"   : "UCLIB_CE_SW",
        "DEFAULT_PKEY_ENGINE"     : "UCLIB_CE_SW",
        "DEFAULT_KDF_ENGINE"      : "UCLIB_CE_SW",
        "DEFAULT_MAC_ENGINE"      : "UCLIB_CE_SW"
    },
    "offtarget-engine-interface-vs-implementation-mapping": {
        "SW": "SW",
        "ARMV8": "SW",
        "BAM": "SW",
        "HWIO": "SW"
    },
    "supported-categories": ["HASH", "CIPHER", "KDF", "MAC", "PKEY"],
