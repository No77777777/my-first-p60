{
    "comment": [
        "***********************************************************************************",
        " PURPOSE:                                                                          ",
        " This file stores all the UCLIB source files in a hierarchial format and will be   ",
        " used to generate the file 'sources_aarch32.cfg', 'sources_aarch64.cfg' as well as ",
        " to generate config files (cfg.c and cfg.h)                                        ",
        " This file needs to be updated only when a new source file has been added to UCLIB.",
        "                                                                                   ",
        " In short, in JSON format {} stores key:value pairs, [] stores an array            ",
        " In JSON format files we cannot insert comments in between so all the comments need",
        " to be added on the top here.                                                      ",
        " To learn more about JSON data format please visit www.json.org                    ",
        "                                                                                   ",
        " FORMAT:                                                                           ",
        " The nodes in the beginning of the JSON data structure - 'include-files', 'macros' ",
        " and 'rsa-config' are used for generating cfg.c an cfg.h files                     ",
        " The node 'heap-lite' is a special case.                                           ",
        "                                                                                   ",
        " From there onwards the nodes are organized in heirchial way where each node can   ",
        " have 3 sub-nodes called 'common', '64-bit' and '32-bit' to store its dependencies ",
        " for different architectures.                                                      ",
        " The node heirarchy is as below:                                                   ",
        "   top-level       (to store sources common to whole uclib e.g. uclib_env.c)       ",
        "     category-level-node (HASH, CIPHER, MAC)                                       ",
        "       algorithm-node    (SHA2_256, AES, TDES, HMAC)                               ",
        "         mode-node       (CCM, XTS etc.)                                           ",
        "           engine-node   (SW, HWIO, ARMV8, BAM, TME_SEQ, ARMV8_2)                  ",
        "                                                                                   ",
        "***********************************************************************************"
    ],
    "include-files": [
        "uclib_engine.h",
        "uclib_env.h",
        "uclib_rand.h",
        "uclib_hash.h",
        "uclib_pkey.h",
        "uclib_mac.h",
        "uclib_cipher.h",
        "uclib_kdf.h",
        "rand.h",
        "hash.h",
        "pkey.h",
        "mac.h",
        "cipher.h",
        "kdf.h",
        "uclib_util.h",
        "heap_lite.h",
        "env.h"
    ],
    "rsa-config": {
        "RSA_PUBEXP_F4": "(0x10001L)",
        "RSA_DEFAULT_KEY_BITS": "(1024)",
        "RSA_MINIMUM_HASH_LEN": "(16)"
    },
    "macros": {
        "CFG_ALG_MASK(alg)": "(((alg) & 0xFFFF) << 16)",
        "CFG_MODE_MASK(md)": "(((md) & 0xFF) << 8)",
        "CFG_ENG_MASK(eng)": "((eng) & 0xF)",
        "HASH_IS_ALG_VALID(alg)": "(alg < UCLIB_HASH_MAX_ALG_COUNT)",
        "ENG_IS_ENGINE_VALID(eng)": "(eng < UCLIB_ENGINE_MAX_COUNT)",
        "CIPHER_IS_ALG_VALID(alg)": "(alg < UCLIB_CIPHER_MAX_ALG_COUNT)",
        "CIPHER_IS_MODE_VALID(md)": "(md < UCLIB_CIPHER_MAX_MODE_COUNT)",
        "PKEY_IS_ALG_VALID(alg)": "(alg < UCLIB_PKEY_MAX_ALG_COUNT)",
        "KDF_IS_ALG_VALID(alg)": "(alg > UCLIB_KDF_ALG_INVALID && alg < UCLIB_KDF_MAX_ALG_COUNT)",
        "MAC_IS_ALG_VALID(alg)": "(alg < UCLIB_MAC_MAX_ALG_COUNT)"
    },
