/* It is standard process to run the STM description files through the C
   preprocessor to allow for featurization.  Include the necessary header
   files that contain the particular features needed.  */
#include "hdr_variation.h"
#include "target.h"
#include "customer.h"

STATE_MACHINE HDRSRCHARD_SM
{

  ENTRY           hdrsrchard_init;
  EXIT            NULL;
  INITIAL_STATE   HDRSRCHARD_INACTIVE_STATE;
  START_ACTIVE    FALSE;

  STATE HDRSRCHARD_INACTIVE_STATE
  {
    ENTRY   hdrsrchard_enter_inactive;
    EXIT    NULL;

    INPUTS
    {
      HDRSRCHARD_ACTIVATE_CMD              hdrsrchard_activate_tf;
    }
  }

  STATE HDRSRCHARD_FL_ACTIVE_STATE
  {
    ENTRY   hdrsrchard_enter_fl_active;
    EXIT    NULL;

    INPUTS
    {
      HDRSRCHARD_DEACTIVATE_CMD            hdrsrchard_deactivate_tf;
      HDRSRCHARD_SET_TAP_CMD               hdrsrchard_set_tap_tf;
      HDRSRCHARD_SUSPEND_CMD               hdrsrchard_suspend_tf;
      HDRSRCHARD_TIMER_EXP_CMD             hdrsrchard_timer_exp_tf;
    }
  }

  STATE HDRSRCHARD_FL_INACTIVE_DRC_LOW_STATE
  {
    ENTRY   hdrsrchard_enter_fl_inactive_drc_low;
    EXIT    NULL;

    INPUTS
    {
      HDRSRCHARD_DEACTIVATE_CMD            hdrsrchard_deactivate_tf;
      HDRSRCHARD_SET_TAP_CMD               hdrsrchard_set_tap_tf;
      HDRSRCHARD_SUSPEND_CMD               hdrsrchard_suspend_tf;
      HDRSRCHARD_FL_ACTIVITY_CMD           hdrsrchard_fl_activity_tf;
      HDRSRCHARD_DRC_CHANGED_CMD           hdrsrchard_drc_changed_tf;
    }
  }

  STATE HDRSRCHARD_FL_INACTIVE_DRC_HIGH_STATE
  {
    ENTRY   hdrsrchard_enter_fl_inactive_drc_high;
    EXIT    NULL;

    INPUTS
    {
      HDRSRCHARD_DEACTIVATE_CMD            hdrsrchard_deactivate_tf;
      HDRSRCHARD_SET_TAP_CMD               hdrsrchard_set_tap_tf;
      HDRSRCHARD_SUSPEND_CMD               hdrsrchard_suspend_tf;
      HDRSRCHARD_FL_ACTIVITY_CMD           hdrsrchard_fl_activity_tf;
      HDRSRCHARD_DRC_CHANGED_CMD           hdrsrchard_drc_changed_tf;
    }
  }

  STATE HDRSRCHARD_SUSPENDED_STATE
  {
    ENTRY   hdrsrchard_enter_suspended;
    EXIT    NULL;

    INPUTS
    {
      HDRSRCHARD_DEACTIVATE_CMD            hdrsrchard_deactivate_tf;
      HDRSRCHARD_SET_TAP_CMD               hdrsrchard_set_tap_tf;
      HDRSRCHARD_RESUME_CMD                hdrsrchard_resume_tf;
    }
  }

  STATE HDRSRCHARD_TAP_STATE
  {
    ENTRY   hdrsrchard_enter_tap;
    EXIT    NULL;

    INPUTS
    {
      HDRSRCHARD_DEACTIVATE_CMD            hdrsrchard_deactivate_tf;
      HDRSRCHARD_SET_TAP_CMD               hdrsrchard_set_tap_tf;
      HDRSRCHARD_SUSPEND_CMD               hdrsrchard_suspend_tf;
      HDRSRCHARD_RESUME_CMD                hdrsrchard_resume_tf;
    }
  }
}  /* STATE_MACHINE */
