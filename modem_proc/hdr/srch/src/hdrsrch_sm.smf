#include "hdr_variation.h"
#include "target.h"
#include "customer.h"

/* It is standard process to run the STM description files through the C
   preprocessor to allow for featurization.  Include the necessary header
   files that contain the particular features needed.  */

GROUP hdrsrch_stm_group
{
  ENTRY NULL;
  EXIT  NULL;

  WAIT            NULL;
#ifndef FEATURE_HDR_DIME_MODEM
  TCB             hdrsrch_tcb;
#else
  TCB             SELF;
#endif
  INT_CMD_SIG     HDRSRCH_INT_CMD_SIG;
  INT_CMD_QUEUE   hdrsrch_int_cmd_q;
  GLOBAL_GROUP    hdrsrchcom_stm_group;
  DEBUG_HOOK      hdrsrch_stm_debug_hook;
  HEAP_CTOR       NULL;
  HEAP_DTOR       hdrsrchbm_group_heap_clean;
  MALLOC          hdrsrchbm_malloc;
  FREE            hdrsrchbm_free;

  STATE_MACHINE HDRSRCH_SM
  {

    ENTRY           NULL;
    EXIT            NULL;
    INITIAL_STATE   HDRSRCH_STM_STATE;
    START_ACTIVE    TRUE;

    STATE HDRSRCH_STM_STATE
    {
      ENTRY   NULL;
      EXIT    NULL;

      INPUTS
      {

	HDRSRCH_AFC_OPEN_LOOP_CMD       hdrsrch_process_int_cmd_tf;
	HDRSRCH_AFC_ACQ_STARTED_CMD     hdrsrch_process_int_cmd_tf; 
	HDRSRCH_AFC_ACQ_SUCCEEDED_CMD   hdrsrch_process_int_cmd_tf; 
	HDRSRCH_AFC_ACQ_FAILED_CMD      hdrsrch_process_int_cmd_tf; 
	HDRSRCH_AFC_CLOSE_LOOP_CMD      hdrsrch_process_int_cmd_tf;
	HDRSRCH_AFC_TCXO_RELEASED_CMD   hdrsrch_process_int_cmd_tf;
#ifdef FEATURE_HDR_DYNAMIC_IDLE_DIV
	HDRSRCH_DIV_ENABLED_CMD         hdrsrch_process_int_cmd_tf;
	HDRSRCH_DIV_ENABLE_TIMEOUT_CMD  hdrsrch_process_int_cmd_tf;
#endif /* FEATURE_HDR_DYNAMIC_IDLE_DIV */
      }
    
    } /* state */
  
  } /* stm */

}  /* stmgroup */
