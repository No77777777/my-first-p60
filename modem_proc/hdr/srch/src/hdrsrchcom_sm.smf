/* It is standard process to run the STM description files through the C
   preprocessor to allow for featurization.  Include the necessary header
   files that contain the particular features needed.  */
#include "hdr_variation.h"
#include "target.h"
#include "customer.h"

GROUP hdrsrchcom_stm_group
{
  ENTRY NULL;
  EXIT  NULL;

  WAIT            NULL;
#ifndef FEATURE_HDR_DIME_MODEM
  TCB             hdrsrch_tcb;
#else
  TCB             SELF;
#endif
  INT_CMD_SIG     HDRSRCH_INT_CMD_SIG;
  INT_CMD_QUEUE   hdrsrch_int_cmd_q;
  GLOBAL_GROUP    NULL;
  DEBUG_HOOK      hdrsrch_stm_debug_hook;
  HEAP_CTOR       NULL;
  HEAP_DTOR       hdrsrchbm_group_heap_clean;
  MALLOC          hdrsrchbm_malloc;
  FREE            hdrsrchbm_free;

  /* Pull in the AFC state machine */
  #include "hdrsrchafc_sm.smf"

  #include "hdrsrchrfdiv_sm.smf"

  #include "hdrsrchard_sm.smf"

#ifdef FEATURE_HDR_SELECTIVE_TXD
  #include "hdrsrchrftxd_sm.smf"
#endif /* FEATURE_HDR_SELECTIVE_TXD */

}  /* GROUP */
