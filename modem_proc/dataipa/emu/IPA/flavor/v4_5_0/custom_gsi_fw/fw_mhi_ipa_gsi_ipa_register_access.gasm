.definitions:
   ; ********************************************************
   ; * Current firmware version.                            *
   ; ********************************************************
   FIRMWARE_VERSION             = 0xf5

   ; ********************************************************
   ; * MHI constants and structures.                        *
   ; ********************************************************
   
   ; +------------------------------------------------------+
   ; | Transfer ring element (TRE)                          |
   ; +-------------+--------------------------------+-------+
   ; | 32-bit word | Field                          | Bits  |
   ; +-------------+--------------------------------+-------+
   ; | 0-1         | PTR                            | 0-63  |
   ; +-------------+--------------------------------+-------+
   ; | 2           | LEN                            | 0-15  |
   ; +-------------+--------------------------------+-------+
   ; | 3           | CHAIN                          | 0-0   |
   ; |             | IEOB                           | 8-8   |
   ; |             | IEOT                           | 9-9   |
   ; |             | BEI                            | 10-10 |
   ; |             | SCT                            | 11-11 |
   ; |             | TYPE                           | 16-23 |
   ; +-------------+--------------------------------+-------+

   ; CHAIN:
   TRE.CHAIN_SHIFT              = 0 
   TRE.CHAIN_MASK               = 0x1

   ; IEOB:
   TRE.IEOB_SHIFT               = 8
   TRE.IEOB_MASK                = 0x100  

   ; IEOT:
   TRE.IEOT_SHIFT               = 9
   TRE.IEOT_MASK                = 0x200

   ; BEI:
   TRE.BEI_SHIFT                = 10
   TRE.BEI_MASK                 = 0x400

   ; SCT:
   TRE.SCT_SHIFT                = 11
   TRE.SCT_MASK                 = 0x800
   
   ; TYPE:
   TRE.TYPE_SHIFT               = 16
   TRE.TYPE_MASK                = 0x00ff0000
   TRE.TYPE.BUBBLE              = 1
   TRE.TYPE.TRANSFER            = 2
   TRE.TYPE.IMMEDIATE_COMMAND   = 3

   ; +------------------------------------------------------+
   ; | Transfer completion event (TCE)                      |
   ; +-------------+--------------------------------+-------+
   ; | 32-bit word | Field                          | Bits  |
   ; +-------------+--------------------------------+-------+
   ; | 0-1         | PTR                            | 0-63  |
   ; +-------------+--------------------------------+-------+
   ; | 2           | LEN                            | 0-15  |
   ; |             | CODE                           | 24-31 |
   ; +-------------+--------------------------------+-------+
   ; | 3           | TYPE                           | 16-23 |
   ; |             | CHID                           | 24-31 |
   ; +-------------+--------------------------------+-------+

   ; LEN:
   TCE.LEN_SHIFT                = 0
   TCE.LEN_MASK                 = 0xffff

   ; CODE
   TCE.CODE_SHIFT               = 24
   TCE.CODE_MASK                = 0xff000000
   TCE.CODE_SUCCESS             = 0x1000000
   TCE.CODE_EOT                 = 0x2000000
   TCE.CODE_OVERFLOW            = 0x3000000
   TCE.CODE_EOB                 = 0x4000000
   TCE.CODE_OOB                 = 0x5000000
   TCE.CODE_DB_MODE             = 0x6000000
   TCE.CODE_UNDEFINED           = 0x10000000

   ; TYPE:
   TCE.TYPE_SHIFT               = 16
   TCE.TYPE_MASK                = 0xff0000
   TCE.TYPE_TRE_TO_TCE          = 0x200000 ; by OR-ing with this value TRE.TYPE is converted into corresponding TCE.TYPE
   TCE.TYPE_TCE                 = 0x220000
   TCE.TYPE_ICCE                = 0x230000

   ; CHID:
   TCE.CHID_SHIFT               = 24
   TCE.CHID_MASK                = 0xff000000

   ; Memory type encodings:
   ; For performance reasons, MEMTYPE_NORMAL_NON_CACHEABLE is advised
   MEMTYPE_STRONGLY_ORDERED                       = 000b
   MEMTYPE_DEVICE                                 = 001b
   MEMTYPE_NORMAL_NON_CACHEABLE                   = 010b
   MEMTYPE_NORMAL_COPY_BACK_WRITE_ALLOCATE        = 011b
   MEMTYPE_NORMAL_WRITE_THROUGH_NO_WRITE_ALLOCATE = 110b
   MEMTYPE_NORMAL_COPY_BACK_NO_WRITE_ALLOCATE     = 111b
   
   ; ********************************************************
   ; * Some general constants for convenience.              * 
   ; ********************************************************

   TRUE                                  = 1
   FALSE                                 = 0

   ONE_FIRST_REGISTER_ENABLE             = 1000b
   TWO_FIRST_REGISTERS_ENABLE            = 1100b
   THREE_FIRST_REGISTERS_ENABLE          = 1110b
   SECOND_REGISTER_ENABLE                = 0100b
   FIRST_THIRD_FOURTH_REGISTERS_ENABLE   = 1011b
   FIRST_FOURTH_REGISTERS_ENABLE         = 1001b
   ALL_FOUR_REGISTERS_ENABLE             = 1111b

   FIRST_EIGHT_BITS_CLEAN_MASK           = 0xffffff00
   LOW_SIXTEEN_BIT_MASK                  = 0x0000ffff
   HIGH_SIXTEEN_BIT_MASK                 = 0xffff0000
   SIGN_BIT_MASK                         = 0x80000000
   
   BIT_40_CLEAN_MASK                     = 0xfffffeff

   ; ********************************************************
   ; * GSI and IPA constants, registers and fields.         *
   ; ********************************************************
   
   GSI_PERIPH_PENDING_ADDRESS            = 0x4020
   
   GSI_CH_QOS_BASE_ADDRESS               = 0x2005c
   GSI_CH_QOS.USE_DB_ENG_SHIFT           = 9
   GSI_CH_QOS.USE_DB_ENG_MASK            = 0x200
   
   ; The maximal number of IPA endpoints.
   IPA_ENDP_NUMBER                       = 31
   
   ; ********************************************************
   ; * Sequencer related definitions.                       *
   ; ********************************************************

   ; Channel/event encoding used in several instructions.
   EVENT      = 0
   CHANNEL    = 1

   ; Area ID encodings.
   SHRAM_ID_CH_CONTEXT                   = 0
   SHRAM_ID_EV_CONTEXT                   = 1
   SHRAM_ID_RE_STORAGE                   = 2
   SHRAM_ID_RE_ESC_BUFFER                = 3
   SHRAM_ID_EE_SCRATCH                   = 4
   SHRAM_ID_FUNC_STACK                   = 5
   SHRAM_ID_MCS_SCRATCH                  = 6

   ; Area ID usage flag.
   SHRAM_ID_DO_NOT_USE                  = 0
   SHRAM_ID_USE                         = 1
   
   ; The value returned by VIR2PHY when a given virtual event index wasn't allocated.
   VIR2PHY_FAILURE                       = 0xffffffff
   
   ; Special purpose registers.
   CHAIN_REGISTER                        = r10 ; bitmask per transfer channel
   STOP_REGISTER                         = r11 ; bitmask per transfer channel
   GENERAL_PURPOSE_FLAGS_REGISTER        = r12
   INTERRUPT_MASK_REGISTER               = r19 ; 1 - interrupt enabled, 0 - interrupt disabled
   CHANNEL_EMPTY_MASK_REGISTER           = r20
   NEW_TR_MASK_REGISTER                  = r21
   CHANNEL_DORBELL_MASK_REGISTER         = r22
   ACCELERATOR_STATUS_REGISTER           = r23 ; updated after activate_accelerator
   ACCELERATOR_RETURN_VALUE_MSB_REGISTER = r24 ; updated after activate_accelerator
   ACCELERATOR_RETURN_VALUE_LSB_REGISTER = r25 ; updated after activate_accelerator
   STACK_POINTER_REGISTER                = r26
   PENDING_REQUEST_REGISTER              = r27 ; bitmask per transfer channel

   ; Interrupt masks.
   ALLOW_ALL_INTERRUPTS                                    = 0xffffffff
   MASK_ALL_BUT_EVENT_ENGINE.EVENT_GENERATION_COMPLETE     = 0x00000001

   ; Channel pair that is used for UL/DL synchronization.
   UL_DL_SYNC_UL_VIRTUAL_CHANNEL = 0
   UL_DL_SYNC_DL_VIRTUAL_CHANNEL = 1

   ; +------------------------------------------------------+
   ; | ACCELERATOR_STATUS_REGISTER                          |
   ; +----------------------------------------------+-------+
   ; | Field                                        | Bits  |
   ; +----------------------------------------------+-------+
   ; | Status                                       | 0-3   |
   ; | Timer ID(1)                                  | 4-7   |
   ; +----------------------------------------------+-------+
   ;
   ; 1) Relevant only for TIMER.REGISTER_TIMER.

   ; Status:
   ACCELERATOR_STATUS_REGISTER.STATUS_SHIFT                 = 0
   ACCELERATOR_STATUS_REGISTER.STATUS_MASK                  = 0xf
   ACCELERATOR_STATUS_REGISTER.STATUS.SUCCESS               = 0
   ACCELERATOR_STATUS_REGISTER.STATUS.OUT_OF_BUFFERS        = 1
   ACCELERATOR_STATUS_REGISTER.STATUS.BECAME_FULL           = 2
   ACCELERATOR_STATUS_REGISTER.STATUS.BUS_ERROR             = 3

   ; Timer ID:
   ACCELERATOR_STATUS_REGISTER.TIMER_ID_SHIFT               = 4
   ACCELERATOR_STATUS_REGISTER.TIMER_ID_MASK                = 0xf0
   
   ; In IPA_IF the encodings of OUT_OF_BUFFERS and BECAME_FULL were swapped (known bug) - FW is patched to WA this issue.
   ACCELERATOR_STATUS_REGISTER.STATUS.OUT_OF_BUFFERS_IPA_IF = 2
   ACCELERATOR_STATUS_REGISTER.STATUS.BECAME_FULL_IPA_IF    = 1
   
   ; ********************************************************
   ; * Channel context (CC)                                 *
   ; ********************************************************

   ; +------------------------------------------------------+
   ; | Channel context (returned by load_channel_context)   |
   ; +-------------+--------------------------------+-------+
   ; | 32-bit word | Field                          | Bits  |
   ; +-------------+--------------------------------+-------+
   ; | 0           | CHTYPE                         | 0-2   |
   ; |             | CHDIR                          | 3-3   |
   ; |             | EE                             | 4-7   |
   ; |             | CHID                           | 8-12  |
   ; |             | ERINDEX                        | 14-18 |
   ; |             | CHSTATE                        | 20-23 |
   ; |             | ELEMENT_SIZE                   | 24-31 |
   ; +-------------+--------------------------------+-------+
   ; | 1           | WP                             | 0-15  |
   ; +-------------+--------------------------------+-------+
   ; | 2           | RLEN                           | 0-15  |
   ; |             | RP                             | 16-31 |
   ; +-------------+--------------------------------+-------+

   ; +------------------------------------------------------+
   ; | Channel context (the part sitting in SRAM)           |
   ; +-------------+--------------------------------+-------+
   ; | 64-bit word | Field                          | Bits  |
   ; +-------------+--------------------------------+-------+
   ; | 0           | RBASE                          | 0-63  |
   ; +-------------+--------------------------------+-------+
   ; | 1-2         | Scratch                        | 0-63  |
   ; +-------------+--------------------------------+-------+
   ; | 3           | ---                            | 0-63  |
   ; +-------------+--------------------------------+-------+

   ; +------------------------------------------------------+
   ; | MHI Channel Scratch                                  |
   ; +-------------+--------------------------------+-------+
   ; | 32-bit word | Field                          | Bits  |
   ; +-------------+--------------------------------+-------+
   ; | 0           | MHI_DOORBELL_ADDRESS Low       | 0-31  |
   ; +-------------+--------------------------------+-------+
   ; | 1           | MHI_DOORBELL_ADDRESS High      | 0-31  |
   ; +-------------+--------------------------------+-------+
   ; | 2           | UL_DL_SYNC_ACTIVE              | 0-0   |
   ; |             | ASSERT_BIT_40                  | 1-1   |
   ; |             | MAX_OUTSTANDING_TRES           | 16-31 |
   ; +-------------+--------------------------------+-------+
   ; | 3           | STOP_ORIGINATOR_EE             | 0-3   |
   ; |             | UL_DL_SYNC_TIMER_ID            | 4-7   |
   ; |             | POLLING_MODE                   | 8-8   |
   ; |             | NOT_STOP_TIMER_MODE            | 9-9   |
   ; |             | DB_MODE                        | 10-10 |
   ; |             | OUTSTANDING_THRESHOLD          | 16-31 |   
   ; +-------------+--------------------------------+-------+

   ; +------------------------------------------------------+
   ; | xDCI Channel Scratch                                 |
   ; +-------------+--------------------------------+-------+
   ; | 32-bit word | Field                          | Bits  |
   ; +-------------+--------------------------------+-------+
   ; | 0           | LAST_TRB_ADDRESS_LO address    | 0-15  |
   ; |             | XferRscIdx                     | 20-26 |
   ; |             | CONST_BUFF_SIZE (KBytes)       | 27-31 |
   ; +-------------+--------------------------------+-------+
   ; | 1           | DEPCMD_LO address              | 0-31  |
   ; +-------------+--------------------------------+-------+
   ; | 2           | DEPCMD_HI address              | 0-7   |
   ; |             | MAX_OUTSTANDING_TRES           | 16-31 |
   ; +-------------+--------------------------------+-------+
   ; | 3           | STOP_ORIGINATOR_EE             | 0-3   |
   ; |             | POLLING_MODE                   | 8-8   |
   ; |             | NOT_STOP_TIMER_MODE            | 9-9   |
   ; |             | DB_MODE                        | 10-10 |
   ; |             | OUTSTANDING_THRESHOLD          | 16-31 |
   ; +-------------+--------------------------------+-------+

   CC_RAM.ELEMENT_SIZE                   = 4 ; 4 lines of 8 bytes each

   ; Channel scratchpad line 0:
   CC_RAM.SCRATCHPAD0_LOW.OFFSET         = 1
   CC_RAM.SCRATCHPAD0_LOW.MSB            = 0

   CC_RAM.SCRATCHPAD0_HIGH.OFFSET        = 1
   CC_RAM.SCRATCHPAD0_HIGH.MSB           = 1

   ; Channel scratchpad line 1:
   CC_RAM.SCRATCHPAD1_LOW.OFFSET         = 2
   CC_RAM.SCRATCHPAD1_LOW.MSB            = 0

   CC_RAM.SCRATCHPAD1_HIGH.OFFSET        = 2
   CC_RAM.SCRATCHPAD1_HIGH.MSB           = 1

   ; RBASE_LOW:
   CC_RAM.RBASE_LOW.OFFSET               = 0 ; located in the first line
   CC_RAM.RBASE_LOW.MSB                  = 0 ; located in the LSB of this line, i.e. MSB is 0

   ; RBASE_HIGH:
   CC_RAM.RBASE_HIGH.OFFSET              = 0 ; located in the first line
   CC_RAM.RBASE_HIGH.MSB                 = 1 ; located in the MSB of this line

   ; MHI_DOORBELL_ADDRESS_LOW:
   CC_RAM.MHI_DOORBELL_ADDRESS_LOW.OFFSET   = 1 ; located in the second line
   CC_RAM.MHI_DOORBELL_ADDRESS_LOW.MSB      = 0 ; located in the LSB of this line, i.e. MSB is 0

   ; MHI_DOORBELL_ADDRESS_HIGH:
   CC_RAM.MHI_DOORBELL_ADDRESS_HIGH.OFFSET  = 1 ; located in the second line
   CC_RAM.MHI_DOORBELL_ADDRESS_HIGH.MSB     = 1 ; located in the MSB of this line

   ; UL_DL_SYNC_ACTIVE:
   CC_RAM.UL_DL_SYNC_ACTIVE.OFFSET       = 2 ; located in the third line
   CC_RAM.UL_DL_SYNC_ACTIVE.MSB          = 0 ; located in the LSB of this line, i.e. MSB is 0

   ; ASSERT_BIT_40:
   CC_RAM.ASSERT_BIT_40.OFFSET           = 2 ; located in the third line
   CC_RAM.ASSERT_BIT_40.MSB              = 0 ; located in the LSB of this line, i.e. MSB is 0
   
   ; MAX_OUTSTANDING_TRES:
   CC_RAM.MAX_OUTSTANDING_TRES.OFFSET    = 2 ; located in the third line
   CC_RAM.MAX_OUTSTANDING_TRES.MSB       = 0 ; located in the LSB of this line, i.e. MSB is 0

   ; STOP_ORIGINATOR_EE:
   CC_RAM.STOP_ORIGINATOR_EE.OFFSET      = 2 ; located in the third line
   CC_RAM.STOP_ORIGINATOR_EE.MSB         = 1 ; located in the MSB of this line

   ; UL_DL_SYNC_TIMER_ID:
   CC_RAM.UL_DL_SYNC_TIMER_ID.OFFSET     = 2 ; located in the third line
   CC_RAM.UL_DL_SYNC_TIMER_ID.MSB        = 1 ; located in the MSB of this line

   ; POLLING_MODE:
   CC_RAM.POLLING_MODE.OFFSET            = 2 ; located in the third line
   CC_RAM.POLLING_MODE.MSB               = 1 ; located in the MSB of this line

   ; NOT_STOP_TIMER_MODE:
   CC_RAM.NOT_STOP_TIMER_MODE.OFFSET     = 2 ; located in the third line
   CC_RAM.NOT_STOP_TIMER_MODE.MSB        = 1 ; located in the MSB of this line
   
   ; DB_MODE:
   CC_RAM.DB_MODE.OFFSET                 = 2 ; located in the third line
   CC_RAM.DB_MODE.MSB                    = 1 ; located in the MSB of this line

   ; OUTSTANDING_THRESHOLD:
   CC_RAM.OUTSTANDING_THRESHOLD.OFFSET   = 2 ; located in the third line
   CC_RAM.OUTSTANDING_THRESHOLD.MSB      = 1 ; located in the MSB of this line

   ; Masks:
   CC_RAM.RBASE_LOW.POINTER_CLEAN_MASK   = 0xffff0000 ; the lower 16 bits of RBASE, will be retrieved using LOAD_RD_PTR

   ; LAST_TRB_ADDRESS_LO:
   LAST_TRB_ADDRESS_LO.SHIFT                = 0
   LAST_TRB_ADDRESS_LO.MASK                 = 0xffff

   ; ********************************************************
   ; * Event context (EC)                                   *
   ; ********************************************************

   ; +------------------------------------------------------+
   ; | Event context (returned by load_channel_context)     |
   ; +-------------+--------------------------------+-------+
   ; | 32-bit word | Field                          | Bits  |
   ; +-------------+--------------------------------+-------+
   ; | 0           | CHTYPE                         | 0-2   |
   ; |             | EE                             | 4-7   |
   ; |             | EVCHID                         | 8-12  |
   ; |             | INTYPE                         | 16-16 |
   ; |             | CHSTATE                        | 20-23 |
   ; |             | ELEMENT_SIZE                   | 24-31 |
   ; +-------------+--------------------------------+-------+
   ; | 1           | WP                             | 0-15  |
   ; +-------------+--------------------------------+-------+
   ; | 2           | RLEN                           | 0-15  |
   ; |             | RP                             | 16-31 |
   ; +-------------+--------------------------------+-------+

   ; +------------------------------------------------------+
   ; | Event context (the part sitting in SRAM)             |
   ; +-------------+--------------------------------+-------+
   ; | 64-bit word | Field                          | Bits  |
   ; +-------------+--------------------------------+-------+
   ; | 0           | RBASE                          | 0-63  |
   ; +-------------+--------------------------------+-------+
   ; | 1           | RLEN                           | 0-31  |
   ; |             | INT_VEC                        | 32-63 |
   ; +-------------+--------------------------------+-------+
   ; | 2           | MSI_ADDR                       | 0-63  |
   ; +-------------+--------------------------------+-------+
   ; | 3           | Scratch                        | 0-63  |
   ; +-------------+--------------------------------+-------+
   ; | 4           | MHI_RP_ADDRESS                 | 0-63  |
   ; +-------------+--------------------------------+-------+
   ; | 5-7         | ---                            | 0-63  |
   ; +-------------+--------------------------------+-------+

   ; +------------------------------------------------------+
   ; | MHI Event scratch                                    |
   ; +-------------+--------------------------------+-------+
   ; | 32-bit word | Field                          | Bits  |
   ; +-------------+--------------------------------+-------+
   ; | 0           | UL_DL_SYNC_ACTIVE              | 0-0   |
   ; +-------------+--------------------------------+-------+
   ; | 1           | ---                            | 1-31  |
   ; +-------------+--------------------------------+-------+

   ; +------------------------------------------------------+
   ; | xDCI Event scratch                                   |
   ; +-------------+--------------------------------+-------+
   ; | 32-bit word | Field                          | Bits  |
   ; +-------------+--------------------------------+-------+
   ; | 0           | GEVNTCOUNT_LO address          | 0-31  |
   ; +-------------+--------------------------------+-------+
   ; | 1           | GEVNTCOUNT_HI address          | 0-7   |
   ; +-------------+--------------------------------+-------+

   EC_RAM.ELEMENT_SIZE                   = 8 ; 8 lines of 8 bytes each
   
   ; Event scratchpad line 0:
   EC_RAM.SCRATCHPAD0_LOW.OFFSET         = 3
   EC_RAM.SCRATCHPAD0_LOW.MSB            = 0

   EC_RAM.SCRATCHPAD0_HIGH.OFFSET        = 3
   EC_RAM.SCRATCHPAD0_HIGH.MSB           = 1

   ; UL_DL_SYNC_ACTIVE:
   EC_RAM.UL_DL_SYNC_ACTIVE.OFFSET       = 3 ; located in the third line
   EC_RAM.UL_DL_SYNC_ACTIVE.MSB          = 0 ; located in the LSB of this line, i.e. MSB is 0

   ; MHI_RP_ADDRESS_LOW:
   EC_RAM.MHI_RP_ADDRESS_LOW.OFFSET      = 4 ; located in the fourth line
   EC_RAM.MHI_RP_ADDRESS_LOW.MSB         = 0 ; located in the LSB of this line, i.e. MSB is 0

   ; MHI_RP_ADDRESS_HIGH:
   EC_RAM.MHI_RP_ADDRESS_HIGH.OFFSET     = 4 ; located in the fourth line
   EC_RAM.MHI_RP_ADDRESS_HIGH.MSB        = 1 ; located in the MSB of this line, i.e. MSB is 1
   
   ; The constants more or less common to CC and EC:

   ; CHTYPE:
   CC.CHTYPE_SHIFT                       = 0
   CC.CHTYPE_MASK                        = 0x7
   CC.CHTYPE.MHI                         = 0
   CC.CHTYPE.XHCI                        = 1
   CC.CHTYPE.GPI                         = 2
   CC.CHTYPE.XDCI                        = 3

   ; CHDIR:
   CC.CHDIR_SHIFT                        = 3
   CC.CHDIR_MASK                         = 0x8
   CC.CHDIR.INBOUND                      = 0
   CC.CHDIR.OUTBOUND                     = 1

   ; EE:
   CC.EE_SHIFT                           = 4
   CC.EE_MASK                            = 0xf0

   ; CHID:
   CC.CHID_SHIFT                         = 8
   CC.CHID_MASK                          = 0x1f00

   ; EVCHID:
   CC.EVCHID_SHIFT                       = 8
   CC.EVCHID_MASK                        = 0x1f00

   ; EE and CHID together:
   CC.EE_AND_CHID_SHIFT                  = 4
   CC.EE_AND_CHID_MASK                   = 0x1ff0

   ; EE and EVCHID together:
   CC.EE_AND_EVCHID_SHIFT                = 4
   CC.EE_AND_EVCHID_MASK                 = 0x1ff0

   ; ERINDEX:
   CC.ERINDEX_SHIFT                      = 14
   CC.ERINDEX_MASK                       = 0x7c000
   CC.ERINDEX.UNALLOCATED_EVENT          = 0x1f

   ; CHSTATE:
   CC.CHSTATE_SHIFT                      = 20
   CC.CHSTATE_MASK                       = 0xf00000
   CC.CHSTATE_NOT_ALLOCATED              = 0
   CC.CHSTATE_ALLOCATED                  = 1
   CC.CHSTATE_STARTED                    = 2
   CC.CHSTATE_STOPPED                    = 3
   CC.CHSTATE_STOP_IN_PROGRESS           = 4
   CC.CHSTATE_ERROR                      = 15

   ; MHI_DOORBELL_ADDRESS:
   EC.MHI_DOORBELL_ADDRESS_SHIFT         = 0
   EC.MHI_DOORBELL_ADDRESS_LOW_MASK      = 0xffffffff
   EC.MHI_DOORBELL_ADDRESS_HIGH_MASK     = 0x1ff
   
   ; UL_DL_SYNC_ACTIVE (event):
   EC.UL_DL_SYNC_ACTIVE_SHIFT            = 0
   EC.UL_DL_SYNC_ACTIVE_MASK             = 0x1
   
   ; UL_DL_SYNC_ACTIVE (channel):
   CC.UL_DL_SYNC_ACTIVE_SHIFT            = 0
   CC.UL_DL_SYNC_ACTIVE_MASK             = 0x1

   ; ASSERT_BIT_40:
   CC.ASSERT_BIT_40_SHIFT                = 1
   CC.ASSERT_BIT_40_MASK                 = 0x2
   
   ; MAX_OUTSTANDING_TRES:
   CC.MAX_OUTSTANDING_TRES_SHIFT         = 16
   CC.MAX_OUTSTANDING_TRES_MASK          = 0xffff0000

   ; STOP_ORIGINATOR_EE:
   CC.STOP_ORIGINATOR_EE_SHIFT           = 0
   CC.STOP_ORIGINATOR_EE_MASK            = 0xf
   CC.STOP_ORIGINATOR_EE_CLEAN_MASK      = 0xfffffff0

   ; UL_DL_SYNC_TIMER_ID:
   CC.UL_DL_SYNC_TIMER_ID_SHIFT          = 4
   CC.UL_DL_SYNC_TIMER_ID_MASK           = 0xf0
   CC.UL_DL_SYNC_TIMER_ID_CLEAN_MASK     = 0xffffff0f

   ; POLLING_MODE:
   CC.POLLING_MODE_SHIFT                 = 8
   CC.POLLING_MODE_MASK                  = 0x100
   CC.POLLING_MODE_CLEAN_MASK            = 0xfffffeff

   ; NOT_STOP_TIMER_MODE:
   CC.NOT_STOP_TIMER_MODE_SHIFT          = 9
   CC.NOT_STOP_TIMER_MODE_MASK           = 0x200
   CC.NOT_STOP_TIMER_MODE_CLEAN_MASK     = 0xfffffdff

   ; DB_MODE:
   CC.DB_MODE_SHIFT                      = 10
   CC.DB_MODE_MASK                       = 0x400
   
   ; OUTSTANDING_THRESHOLD:
   CC.OUTSTANDING_THRESHOLD_SHIFT        = 16
   CC.OUTSTANDING_THRESHOLD_MASK         = 0xffff0000

   ; WP:
   CC.WP_SHIFT                           = 0
   CC.WP_MASK                            = 0xffff

   ; RP:
   CC.RP_SHIFT                           = 16
   CC.RP_MASK                            = 0xffff0000

   ; RLEN:
   CC.RLEN_SHIFT                         = 0
   CC.RLEN_MASK                          = 0xffff

   ; ********************************************************
   ; * Execution Environment context (EEC)                  *
   ; ********************************************************

   ; +------------------------------------------------------+
   ; | EE context (sitting in SRAM)                         |
   ; +-------------+--------------------------------+-------+
   ; | 64-bit word | Field                          | Bits  |
   ; +-------------+--------------------------------+-------+
   ; | 0           | Scratch                        | 0-63  |
   ; +-------------+--------------------------------+-------+
   ; | 1           | INT_VEC                        | 0-31  |
   ; |             | Reserved                       | 32-63 |
   ; +-------------+--------------------------------+-------+
   ; | 2           | MSI_ADDR                       | 0-63  |
   ; +-------------+--------------------------------+-------+
   ; | 3           | ERROR_LOG                      | 0-31  |
   ; |             | Reserved                       | 32-63 |
   ; +-------------+--------------------------------+-------+
   
   ; +------------------------------------------------------+
   ; | EE scratch                                           |
   ; +-------------+--------------------------------+-------+
   ; | 32-bit word | Field                          | Bits  |
   ; +-------------+--------------------------------+-------+
   ; | 0           | INTER_EE_COMMAND_RETURN_CODE   | 0-2   |
   ; |             | Reserved                       | 3-14  |
   ; |             | USB Max Packet Size: 0-HS, 1-SS| 15-15 |
   ; |             | Reserved                       | 16-23 |
   ; |             | MHI base channel index         | 24-31 |
   ; +-------------+--------------------------------+-------+
   ; | 1           | Reserved                       | 0-31  |
   ; +-------------+--------------------------------+-------+

   EEC_RAM.ELEMENT_SIZE                  = 4 ; 4 lines of 8 bytes each
   
   ; EE scratchpad line 0:
   EEC_RAM.SCRATCHPAD0.OFFSET            = 0
   EEC_RAM.SCRATCHPAD0_LOW               = 0
   EEC_RAM.SCRATCHPAD0_HIGH              = 1
   
   ; Error log:
   EEC_RAM.ERROR_LOG.OFFSET              = 3 ; located in the forth line
   EEC_RAM.ERROR_LOG.MSB                 = 0 ; located in the LSB of this line, i.e. MSB is 0
   
   ; Error log description:
   ERROR_LOG.ROUTINE_OPCODE_SHIFT                          = 0
   ERROR_LOG.ACCELERATOR_OPCODE_SHIFT                      = 4

   ERROR_LOG.ERROR_CODE_SHIFT                              = 12
   ERROR_LOG.ERROR_CODE.MALFORMED_TRE                      = 1
   ERROR_LOG.ERROR_CODE.OUT_OF_BUFFERS                     = 2
   ERROR_LOG.ERROR_CODE.ALLOCATION_OUT_OF_RESOURCES        = 3
   ERROR_LOG.ERROR_CODE.UNSUPPORTED_INTER_EE_OPERATION     = 4
   ERROR_LOG.ERROR_CODE.EVENT_RING_EMPTY                   = 5
   ERROR_LOG.ERROR_CODE.NON_ALLOCATED_EVENT_ACCESS         = 6
   
   ERROR_LOG.CHANNEL_EVENT_INDEX_SHIFT                     = 19
   ERROR_LOG.CHANNEL_EVENT_INDEX_MASK                      = (0x1f << ERROR_LOG.CHANNEL_EVENT_INDEX_SHIFT)
   
   ERROR_LOG.CHANNEL_EVENT_ERROR_SHIFT                     = 24
   ERROR_LOG.CHANNEL_EVENT_ERROR_MASK                      = (0xf << ERROR_LOG.CHANNEL_EVENT_ERROR_SHIFT)
   
   ERROR_LOG.EE_SHIFT                                      = 28
   ERROR_LOG.EE_MASK                                       = (0xf << ERROR_LOG.EE_SHIFT)
   
   ERROR_LOG.BITS_TO_SET_ALWAYS                            = (2 << ERROR_LOG.CHANNEL_EVENT_ERROR_SHIFT)
   ERROR_LOG.CHANNEL_ERROR                                 = (ERROR_LOG.BITS_TO_SET_ALWAYS | (0 << ERROR_LOG.CHANNEL_EVENT_ERROR_SHIFT))
   ERROR_LOG.EVENT_ERROR                                   = (ERROR_LOG.BITS_TO_SET_ALWAYS | (1 << ERROR_LOG.CHANNEL_EVENT_ERROR_SHIFT))
   
   ; MHI base channel index:
   EEC_RAM.MHI_CHANNEL_INDEX_BASE.OFFSET = 0 ; located in the first line
   EEC_RAM.MHI_CHANNEL_INDEX_BASE.MSB    = 0 ; located in the LSB of this line, i.e. MSB is 0
   EEC.MHI_CHANNEL_INDEX_BASE_SHIFT      = 24
   EEC.MHI_CHANNEL_INDEX_BASE_MASK       = 0xff000000

   ; INTER_EE_COMMAND_RETURN_CODE:
   EEC_RAM.INTER_EE_COMMAND_RETURN_CODE.OFFSET = 0 ; located in the first line
   EEC_RAM.INTER_EE_COMMAND_RETURN_CODE.MSB    = 0 ; located in the LSB of this line, i.e. MSB is 0
   EEC.INTER_EE_COMMAND_RETURN_CODE_SHIFT      = 0
   EEC.INTER_EE_COMMAND_RETURN_CODE_CLEAN_MASK = 0xfffffff8
   EEC.INTER_EE_COMMAND_RETURN_CODE_SUCCESS              = 0x0
   EEC.INTER_EE_COMMAND_RETURN_CODE_NO_PENDING_INTERRUPT = 0x6

   ; ********************************************************
   ; * Accelerator name and routine encodings               *
   ; ********************************************************

   ; Accelerator owner - Ron Plewinski.
   IPA_IF                                         = 3
   IPA_IF.PROCESS_DESCRIPTOR                      = 1
   IPA_IF.STOP                                    = 4
   IPA_IF.START                                   = 2
   IPA_IF.RESET                                   = 8

   ; Accelerator owner - Amir Shmul.
   CSR_RESOURCE_ALLOCATOR                         = 2
   CSR_RESOURCE_ALLOCATOR.DEALLOCATE_CHANNEL      = 0
   CSR_RESOURCE_ALLOCATOR.DEALLOCATE_EVENT        = 1
   CSR_RESOURCE_ALLOCATOR.ALLOCATE_CHANNEL        = 2
   CSR_RESOURCE_ALLOCATOR.ALLOCATE_EVENT          = 3
   
   ; Accelerator owner - Amir Shmul.
   RE_ENGINE                                      = 1
   RE_ENGINE.POP                                  = 5
   RE_ENGINE.DISABLE_CHANNEL                      = 1
   RE_ENGINE.ENABLE_CHANNEL                       = 0
   RE_ENGINE.RESET_CHANNEL                        = 2
   RE_ENGINE.COMPLETE                             = 4
   RE_ENGINE.UPDATE_DOORBELL                      = 6
   RE_ENGINE.FLUSH_CHANNEL_PREFETCH               = 3

   ; Accelerator owner - Amir Shmul.
   DOORBELL_ENGINE                                = 13

   ; Accelerator owner - Denis Zakrevsky.
   EVENT_ENGINE                                   = 0
   EVENT_ENGINE.GENERATE_EVENT                    = 0

   ; Accelerator owner - Yinon Mayzels.
   INTERRUPT_ENGINE                               = 4
   INTERRUPT_ENGINE.GENERATE_INTERRUPT            = 1
   INTERRUPT_ENGINE.STOP_INTERRUPT_MODERATION     = 2
   INTERRUPT_ENGINE.CANCEL_INTERRUPT_MODERATION   = 4

   ; Accelerator owner - Shay Maswari.
   READ_WRITE_ENGINE                              = 5
   READ_WRITE_ENGINE.WRITE                        = 1
   READ_WRITE_ENGINE.READ                         = 0

   ; Accelerator owner - Shay Maswari.
   TIMER                                          = 6
   TIMER.REGISTER_TIMER                           = 0
   TIMER.STOP_AND_RELEASE_TIMER                   = 1
   TIMER.GET_TIME                                 = 2
   TIMER.START_TIME                               = 3

   ; Accelerator owner - Yinon Mayzels.
   MICRO_CONTROLLER                               = 7
   
   ; Accelerator activation hints that can be optionally added to ACTIVATE_ACCELERATOR instruction as the third parameter.
   ; TRUE means that the activated routine can lead to OUT_OF_BUFFERS, FALSE means it can't.
   ; Accelerator activation hint doesn't affect the generated code but it's used during construction of the back pressure matrix.
   IPA_IF.STOP_HINT                                = TRUE
   IPA_IF.START_HINT                               = FALSE
   IPA_IF.RESET_HINT                               = TRUE
   IPA_IF.PROCESS_DESCRIPTOR_HINT                  = TRUE
   
   CSR_RESOURCE_ALLOCATOR.ALLOCATE_CHANNEL_HINT    = FALSE
   CSR_RESOURCE_ALLOCATOR.ALLOCATE_EVENT_HINT      = FALSE
   CSR_RESOURCE_ALLOCATOR.DEALLOCATE_CHANNEL_HINT  = FALSE
   CSR_RESOURCE_ALLOCATOR.DEALLOCATE_EVENT_HINT    = FALSE

   RE_ENGINE.POP_HINT                              = FALSE
   RE_ENGINE.DISABLE_CHANNEL_HINT                  = TRUE
   RE_ENGINE.ENABLE_CHANNEL_HINT                   = FALSE
   RE_ENGINE.RESET_CHANNEL_HINT                    = FALSE
   RE_ENGINE.COMPLETE_HINT                         = FALSE
   RE_ENGINE.UPDATE_DOORBELL_HINT                  = FALSE
   RE_ENGINE.FLUSH_CHANNEL_PREFETCH_HINT           = FALSE

   EVENT_ENGINE.GENERATE_EVENT_HINT                = TRUE

   INTERRUPT_ENGINE.GENERATE_INTERRUPT_HINT        = TRUE ; TODO: probably we should use FALSE here because this particular OUT_OF_BUFFERS case is handled by FW.
   INTERRUPT_ENGINE.STOP_INTERRUPT_MODERATION_HINT = TRUE
   INTERRUPT_ENGINE.CANCEL_INTERRUPT_MODERATION_HINT = FALSE

   READ_WRITE_ENGINE.WRITE_SYNC_HINT               = FALSE
   READ_WRITE_ENGINE.READ_SYNC_HINT                = FALSE
   READ_WRITE_ENGINE.WRITE_ASYNC_HINT              = TRUE
   READ_WRITE_ENGINE.READ_ASYNC_HINT               = TRUE

   TIMER.REGISTER_TIMER_HINT                       = TRUE
   TIMER.STOP_AND_RELEASE_TIMER_HINT               = FALSE
   TIMER.GET_TIME_HINT                             = FALSE
   TIMER.START_TIME_HINT                           = FALSE   

   MICRO_CONTROLLER.ROUTINE_HINT                   = FALSE

   ; Accelerator interface structures, field encodings and masks.

   ; ********************************************************
   ; * CSR_RESOURCE_ALLOCATOR                               *
   ; ********************************************************

   ; +------------------------------------------------------+
   ; | Input layout for channel/event command               |
   ; +-------------+-------+--------------------------------+
   ; | 32-bit word | Bits  | Value                          |
   ; +-------------+-------+--------------------------------+
   ; | 0           | 0-4   | Virtual channel/event index    |
   ; | 0           | 8-11  | Originator EE                  |
   ; | 0           | 16-19 | EE                             |
   ; | 1           | 0-7   | Opcode                         |
   ; | 1           | 8-8   | Type                           |
   ; +-------------+-------+--------------------------------+

   ; Channel/event index:
   CSR_RESOURCE_ALLOCATOR.CHANNEL_INDEX_SHIFT              = 0
   CSR_RESOURCE_ALLOCATOR.CHANNEL_INDEX_MASK               = 0x1f

   ; Originator EE:
   CSR_RESOURCE_ALLOCATOR.ORIGINATOR_EE_SHIFT              = 8
   CSR_RESOURCE_ALLOCATOR.ORIGINATOR_EE_MASK               = 0xf00

   ; EE:
   CSR_RESOURCE_ALLOCATOR.EE_SHIFT                         = 16
   CSR_RESOURCE_ALLOCATOR.EE_MASK                          = 0xf0000
   
   ; Opcode:
   CSR_RESOURCE_ALLOCATOR.OPCODE_SHIFT                     = 0
   CSR_RESOURCE_ALLOCATOR.OPCODE_MASK                      = 0xff
   CSR_RESOURCE_ALLOCATOR.OPCODE.ALLOCATE                  = 0
   CSR_RESOURCE_ALLOCATOR.OPCODE.START                     = 1
   CSR_RESOURCE_ALLOCATOR.OPCODE.STOP                      = 2
   CSR_RESOURCE_ALLOCATOR.OPCODE.RESET                     = 9
   CSR_RESOURCE_ALLOCATOR.OPCODE.DEALLOCATE                = 10
   CSR_RESOURCE_ALLOCATOR.OPCODE.DOORBELL_STOP             = 11
   CSR_RESOURCE_ALLOCATOR.OPCODE.CANCEL_INTERRUPT_MODERATION = 14

   ; Type:
   CSR_RESOURCE_ALLOCATOR.TYPE_SHIFT                       = 8
   CSR_RESOURCE_ALLOCATOR.TYPE_MASK                        = 0x100
   CSR_RESOURCE_ALLOCATOR.TYPE.CHANNEL                     = 0
   CSR_RESOURCE_ALLOCATOR.TYPE.EVENT                       = 1

   ; +------------------------------------------------------+
   ; | Input layout for generic command                     |
   ; +-------------+-------+--------------------------------+
   ; | 32-bit word | Bits  | Value                          |
   ; +-------------+-------+--------------------------------+
   ; | 0           | 8-11  | Originator EE                  |
   ; | 1           | 0-31  | Opcode                         |
   ; +-------------+-------+--------------------------------+

   ; +------------------------------------------------------+
   ; | ALLOCATE_CHANNEL                                     |
   ; | ALLOCATE_EVENT                                       |
   ; | DEALLOCATE_CHANNEL                                   |
   ; | DEALLOCATE_EVENT                                     |
   ; +----------+-------+-----------------------------------+
   ; | Register | Bits  | Value                             |
   ; +----------+-------+-----------------------------------+
   ; | R4       | 0-3   | EE                                |
   ; | R4       | 4-8   | Virtual channel index             | 
   ; +----------+-------+-----------------------------------+

   ; EE:
   CSR_RESOURCE_ALLOCATOR.ROUTINE.EE_SHIFT                 = 0
   CSR_RESOURCE_ALLOCATOR.ROUTINE.EE_MASK                  = 0xf

   ; Virtual channel index:
   CSR_RESOURCE_ALLOCATOR.ROUTINE.VIRTUAL_CHANNEL_INDEX_SHIFT = 4
   CSR_RESOURCE_ALLOCATOR.ROUTINE.VIRTUAL_CHANNEL_INDEX_MASK  = 0x1f0

   ; ********************************************************
   ; * INTERRUPT_ENGINE                                     *
   ; ********************************************************

   ; +------------------------------------------------------+
   ; | Input layout for INTERRUPT_MODERATION_STOPPED        |
   ; +----------------------------------------------+-------+
   ; | Parameter                                    | Bits  |
   ; +----------------------------------------------+-------+
   ; | Status                                       | 0-3   |
   ; | User data                                    | 31-63 |
   ; +----------------------------------------------+-------+

   ; +------------------------------------------------------+
   ; | GENERATE_INTERRUPT                                   |
   ; +----------+-------+-----------------------------------+
   ; | Register | Bits  | Value                             |
   ; +----------+-------+-----------------------------------+
   ; | R4       | 0-2   | Type                              |
   ; | R4       | 3-7   | Channel/event index(1)            |
   ; | R4       | 8-11  | EE                                |
   ; | R4       | 12-14 | Status                            |
   ; | R4       | 15-18 | Error type                        |
   ; | R4       | 19-21 | Memory type                       |   
   ; | R4       | 27-27 | Enable interrupt moderation       |
   ; | R4       | 28-31 | Originator EE                     |
   ; +----------+-------+-----------------------------------+
   ;
   ; 1) Virtual index in case of an error, physical otherwise.

   ; Type:
   INTERRUPT_ENGINE.GENERATE_INTERRUPT.TYPE_SHIFT                         = 0
   INTERRUPT_ENGINE.GENERATE_INTERRUPT.TYPE_MASK                          = 0x7
   INTERRUPT_ENGINE.GENERATE_INTERRUPT.CHANNEL_STATE_CHANGE               = 0x1
   INTERRUPT_ENGINE.GENERATE_INTERRUPT.EVENT_STATE_CHANGE                 = 0x2
   INTERRUPT_ENGINE.GENERATE_INTERRUPT.GLOBAL                             = 0x3
   INTERRUPT_ENGINE.GENERATE_INTERRUPT.EVENT_DATA                         = 0x4
   INTERRUPT_ENGINE.GENERATE_INTERRUPT.INVALID_INTERRUPT_TYPE             = 0x7

   ; Channel index:
   INTERRUPT_ENGINE.GENERATE_INTERRUPT.CHANNEL_INDEX_SHIFT                = 3
   INTERRUPT_ENGINE.GENERATE_INTERRUPT.CHANNEL_INDEX_MASK                 = 0xf8

   ; EE:
   INTERRUPT_ENGINE.GENERATE_INTERRUPT.EE_SHIFT                           = 8
   INTERRUPT_ENGINE.GENERATE_INTERRUPT.EE_MASK                            = 0xf00

   ; Status:
   INTERRUPT_ENGINE.GENERATE_INTERRUPT.STATUS_SHIFT                       = 12
   INTERRUPT_ENGINE.GENERATE_INTERRUPT.STATUS_MASK                        = 0x7000
   INTERRUPT_ENGINE.GENERATE_INTERRUPT.ERROR                              = 0x1000
   INTERRUPT_ENGINE.GENERATE_INTERRUPT.GENERAL_PURPOSE_INTERRUPT_1        = 0x2000
   INTERRUPT_ENGINE.GENERATE_INTERRUPT.GENERAL_PURPOSE_INTERRUPT_2        = 0x3000
   INTERRUPT_ENGINE.GENERATE_INTERRUPT.GENERAL_PURPOSE_INTERRUPT_3        = 0x4000

   ; Error type:
   INTERRUPT_ENGINE.GENERATE_INTERRUPT.ERROR_TYPE_SHIFT                   = 15
   INTERRUPT_ENGINE.GENERATE_INTERRUPT.ERROR_TYPE_MASK                    = 0x78000
   INTERRUPT_ENGINE.GENERATE_INTERRUPT.GLOBAL_ERROR                       = 0x8000
   INTERRUPT_ENGINE.GENERATE_INTERRUPT.CHANNEL_ERROR                      = 0x10000
   INTERRUPT_ENGINE.GENERATE_INTERRUPT.EVENT_ERROR                        = 0x18000
   INTERRUPT_ENGINE.GENERATE_INTERRUPT.CHANNEL_OR_EVENT_ERROR             = 0x10000

   ; Memory type:
   INTERRUPT_ENGINE.GENERATE_INTERRUPT.MEMORY_TYPE_SHIFT                  = 19
   INTERRUPT_ENGINE.GENERATE_INTERRUPT.MEMORY_TYPE_MASK                   = 0x380000

   ; Enable interrupt moderation:
   INTERRUPT_ENGINE.GENERATE_INTERRUPT.ENABLE_INTERRUPT_MODERATION_SHIFT  = 27
   INTERRUPT_ENGINE.GENERATE_INTERRUPT.ENABLE_INTERRUPT_MODERATION_MASK   = 0x8000000

   ; Originator EE:
   INTERRUPT_ENGINE.GENERATE_INTERRUPT.ORIGINATOR_EE_SHIFT                = 28
   INTERRUPT_ENGINE.GENERATE_INTERRUPT.ORIGINATOR_EE_MASK                 = 0xf0000000
   
   ; Combined constants and masks:
   ; INTERRUPT_ENGINE.GENERATE_INTERRUPT.TYPE_MASK |
   ; INTERRUPT_ENGINE.GENERATE_INTERRUPT.STATUS_MASK |
   ; INTERRUPT_ENGINE.GENERATE_INTERRUPT.ERROR_TYPE_MASK
   INTERRUPT_ENGINE.GENERATE_INTERRUPT.ERROR_INFORMATION_MASK             = 0x7f007
   INTERRUPT_ENGINE.GENERATE_INTERRUPT.ERROR_INFORMATION_MASK_LSB         = 0xfffff007
   INTERRUPT_ENGINE.GENERATE_INTERRUPT.ERROR_INFORMATION_MASK_MSB         = 0x7ffff

   INTERRUPT_ENGINE.GENERATE_INTERRUPT.GLOBAL_CHANNEL_OR_EVENT_ERROR      = (INTERRUPT_ENGINE.GENERATE_INTERRUPT.GLOBAL | INTERRUPT_ENGINE.GENERATE_INTERRUPT.ERROR | INTERRUPT_ENGINE.GENERATE_INTERRUPT.CHANNEL_OR_EVENT_ERROR)
   INTERRUPT_ENGINE.GENERATE_INTERRUPT.GLOBAL_CHANNEL_OR_EVENT_ERROR_LSB  = (INTERRUPT_ENGINE.GENERATE_INTERRUPT.GLOBAL_CHANNEL_OR_EVENT_ERROR & LOW_SIXTEEN_BIT_MASK)
   INTERRUPT_ENGINE.GENERATE_INTERRUPT.GLOBAL_CHANNEL_OR_EVENT_ERROR_MSB  = (INTERRUPT_ENGINE.GENERATE_INTERRUPT.GLOBAL_CHANNEL_OR_EVENT_ERROR & HIGH_SIXTEEN_BIT_MASK)

   INTERRUPT_ENGINE.GENERATE_INTERRUPT.GLOBAL_CHANNEL_ERROR               = (INTERRUPT_ENGINE.GENERATE_INTERRUPT.GLOBAL | INTERRUPT_ENGINE.GENERATE_INTERRUPT.ERROR | INTERRUPT_ENGINE.GENERATE_INTERRUPT.CHANNEL_ERROR)
   INTERRUPT_ENGINE.GENERATE_INTERRUPT.GLOBAL_CHANNEL_ERROR_LSB           = (INTERRUPT_ENGINE.GENERATE_INTERRUPT.GLOBAL_CHANNEL_ERROR & LOW_SIXTEEN_BIT_MASK)
   INTERRUPT_ENGINE.GENERATE_INTERRUPT.GLOBAL_CHANNEL_ERROR_MSB           = (INTERRUPT_ENGINE.GENERATE_INTERRUPT.GLOBAL_CHANNEL_ERROR & HIGH_SIXTEEN_BIT_MASK)

   INTERRUPT_ENGINE.GENERATE_INTERRUPT.GLOBAL_EVENT_ERROR                 = (INTERRUPT_ENGINE.GENERATE_INTERRUPT.GLOBAL | INTERRUPT_ENGINE.GENERATE_INTERRUPT.ERROR | INTERRUPT_ENGINE.GENERATE_INTERRUPT.EVENT_ERROR)
   INTERRUPT_ENGINE.GENERATE_INTERRUPT.GLOBAL_EVENT_ERROR_LSB             = (INTERRUPT_ENGINE.GENERATE_INTERRUPT.GLOBAL_EVENT_ERROR & LOW_SIXTEEN_BIT_MASK)
   INTERRUPT_ENGINE.GENERATE_INTERRUPT.GLOBAL_EVENT_ERROR_MSB             = (INTERRUPT_ENGINE.GENERATE_INTERRUPT.GLOBAL_EVENT_ERROR & HIGH_SIXTEEN_BIT_MASK)

   ; INTERRUPT_ENGINE.GENERATE_INTERRUPT.EVENT_DATA
   INTERRUPT_ENGINE.GENERATE_INTERRUPT.DESCRIPTOR_PROCESSING_SUCCEESS     = 0x4

   ; +------------------------------------------------------+
   ; | STOP_INTERRUPT_MODERATION                            |
   ; | CANCEL_INTERRUPT_MODERATION                          |
   ; +----------+-------+-----------------------------------+
   ; | Register | Bits  | Value                             |
   ; +----------+-------+-----------------------------------+
   ; | R4       | 0-4   | Physical event index              |
   ; | R4       | 8-10  | Memory type                       |
   ; | R5       | 0-31  | User data                         |
   ; +----------+-------+-----------------------------------+
   
   ; Physical event index:
   INTERRUPT_ENGINE.STOP_INTERRUPT_MODERATION.PHYSICAL_EVENT_INDEX_SHIFT  = 0
   INTERRUPT_ENGINE.STOP_INTERRUPT_MODERATION.PHYSICAL_EVENT_INDEX_MASK   = 0x1f
   
   ; Memory type:
   INTERRUPT_ENGINE.STOP_INTERRUPT_MODERATION.MEMORY_TYPE_SHIFT           = 8
   INTERRUPT_ENGINE.STOP_INTERRUPT_MODERATION.MEMORY_TYPE_MASK            = 0x700
   
   ; Make the field positions in the user data the same as for IPA_IF user data to ease the information propagation.
   ; +------------------------------------------------------+
   ; | User data                                            |
   ; +----------+-------+-----------------------------------+
   ; | Register | Bits  | Value                             |
   ; +----------+-------+-----------------------------------+
   ; | R5       | 1-5   | Physical channel index            |
   ; | R5       | 24-27 | Originator EE                     |
   ; +----------+-------+-----------------------------------+
   
   ; Physical channel index:
   INTERRUPT_ENGINE.USER_DATA.PHYSICAL_CHANNEL_INDEX_SHIFT                = 1
   INTERRUPT_ENGINE.USER_DATA.PHYSICAL_CHANNEL_INDEX_MASK                 = 0x3e
   
   ; Originator EE:
   INTERRUPT_ENGINE.USER_DATA.ORIGINATOR_EE_SHIFT                         = 24
   INTERRUPT_ENGINE.USER_DATA.ORIGINATOR_EE_MASK                          = 0xf000000
   
   ; ********************************************************
   ; * RE_ENGINE                                            *
   ; ********************************************************

   ; +------------------------------------------------------+
   ; | Input layout for NEW_RING_ELEMENT                    |
   ; +----------------------------------------------+-------+
   ; | Parameter                                    | Bits  |
   ; +----------------------------------------------+-------+
   ; | Physical channel index                       | 0-4   |
   ; | Local ring element pointer                   | 8-19  |
   ; +----------------------------------------------+-------+

   ; Physical channel index:
   RE_ENGINE.PHYSICAL_CHANNEL_INDEX_SHIFT         = 0
   RE_ENGINE.PHYSICAL_CHANNEL_INDEX_MASK          = 0x1f

   ; Local ring element pointer:
   RE_ENGINE.LOCAL_RING_ELEMENT_POINTER_SHIFT     = 8
   RE_ENGINE.LOCAL_RING_ELEMENT_POINTER_MASK      = 0xfff00

   ; +------------------------------------------------------+
   ; | Input layout for CHANNEL_DISABLE_COMPLETED           |
   ; +----------------------------------------------+-------+
   ; | Parameter                                    | Bits  |
   ; +----------------------------------------------+-------+
   ; | Status                                       | 0-3   |
   ; | User data                                    | 31-63 |
   ; +----------------------------------------------+-------+

   ; +------------------------------------------------------+
   ; | Input layout for CHANNEL_EMPTY                       |
   ; +----------------------------------------------+-------+
   ; | Parameter                                    | Bits  |
   ; +----------------------------------------------+-------+
   ; | Physical channel index                       | 0-4   |
   ; +----------------------------------------------+-------+

   ; +------------------------------------------------------+
   ; | POP                                                  |
   ; | DISABLE_CHANNEL                                      |
   ; | ENABLE_CHANNEL                                       |
   ; | RESET_CHANNEL                                        |
   ; | COMPLETE                                             |
   ; | UPDATE_DOORBELL                                      |
   ; | FLUSH_CHANNEL_PREFETCH                               |
   ; +----------+-------+-----------------------------------+
   ; | Register | Bits  | Value                             |
   ; +----------+-------+-----------------------------------+
   ; | R4       | 0-4   | Physical channel index            |
   ; | R4       | 8-23  | Doorbell value(1)                 |
   ; | R5       | 0-31  | User data(2)                      |
   ; +----------+-------+-----------------------------------+
   ;
   ; 1) Valid only for UPDATE_DOORBELL routine.
   ; 2) Valid only for DISABLE_CHANNEL routine.

   ; Physical channel index:
   RE_ENGINE.ROUTINE.PHYSICAL_CHANNEL_INDEX_SHIFT = 0
   RE_ENGINE.ROUTINE.PHYSICAL_CHANNEL_INDEX_MASK  = 0x1f

   ; Doorbell value:
   RE_ENGINE.ROUTINE.DOORBELL_VALUE_SHIFT         = 8
   RE_ENGINE.ROUTINE.DOORBELL_VALUE_MASK          = 0xffff00

   ; User data:
   RE_ENGINE.ROUTINE.USER_DATA_SHIFT              = 0
   RE_ENGINE.ROUTINE.USER_DATA_MASK               = 0xffffffff

   ; +------------------------------------------------------+
   ; | User data                                            |
   ; +----------+-------+-----------------------------------+
   ; | Register | Bits  | Value                             |
   ; +----------+-------+-----------------------------------+
   ; | R5       | 0-4   | Physical channel index            |
   ; | R5       | 9-11  | Error type                        |
   ; | R5       | 12-15 | Originator EE                     |
   ; +----------+-------+-----------------------------------+

   ; Physical channel index:
   RE_ENGINE.USER_DATA.PHYSICAL_CHANNEL_INDEX_SHIFT        = 0
   RE_ENGINE.USER_DATA.PHYSICAL_CHANNEL_INDEX_MASK         = 0x1f

   ; Error type:
   RE_ENGINE.USER_DATA.ERROR_TYPE_SHIFT                    = 9
   RE_ENGINE.USER_DATA.ERROR_TYPE_MASK                     = 0xe00
   RE_ENGINE.USER_DATA.ERROR_TYPE_NO_ERROR                 = 0
   RE_ENGINE.USER_DATA.ERROR_TYPE_MALFORMED_TRE            = 1
   RE_ENGINE.USER_DATA.ERROR_TYPE_XDCI_WRONG_HWO           = 2

   ; Originator EE:
   RE_ENGINE.USER_DATA.ORIGINATOR_EE_SHIFT                 = 12
   RE_ENGINE.USER_DATA.ORIGINATOR_EE_MASK                  = 0xf000

   ; ********************************************************
   ; * EVENT_ENGINE                                         *
   ; ********************************************************

   ; +------------------------------------------------------+
   ; | Input layout                                         |
   ; +----------------------------------------------+-------+
   ; | Parameter                                    | Bits  |
   ; +----------------------------------------------+-------+
   ; | Status                                       | 0-3   |
   ; | User data                                    | 32-63 |
   ; +----------------------------------------------+-------+

   ; Status:
   EVENT_ENGINE.STATUS_SHIFT                               = 0
   EVENT_ENGINE.STATUS_MASK                                = 0xf
   EVENT_ENGINE.STATUS.SUCCESS                             = 0
   EVENT_ENGINE.STATUS.EVENT_QUEUE_FULL                    = 1

   ; User data:
   ; TODO: Define the user data layout.
   ;EVENT_ENGINE.USER_DATA.xxx_SHIFT                       = ?
   ;EVENT_ENGINE.USER_DATA.xxx_MASK                        = 0x?

   ; +------------------------------------------------------+
   ; | GENERATE_EVENT                                       |
   ; +----------+-------+-----------------------------------+
   ; | Register | Bits  | Value                             |
   ; +----------+-------+-----------------------------------+
   ; | R4       | 0-3   | Descriptor type                   |
   ; | R4       | 8-12  | Physical event index              |
   ; | R4       | 16-18 | Memory type                       |   
   ; | R4       | 20-23 | EE                                |
   ; | R4       | 24-28 | Physical channel index            |   
   ; | R5-R8    |       | Transfer completion event (above) |
   ; | R9       | 0-31  | User data                         |
   ; +----------+-------+-----------------------------------+

   ; Type:
   EVENT_ENGINE.GENERATE_EVENT.DESCRIPTOR_TYPE_SHIFT       = 0
   EVENT_ENGINE.GENERATE_EVENT.DESCRIPTOR_TYPE_MASK        = 0xf
   EVENT_ENGINE.GENERATE_EVENT.DESCRIPTOR_TYPE_BUBBLE      = 1
   EVENT_ENGINE.GENERATE_EVENT.DESCRIPTOR_TYPE_TRANSFER    = 0
   
   ; Physical event ring index:
   EVENT_ENGINE.GENERATE_EVENT.PHYSICAL_EVENT_INDEX_SHIFT  = 8
   EVENT_ENGINE.GENERATE_EVENT.PHYSICAL_EVENT_INDEX_MASK   = 0x1f00

   ; Memory type:
   EVENT_ENGINE.GENERATE_EVENT.MEMORY_TYPE_SHIFT           = 16
   EVENT_ENGINE.GENERATE_EVENT.MEMORY_TYPE_MASK            = 0x70000
   
   ; EE:
   EVENT_ENGINE.GENERATE_EVENT.EE_SHIFT                    = 20
   EVENT_ENGINE.GENERATE_EVENT.EE_MASK                     = 0xf00000

   ; Physical channel index:
   EVENT_ENGINE.GENERATE_EVENT.PHYSICAL_CHANNEL_INDEX_SHIFT= 24
   EVENT_ENGINE.GENERATE_EVENT.PHYSICAL_CHANNEL_INDEX_MASK = 0x1f000000

   ; Statuses:
   EVENT_ENGINE.GENERATE_EVENT.STATUS.SUCCESS              = 0
   EVENT_ENGINE.GENERATE_EVENT.STATUS.QUEUE_FULL           = 1

   ; ********************************************************
   ; * IPA_IF                                               *
   ; ********************************************************

   ; +------------------------------------------------------+
   ; | Input layout for all the flows                       |
   ; +------------------------------------------------------+
   ; | 32-bit word | Bits  | Value                          |
   ; +-------------+-------+--------------------------------+
   ; | 0           | 0-31  | User data                      |
   ; | 2           | 0-15  | Actual length(1)               |
   ; | 2           | 16-16 | EOT(1)                         |
   ; | 3           | 0-3   | EE(1)                          |
   ; | 3           | 8-12  | Virtual channel index(1)       |
   ; | 3           | 16-19 | Descriptor type(1)             |
   ; | 3           | 24-27 | Status                         |
   ; +-------------+-------+--------------------------------+
   ;
   ; 1) Valid only for DESCRIPTOR_PROCESSING_COMPLETE.

   ; Actual length:
   IPA_IF.ACTUAL_LENGTH_SHIFT            = 0
   IPA_IF.ACTUAL_LENGTH_MASK             = 0xffff

   ; EOT:
   IPA_IF.EOT_SHIFT                      = 16
   IPA_IF.EOT_MASK                       = 0x10000

   ; Status:
   IPA_IF.STATUS_SHIFT                   = 24
   IPA_IF.STATUS_MASK                    = 0xf000000
   IPA_IF.STATUS.SUCCESS                 = 0
   IPA_IF.STATUS.ALMOST_FULL             = 1
   IPA_IF.STATUS.FULL                    = 2
   IPA_IF.STATUS.ERROR                   = 3

   ; +------------------------------------------------------+
   ; | PROCESS_DESCRIPTOR                                   |
   ; | STOP                                                 |
   ; | START                                                |
   ; | RESET                                                |
   ; +----------+-------+-----------------------------------+
   ; | Register | Bits  | Value                             |
   ; +----------+-------+-----------------------------------+
   ; | R4       | 0-31  | User data                         |
   ; | R6       | 0-15  | Buffer length(1)                  |
   ; | R6       | 16-16 | Chain                             |
   ; | R6       | 20-20 | Direction                         |
   ; | R6       | 24-24 | SCT                               |
   ; | R7       | 0-3   | EE                                |
   ; | R7       | 8-12  | Virtual channel index             |
   ; | R7       | 16-19 | Descriptor type                   |
   ; | R8       | 0-31  | Buffer pointer 0-31               |
   ; | R9       | 0-31  | Buffer pointer 32-63              |
   ; +----------+-------+-----------------------------------+
   ;
   ; 1) Please note that R5 is unused.

   ; Buffer length:
   IPA_IF.BUFFER_LENGTH_SHIFT            = 0
   IPA_IF.BUFFER_LENGTH_MASK             = 0xffff

   ; Chain:
   IPA_IF.CHAIN_SHIFT                    = 16
   IPA_IF.CHAIN_MASK                     = 0x10000

   ; Direction:
   IPA_IF.DIRECTION_SHIFT                = 20
   IPA_IF.DIRECTION_MASK                 = 0x100000

   ; SCT:
   IPA_IF.SCT_SHIFT                      = 24
   IPA_IF.SCT_MASK                      = 0x1000000
   
   ; EE:
   IPA_IF.EE_SHIFT                       = 0
   IPA_IF.EE_MASK                        = 0xf

   ; Virtual channel index:
   IPA_IF.VIRTUAL_CHANNEL_INDEX_SHIFT    = 8
   IPA_IF.VIRTUAL_CHANNEL_INDEX_MASK     = 0x1f00

   ; Descriptor type:
   IPA_IF.DESCRIPTOR_TYPE_SHIFT          = 16
   IPA_IF.DESCRIPTOR_TYPE_MASK           = 0xf0000
   IPA_IF.DESCRIPTOR_TYPE.BUBBLE         = 1
   IPA_IF.DESCRIPTOR_TYPE.TRANSFER       = 2
   IPA_IF.DESCRIPTOR_TYPE.IMMEDIATE      = 3
   IPA_IF.DESCRIPTOR_TYPE.BUBBLE_SHIFTED = 0x10000

   ; Use TRE[3] and put the other data in the reserved fields.
   ; +------------------------------------------------------+
   ; | MHI User data                                        |
   ; +----------+-------+-----------------------------------+
   ; | Register | Bits  | Value                             |
   ; +----------+-------+-----------------------------------+
   ; | R4       | 0-0   | CHAIN                             |
   ; | R4       | 1-5   | Physical channel index            |
   ; | R4       | 8-8   | IEOB                              |
   ; | R4       | 9-9   | IEOT                              |
   ; | R4       | 10-10 | BEI                               |
   ; | R4       | 11-11 | SCT                               |
   ; | R4       | 16-23 | TYPE                              |
   ; | R4       | 24-27 | Originator EE                     |
   ; +----------+-------+-----------------------------------+

   ; CHAIN:
   IPA_IF.USER_DATA.CHAIN_SHIFT          = 0
   IPA_IF.USER_DATA.CHAIN_MASK           = 0x1
   
   ; IEOB:
   IPA_IF.USER_DATA.IEOB_SHIFT           = 8
   IPA_IF.USER_DATA.IEOB_MASK            = 0x100

   ; IEOT:
   IPA_IF.USER_DATA.IEOT_SHIFT           = 9
   IPA_IF.USER_DATA.IEOT_MASK            = 0x200

   ; BEI:
   IPA_IF.USER_DATA.BEI_SHIFT            = 10
   IPA_IF.USER_DATA.BEI_MASK             = 0x400

   ; SCT:
   IPA_IF.USER_DATA.SCT_SHIFT            = 11
   IPA_IF.USER_DATA.SCT_MASK             = 0x800
   
   ; Physical channel index:
   IPA_IF.USER_DATA.PHYSICAL_CHANNEL_INDEX_SHIFT  = 1
   IPA_IF.USER_DATA.PHYSICAL_CHANNEL_INDEX_MASK   = 0x3e
   
   ; TYPE:
   IPA_IF.USER_DATA.TYPE_SHIFT           = 16
   IPA_IF.USER_DATA.TYPE_MASK            = 0xff0000

   ; Originator EE:
   IPA_IF.USER_DATA.ORIGINATOR_EE_SHIFT  = 24
   IPA_IF.USER_DATA.ORIGINATOR_EE_MASK   = 0xf000000

   ; +------------------------------------------------------+
   ; | xDCI User data for IPA_IF.PROCESS_DESCRIPTOR         |
   ; +----------+-------+-----------------------------------+
   ; | Register | Bits  | Value                             |
   ; +----------+-------+-----------------------------------+
   ; | R4       | 0-29  | Buffer address, 10-39             |
   ; +----------+-------+-----------------------------------+

   ; Buffer address:
   IPA_IF.USER_DATA.BUFFER_ADDRESS_LO_SHIFT = 10
   IPA_IF.USER_DATA.BUFFER_ADDRESS_HI_SHIFT = (32 - IPA_IF.USER_DATA.BUFFER_ADDRESS_LO_SHIFT)

   ; ********************************************************
   ; * DOORBELL_ENGINE                                      *
   ; ********************************************************

   ; +------------------------------------------------------+
   ; | Input layout for all the flows                       |
   ; +----------------------------------------------+-------+
   ; | Parameter                                    | Bits  |
   ; +----------------------------------------------+-------+
   ; | Physical channel index                       | 0-4   |
   ; | Doorbell value                               | 8-23  |
   ; +----------------------------------------------+-------+

   ; Physical channel index:
   DOORBELL_ENGINE.PHYSICAL_CHANNEL_INDEX_SHIFT   = 0
   DOORBELL_ENGINE.PHYSICAL_CHANNEL_INDEX_MASK    = 0x1f

   ; Doorbell value:
   DOORBELL_ENGINE.DOORBELL_VALUE_SHIFT           = 8
   DOORBELL_ENGINE.DOORBELL_VALUE_MASK            = 0xffff00

   ; ********************************************************
   ; * TIMER                                                *
   ; ********************************************************

   ; +------------------------------------------------------+
   ; | Input layout                                         |
   ; +----------------------------------------------+-------+
   ; | Parameter                                    | Bits  |
   ; +----------------------------------------------+-------+
   ; | User data                                    | 0-31  |
   ; | Status                                       | 32-35 |
   ; | Timer ID                                     | 36-39 |
   ; +----------------------------------------------+-------+
   
   ; Status:
   TIMER.STATUS_SHIFT                              = 0
   TIMER.STATUS_MASK                               = 0xf

   ; Timer ID:
   TIMER.TIMER_ID_SHIFT                            = 4
   TIMER.TIMER_ID_MASK                             = 0xf0
   
   ; +------------------------------------------------------+
   ; | REGISTER_TIMER                                       |
   ; +----------+-------+-----------------------------------+
   ; | Register | Bits  | Value                             |
   ; +----------+-------+-----------------------------------+
   ; | R4       | 0-0   | Units                             |
   ; | R4       | 16-31 | Duration                          |
   ; | R5       | 0-31  | User data                         |
   ; +----------+-------+-----------------------------------+

   ; +------------------------------------------------------+
   ; | User data                                            |
   ; +----------+-------+-----------------------------------+
   ; | Register | Bits  | Value                             |
   ; +----------+-------+-----------------------------------+
   ; | R5       | 0-4   | Physical channel index            |
   ; | R5       | 5-7   | Timer usage                       |
   ; +----------+-------+-----------------------------------+

   ; Physical channel index:
   TIMER.USER_DATA.PHYSICAL_CHANNEL_INDEX_SHIFT   = 0
   TIMER.USER_DATA.PHYSICAL_CHANNEL_INDEX_MASK    = 0x1f
   
   ; Timer usage:
   TIMER.USER_DATA.TIMER_USAGE_SHIFT              = 5
   TIMER.USER_DATA.TIMER_USAGE_MASK               = 0xe0
   TIMER_USAGE.UL_DL_SYNC_TIMER                   = 0

   ; +------------------------------------------------------+
   ; | STOP_AND_RELEASE_TIMER                               |
   ; +----------+-------+-----------------------------------+
   ; | Register | Bits  | Value                             |
   ; +----------+-------+-----------------------------------+
   ; | R4       | 0-3   | Timer ID                          |
   ; +----------+-------+-----------------------------------+

   ; +------------------------------------------------------+
   ; | START_TIME                                           |
   ; | GET_TIME                                             |
   ; +----------+-------+-----------------------------------+
   ; | Register | Bits  | Value                             |
   ; +----------+-------+-----------------------------------+

   ; Units:
   TIMER.UNITS_SHIFT                     = 0
   TIMER.UNITS_MASK                      = 0x1
   TIMER.UNITS_SLEEP_CLK                 = 0
   TIMER.UNITS_GSI_CLK                   = 1

   ; Duration:
   TIMER.DURATION_SHIFT                  = 16
   TIMER.DURATION_MASK                   = 0xffff0000
   
   ; Combined constants for the timer configurations.
   ; TODO: discuss the right values with Ayala Miller
   TIMER.TIMER_CONFGURATION_UL_DL_SYNC   = 0x000f0000

   ; Statuses:
   TIMER.REGISTER_TIMER.SUCCESS          = 0

   ; ********************************************************
   ; * READ_WRITE_ENGINE                                    *
   ; ********************************************************

   ; +------------------------------------------------------+
   ; | Input layout for WRITE_COMPLETED                     |
   ; +----------------------------------------------+-------+
   ; | Parameter                                    | Bits  |
   ; +----------------------------------------------+-------+
   ; | User data                                    | 0-31  |
   ; | Status                                       | 32-35 |
   ; +----------------------------------------------+-------+

   ; +------------------------------------------------------+
   ; | Input layout for READ_COMPLETED                      |
   ; +----------------------------------------------+-------+
   ; | Parameter                                    | Bits  |
   ; +----------------------------------------------+-------+
   ; | User data                                    | 0-31  |
   ; | Read data                                    | 32-95 |
   ; | Status                                       | 96-99 |
   ; +----------------------------------------------+-------+

   ; +------------------------------------------------------+
   ; | WRITE                                                |
   ; +----------+-------+-----------------------------------+
   ; | Register | Bits  | Value                             |
   ; +----------+-------+-----------------------------------+
   ; | R4       | 0-31  | User data                         |
   ; | R5       | 0-31  | Address low                       |
   ; | R6       | 0-31  | Address high                      |
   ; | R7       | 0-31  | Data low                          |
   ; | R8       | 0-31  | Data high                         |
   ; | R9       | 0-3   | Size                              |
   ; | R9       | 4-8   | Physical channel index            |
   ; | R9       | 9-11  | Memory type                       |
   ; | R9       | 12-16 | VMID                              |
   ; | R9       | 17-17 | MSA                               |
   ; | R9       | 18-18 | Blocking                          |
   ; | R9       | 19-19 | Internal                          |
   ; +----------+-------+-----------------------------------+

   ; +------------------------------------------------------+
   ; | READ                                                 |
   ; +----------+-------+-----------------------------------+
   ; | Register | Bits  | Value                             |
   ; +----------+-------+-----------------------------------+
   ; | R4       | 0-31  | User data                         |
   ; | R5       | 0-31  | Address low                       |
   ; | R6       | 0-31  | Address high                      |
   ; | R7       | 0-3   | Size                              |
   ; | R7       | 4-8   | Physical channel index            |
   ; | R7       | 9-11  | Memory type                       |
   ; | R7       | 12-16 | VMID                              |
   ; | R7       | 17-17 | MSA                               |
   ; | R7       | 18-18 | Blocking                          |
   ; | R7       | 19-19 | Internal                          |
   ; +----------+-------+-----------------------------------+

   ; Constants for standard read/write operation.
   ; TODO: change memory type, VMID and MSA used in the encoding to the real values, current assumptions:
   ;       Memory type = MEMTYPE_NORMAL_NON_CACHEABLE (2)
   ;       VMID = 0
   ;       MSA = 1
   READ_WRITE_ENGINE.FOUR_BYTE_BLOCKING_TRANSFER           = 0x60404
   READ_WRITE_ENGINE.FOUR_BYTE_BLOCKING_TRANSFER_LSB       = 0x404
   READ_WRITE_ENGINE.FOUR_BYTE_BLOCKING_TRANSFER_MSB       = 0x60000
   
   READ_WRITE_ENGINE.FOUR_BYTE_NON_BLOCKING_TRANSFER       = 0x20404
   READ_WRITE_ENGINE.FOUR_BYTE_NON_BLOCKING_TRANSFER_LSB   = 0x404
   READ_WRITE_ENGINE.FOUR_BYTE_NON_BLOCKING_TRANSFER_MSB   = 0x20000
   
   READ_WRITE_ENGINE.EIGHT_BYTE_BLOCKING_TRANSFER          = 0x60408
   READ_WRITE_ENGINE.EIGHT_BYTE_BLOCKING_TRANSFER_LSB      = 0x408
   READ_WRITE_ENGINE.EIGHT_BYTE_BLOCKING_TRANSFER_MSB      = 0x60000
   
   READ_WRITE_ENGINE.EIGHT_BYTE_NON_BLOCKING_TRANSFER      = 0x20408
   READ_WRITE_ENGINE.EIGHT_BYTE_NON_BLOCKING_TRANSFER_LSB  = 0x408
   READ_WRITE_ENGINE.EIGHT_BYTE_NON_BLOCKING_TRANSFER_MSB  = 0x20000
   
   READ_WRITE_ENGINE.INTERNAL_TRANSFER                     = 0x80000
   
   ; Physical channel index:
   READ_WRITE_ENGINE.PHYSICAL_CHANNEL_INDEX_SHIFT          = 4
   READ_WRITE_ENGINE.PHYSICAL_CHANNEL_INDEX_MASK           = 0x1f0
   
   ; Blocking:
   READ_WRITE_ENGINE.BLOCKING_SHIFT                        = 18
   READ_WRITE_ENGINE.BLOCKING_MASK                         = 1 << 18
   
   ; Status encoding for both ISR and AA:
   READ_WRITE_ENGINE.STATUS.SUCCESS                        = 0  
   READ_WRITE_ENGINE.STATUS.ERROR                          = 1
   READ_WRITE_ENGINE.STATUS.NO_ROOM = 2 ; TODO: make sure with Ayala Miller it's irrelevant upon ISR entry (non-blocking reads/writes)

   ; +------------------------------------------------------+
   ; | User data                                            |
   ; +----------+-------+-----------------------------------+
   ; | Register | Bits  | Value                             |
   ; +----------+-------+-----------------------------------+
   ; | R4       | 0-4   | Physical channel index            |
   ; | R4       | 24-31 | Return point                      |
   ; +----------+-------+-----------------------------------+
   ;
   ; 1) Data we'll need to reload into registers upon read completion.
   
   ; Physical channel index:
   READ_WRITE_ENGINE.USER_DATA.PHYSICAL_CHANNEL_INDEX_SHIFT   = 0
   READ_WRITE_ENGINE.USER_DATA.PHYSICAL_CHANNEL_INDEX_MASK    = 0x1f
   
   ; Return point:
   READ_WRITE_ENGINE.USER_DATA.RETURN_POINT_SHIFT              = 24
   READ_WRITE_ENGINE.USER_DATA.RETURN_POINT_MASK               = 0xff000000
   READ_WRITE_ENGINE.USER_DATA.RETURN_POINT.CHANNEL_EMPTY      = 1
   READ_WRITE_ENGINE.USER_DATA.RETURN_POINT.HANDLE_NEW_RE      = 2
   READ_WRITE_ENGINE.USER_DATA.RETURN_POINT.TIMER_EXPIRED      = 3
   
   ; For register access test user data will be used to receive the operation kind (read or write) from SW:
   READ_WRITE_ENGINE.READ_OPERATION    = 1
   READ_WRITE_ENGINE.WRITE_OPERATION   = 2
   
   ; Completion codes for this test:
   READ_WRITE_ENGINE.OPERATION_COMPLETED_SUCCESSFULLY = 1
   READ_WRITE_ENGINE.OPERATION_COMPLETED_WITH_ERROR   = 2
   
   ; Combined shift masks.
   ; Used for optimizations when copying fields from one register to another.
   ; Allow to fuse AND_SHR with the subsequent SHL into a single AND_SH[R/L].
   CC.CHDIR_TO_IPA_IF.DIRECTION_SHL = 17
   CC.CHID_TO_EVENT_ENGINE.RESET_EVENT_QUEUE.VIRTUAL_CHANNEL_INDEX_SHR = 8
   CC.CHID_TO_INTERRUPT_ENGINE.GENERATE_INTERRUPT.CHANNEL_INDEX_SHR = 5
   CC.EVCHID_TO_INTERRUPT_ENGINE.GENERATE_INTERRUPT.EVENT_INDEX_SHR = 5
   CC.CHID_TO_IPA_IF.VIRTUAL_CHANNEL_INDEX_SHL = 0
   CC.CHID_TO_TCE.CHID_SHL = 16
   CC.EE_TO_IPA_IF.EE_SHR = 4
   CC.EE_TO_EVENT_ENGINE.RESET_EVENT_QUEUE.EE_SHL = 1
   CC.EE_TO_INTERRUPT_ENGINE.GENERATE_INTERRUPT.EE_SHL = 4
   CC.EE_TO_INTERRUPT_ENGINE.GENERATE_INTERRUPT.ORIGINATOR_EE_SHL = 24
   CC.EE_TO_ERROR_LOG.EE_SHL = 24
   CC.CHID_TO_ERROR_LOG.CHID_SHL = 11
   CC.EVCHID_TO_ERROR_LOG.EVCHID_SHL = 11
   CSR_RESOURCE_ALLOCATOR.CHANNEL_INDEX_TO_INTERRUPT_ENGINE.GENERATE_INTERRUPT.CHANNEL_INDEX_SHL = 3
   CSR_RESOURCE_ALLOCATOR.CHANNEL_INDEX_TO_IPA_IF.USER_DATA.PHYSICAL_CHANNEL_INDEX_SHL = 1
   CSR_RESOURCE_ALLOCATOR.CHANNEL_INDEX_TO_RE_ENGINE.ROUTINE.PHYSICAL_CHANNEL_INDEX_SHR = 0
   CSR_RESOURCE_ALLOCATOR.CHANNEL_INDEX_TO_TIMER.USER_DATA.PHYSICAL_CHANNEL_INDEX_SHL = 3
   CSR_RESOURCE_ALLOCATOR.CHANNEL_INDEX_TO_CSR_RESOURCE_ALLOCATOR.ROUTINE.VIRTUAL_CHANNEL_INDEX_SHL = 4
   CSR_RESOURCE_ALLOCATOR.ORIGINATOR_EE_TO_INTERRUPT_ENGINE.GENERATE_INTERRUPT.ORIGINATOR_EE_SHL = 20
   CSR_RESOURCE_ALLOCATOR.ORIGINATOR_EE_TO_IPA_IF.USER_DATA.ORIGINATOR_EE_SHL = 16
   CSR_RESOURCE_ALLOCATOR.ORIGINATOR_EE_TO_CSR_RESOURCE_ALLOCATOR.ROUTINE.EE_SHR = 8
   EVENT_ENGINE.GENERATE_EVENT.PHYSICAL_EVENT_INDEX_TO_INTERRUPT_ENGINE.GENERATE_INTERRUPT.CHANNEL_INDEX_SHR = 5
   EVENT_ENGINE.GENERATE_EVENT.PHYSICAL_CHANNEL_INDEX_TO_READ_WRITE_ENGINE.PHYSICAL_CHANNEL_INDEX_SHR = 20
   INTERRUPT_ENGINE.GENERATE_INTERRUPT.ORIGINATOR_EE_TO_INTERRUPT_ENGINE.GENERATE_INTERRUPT.EE_SHR = 20
   INTERRUPT_ENGINE.GENERATE_INTERRUPT.EE_TO_INTERRUPT_ENGINE.GENERATE_INTERRUPT.ORIGINATOR_EE_SHL = 20
   INTERRUPT_ENGINE.USER_DATA.ORIGINATOR_EE_TO_INTERRUPT_ENGINE.GENERATE_INTERRUPT.ORIGINATOR_EE_SHL = 4
   IPA_IF.USER_DATA.ORIGINATOR_EE_TO_INTERRUPT_ENGINE.GENERATE_INTERRUPT.ORIGINATOR_EE_SHL = 4
   IPA_IF.USER_DATA.TYPE_TO_TCE.TYPE_SHL = 0
   IPA_IF.USER_DATA.BEI_TO_INTERRUPT_ENGINE.GENERATE_INTERRUPT.ENABLE_INTERRUPT_MODERATION_SHL = 17
   RE_ENGINE.USER_DATA.ORIGINATOR_EE_TO_IPA_IF.USER_DATA.ORIGINATOR_EE_SHL = 12
   RE_ENGINE.USER_DATA.ORIGINATOR_EE_TO_INTERRUPT_ENGINE.GENERATE_INTERRUPT.ORIGINATOR_EE_SHL = 16
   TRE3_TO_IPA_IF.USER_DATA_SHR = 7
   CC.ASSERT_BIT_40_TO_ADDRESS_BIT_40_IN_MSB_SHL = 7
   CC.EE_TO_GSI_CH_QOS_ADDRESS.EE_SHL = 10
   CC.CHID_TO_GSI_CH_QOS_ADDRESS.CHID_SHR = 1
   GSI_CH_QOS.USE_DB_ENG_TO_CC.DB_MODE_SHL = 1
   ACCELERATOR_STATUS_REGISTER.TIMER_ID_TO_CC.UL_DL_SYNC_TIMER_ID_SHL = 0
   TRE.SCT_TO_IPA_IF.SCT_SHL = 13

   EVENT_ENGINE.GENERATE_EVENT.XDCI_PHYSICAL_CHANNEL_INDEX_SHIFT = 8
   EVENT_ENGINE.GENERATE_EVENT.XDCI_PHYSICAL_CHANNEL_INDEX_MASK = 0x1f00
   EVENT_ENGINE.GENERATE_EVENT.XDCI_MASK = 0x400000
.code:

FirmwareVersion:
   and_shr r0, r0, 0, FIRMWARE_VERSION
   
   ; ********************************************************
   ; * Channel Command                                      *
   ; ********************************************************
@gsi_iram_ptr_ch_cmd:
   rename(r13, inputParameters0)
   rename(r14, inputParameters1)

   rename(r0, temp)
   
   rename(r1, index)
   and_shr inputParameters0, index, CSR_RESOURCE_ALLOCATOR.CHANNEL_INDEX_SHIFT, CSR_RESOURCE_ALLOCATOR.CHANNEL_INDEX_MASK

   rename(r2, originatorEE)
   and_shr inputParameters0, originatorEE, CSR_RESOURCE_ALLOCATOR.ORIGINATOR_EE_SHIFT, CSR_RESOURCE_ALLOCATOR.ORIGINATOR_EE_MASK
   
   rename(r3, EE)
   and_shr inputParameters0, EE, CSR_RESOURCE_ALLOCATOR.EE_SHIFT, CSR_RESOURCE_ALLOCATOR.EE_MASK
   
   rename(r15, opcode)
   and_shr inputParameters1, opcode, CSR_RESOURCE_ALLOCATOR.OPCODE_SHIFT, CSR_RESOURCE_ALLOCATOR.OPCODE_MASK

   rename(r16, isEvent)
   and_shr inputParameters1, isEvent, CSR_RESOURCE_ALLOCATOR.TYPE_SHIFT, CSR_RESOURCE_ALLOCATOR.TYPE_MASK
   
   ; Check wether we're dealing with inter-EE command or not by comparing EE and originatorEE.
   sub EE, temp, originatorEE
   beq temp, NotInterEECommand, 0
 
InterEECommand: 
   ; At this point inter-EE command was detected.
   ; We need to check whether inter-EE channel/event allocation request was issued.
   ; This is an illegal command and should lead to an error right away.   
   beq opcode, InterEEAllocationAttempt, CSR_RESOURCE_ALLOCATOR.OPCODE.ALLOCATE

NotInterEECommand:
   ; Now for both inter-EE and not inter-EE commands we need to convert EE:index pair
   ; into the physical channel/event index as long as this is not Allocate command which accepts EE:index as they are.
   beq opcode, ProcessCommand, CSR_RESOURCE_ALLOCATOR.OPCODE.ALLOCATE
   
   ; At this point we need to perform the conversion.
   ; We'll simply overwrite the virtual channel/event index with the physical.
   beq isEvent, EventTranslation, CSR_RESOURCE_ALLOCATOR.TYPE.EVENT

ChannelTranslation:
   vir2phy index, EE, index, CHANNEL
   ; TODO: add translation error check.
   jump ProcessCommand
   
EventTranslation:
   vir2phy index, EE, index, EVENT
   ; TODO: add translation error check.
   
ProcessCommand:   
   ; Check whether we're dealing with a channel of with an event.
   beq isEvent, EventCommand, CSR_RESOURCE_ALLOCATOR.TYPE.EVENT

ChannelCommand:
   beq opcode, AllocateChannel, CSR_RESOURCE_ALLOCATOR.OPCODE.ALLOCATE
   beq opcode, StartChannel, CSR_RESOURCE_ALLOCATOR.OPCODE.START
   beq opcode, StopChannel, CSR_RESOURCE_ALLOCATOR.OPCODE.STOP
   beq opcode, ResetChannel, CSR_RESOURCE_ALLOCATOR.OPCODE.RESET
   beq opcode, DeallocateChannel, CSR_RESOURCE_ALLOCATOR.OPCODE.DEALLOCATE
   beq opcode, DoorbellStopChannel, CSR_RESOURCE_ALLOCATOR.OPCODE.DOORBELL_STOP
   beq opcode, CancelInterruptModeration, CSR_RESOURCE_ALLOCATOR.OPCODE.CANCEL_INTERRUPT_MODERATION

EventCommand:
   beq opcode, AllocateEvent, CSR_RESOURCE_ALLOCATOR.OPCODE.ALLOCATE
   beq opcode, ResetEvent, CSR_RESOURCE_ALLOCATOR.OPCODE.RESET
   beq opcode, DeallocateEvent, CSR_RESOURCE_ALLOCATOR.OPCODE.DEALLOCATE
   
   ; At this point we've detected an unsupported opcode, we'll proceed with the error generation code below.
   rename(r5, errorLog)
 
   ; Start the error log generation.
   move opcode, errorLog ; TODO: A new error format is needed.
   and_imm errorLog, errorLog, ERROR_LOG.BITS_TO_SET_ALWAYS
   ;or_imm errorLog, errorLog, ERROR_LOG.ERROR_CODE.UNSUPPORTED_OPERATION << ERROR_LOG.ERROR_CODE_SHIFT
   jump GenerateErrorInterrupt

InterEEAllocationAttempt:
   ; At this point we're dealing with the invalid inter-EE channel/event allocation attempt.
   ; Generate the corresponding error log.
   move opcode, errorLog
   or_imm errorLog, errorLog, ERROR_LOG.BITS_TO_SET_ALWAYS
   or_imm errorLog, errorLog, ERROR_LOG.ERROR_CODE.UNSUPPORTED_INTER_EE_OPERATION << ERROR_LOG.ERROR_CODE_SHIFT
   
GenerateErrorInterrupt:
   ; Finish the error log generation.
   shl index, temp, ERROR_LOG.CHANNEL_EVENT_INDEX_SHIFT
   or errorLog, errorLog, temp
   
   shl isEvent, temp, ERROR_LOG.CHANNEL_EVENT_ERROR_SHIFT
   or errorLog, errorLog, temp
   
   shl EE, temp, ERROR_LOG.EE_SHIFT
   or errorLog, errorLog, temp
   
   ; Add the virtual channel/event index to INTERRUPT_ENGINE.GENERATE_INTERRUPT parameter.
   rename(r4, generateInterruptParameters)
   shl index, generateInterruptParameters, INTERRUPT_ENGINE.GENERATE_INTERRUPT.CHANNEL_INDEX_SHIFT

   ; Store EE in INTERRUPT_ENGINE.GENERATE_INTERRUPT parameters.
   shl EE, temp, INTERRUPT_ENGINE.GENERATE_INTERRUPT.EE_SHIFT
   or generateInterruptParameters, generateInterruptParameters, temp

   ; Store Originator EE in INTERRUPT_ENGINE.GENERATE_INTERRUPT parameters.
   shl originatorEE, temp, INTERRUPT_ENGINE.GENERATE_INTERRUPT.ORIGINATOR_EE_SHIFT
   or generateInterruptParameters, generateInterruptParameters, temp

   ; Add channel/event indication to the error parameters.
   shl isEvent, temp, INTERRUPT_ENGINE.GENERATE_INTERRUPT.ERROR_TYPE_SHIFT
   or generateInterruptParameters, generateInterruptParameters, temp

   ; Add the constant error information to the input parameters.
   or_imm generateInterruptParameters, generateInterruptParameters, INTERRUPT_ENGINE.GENERATE_INTERRUPT.GLOBAL_CHANNEL_OR_EVENT_ERROR_LSB
   or_imm generateInterruptParameters, generateInterruptParameters, INTERRUPT_ENGINE.GENERATE_INTERRUPT.GLOBAL_CHANNEL_OR_EVENT_ERROR_MSB

   jump WriteErrorLogAndGenerateInterrupt

   ; Forget all the aliases.
   forgetall()

   ; ********************************************************
   ; * Allocate Channel                                     *
   ; ********************************************************
AllocateChannel:
   rename(r1, virtualChannelIndex)
   rename(r2, EE)
   
   ; Attempt to allocate the channel.
   rename(r4, allocateChannelParameters)
   shl EE, allocateChannelParameters, CSR_RESOURCE_ALLOCATOR.ROUTINE.EE_SHIFT
   
   rename(r0, temp)
   shl virtualChannelIndex, temp, CSR_RESOURCE_ALLOCATOR.ROUTINE.VIRTUAL_CHANNEL_INDEX_SHIFT
   or allocateChannelParameters, allocateChannelParameters, temp
   
   activate_accelerator CSR_RESOURCE_ALLOCATOR, CSR_RESOURCE_ALLOCATOR.ALLOCATE_CHANNEL, CSR_RESOURCE_ALLOCATOR.ALLOCATE_CHANNEL_HINT
   forget(allocateChannelParameters)
 
   ; At this point we don't check yet whether the channel was allocated successfully or not.
   ; In any case we need to generate a corresponding interrupt.
   ; We'll fill the parameters commond to both cases and only then will do the check.
    
   ; Start parameter preparations for Generate INTERRUPT_ENGINE.GENERATE_INTERRUPT.
   rename(r4, generateInterruptParameters)
   shl EE, generateInterruptParameters, INTERRUPT_ENGINE.GENERATE_INTERRUPT.ORIGINATOR_EE_SHIFT
   
   ; Make sure the allocation was successful. 
   and_imm ACCELERATOR_STATUS_REGISTER, temp, ACCELERATOR_STATUS_REGISTER.STATUS_MASK
   bneq temp, ChannelAllocationError, ACCELERATOR_STATUS_REGISTER.STATUS.SUCCESS
   
   ; We'll need the physical channel index.
   ; TODO: we should probably take it from  ACCELERATOR_RETURN_VALUE_LSB_REGISTER instead.
   rename(r3, physicalChannelIndex)
   vir2phy physicalChannelIndex, EE, virtualChannelIndex, CHANNEL
   ; TODO: In theory we need to check the returned value for validity, but if everything is okay there's no chance for an error here since
   ; the channel was successfully allocated just a moment ago.

   shl physicalChannelIndex, temp, INTERRUPT_ENGINE.GENERATE_INTERRUPT.CHANNEL_INDEX_SHIFT
   or generateInterruptParameters, generateInterruptParameters, temp
   
   ; Add missing constant fields to the input parameters.
   or_imm generateInterruptParameters, generateInterruptParameters, INTERRUPT_ENGINE.GENERATE_INTERRUPT.CHANNEL_STATE_CHANGE
   
   ; Zero out the channel scratchpad.
   and_imm temp, temp, 0
   store_single physicalChannelIndex, temp, CC_RAM.ELEMENT_SIZE, CC_RAM.SCRATCHPAD0_LOW.OFFSET, SHRAM_ID_USE, SHRAM_ID_CH_CONTEXT, CC_RAM.SCRATCHPAD0_LOW.MSB
   store_single physicalChannelIndex, temp, CC_RAM.ELEMENT_SIZE, CC_RAM.SCRATCHPAD0_HIGH.OFFSET, SHRAM_ID_USE, SHRAM_ID_CH_CONTEXT, CC_RAM.SCRATCHPAD0_HIGH.MSB
   store_single physicalChannelIndex, temp, CC_RAM.ELEMENT_SIZE, CC_RAM.SCRATCHPAD1_LOW.OFFSET, SHRAM_ID_USE, SHRAM_ID_CH_CONTEXT, CC_RAM.SCRATCHPAD1_LOW.MSB
   store_single physicalChannelIndex, temp, CC_RAM.ELEMENT_SIZE, CC_RAM.SCRATCHPAD1_HIGH.OFFSET, SHRAM_ID_USE, SHRAM_ID_CH_CONTEXT, CC_RAM.SCRATCHPAD1_HIGH.MSB
   
   ; Update the channel state to ALLOCATED.
   update_state CC.CHSTATE_ALLOCATED, physicalChannelIndex, CHANNEL

SendInterruptAndGoIdle:
   ; The input parameters are delivered via R4 and R5.

   ; Set the memory type to MEMTYPE_NORMAL_NON_CACHEABLE
   or_imm generateInterruptParameters, generateInterruptParameters, MEMTYPE_NORMAL_NON_CACHEABLE << INTERRUPT_ENGINE.GENERATE_INTERRUPT.MEMORY_TYPE_SHIFT
   ; Send the interrupt.
   ; We can get an error here - ACCELERATOR_STATUS_REGISTER.STATUS.OUT_OF_BUFFERS (exceeded  the number of allowed AXI transactions, happens for MSI type only).
   ; In this case we repeat the accelerator activation.
   activate_accelerator INTERRUPT_ENGINE, INTERRUPT_ENGINE.GENERATE_INTERRUPT, INTERRUPT_ENGINE.GENERATE_INTERRUPT_HINT
   
   beq ACCELERATOR_STATUS_REGISTER, SendInterruptAndGoIdle, ACCELERATOR_STATUS_REGISTER.STATUS.OUT_OF_BUFFERS

   ; Go idle now.
   go_idle

ChannelAllocationError:
   ; Add virtual channel index to INTERRUPT_ENGINE.GENERATE_INTERRUPT parameters.
   shl virtualChannelIndex, temp, INTERRUPT_ENGINE.GENERATE_INTERRUPT.CHANNEL_INDEX_SHIFT
   or generateInterruptParameters, generateInterruptParameters, temp
   
   ; Add EE to INTERRUPT_ENGINE.GENERATE_INTERRUPT parameters.
   shl EE, temp, INTERRUPT_ENGINE.GENERATE_INTERRUPT.EE_SHIFT
   or generateInterruptParameters, generateInterruptParameters, temp

   ; Add the constant error information to INTERRUPT_ENGINE.GENERATE_INTERRUPT parameters.
   or_imm generateInterruptParameters, generateInterruptParameters, INTERRUPT_ENGINE.GENERATE_INTERRUPT.GLOBAL_CHANNEL_ERROR_LSB
   or_imm generateInterruptParameters, generateInterruptParameters, INTERRUPT_ENGINE.GENERATE_INTERRUPT.GLOBAL_CHANNEL_ERROR_MSB

   ; Create the error log.
   rename(r5, errorLog)
   shl EE, errorLog, ERROR_LOG.EE_SHIFT
   
   shl virtualChannelIndex, temp, ERROR_LOG.CHANNEL_EVENT_INDEX_SHIFT
   or errorLog, errorLog, temp
   
   or_imm errorLog, errorLog, ERROR_LOG.CHANNEL_ERROR
   or_imm errorLog, errorLog, ERROR_LOG.ERROR_CODE.ALLOCATION_OUT_OF_RESOURCES << ERROR_LOG.ERROR_CODE_SHIFT

   jump WriteErrorLogAndGenerateInterrupt
 
   ; Forget all the aliases.
   forgetall()

   ; ********************************************************
   ; * Deallocate Channel                                   *
   ; ********************************************************
DeallocateChannel:
   rename(r1, physicalChannelIndex)
   rename(r2, originatorEE)
   
   ; Read the channel context, we're interested only in one returned value of the three, therefore there's no need to rename them.
   rename(r3, CC)
   load_channel_context CC, r5, r6, physicalChannelIndex, CHANNEL
   
   ; Extract EE and Virtual channel index from the channel context.
   ; TODO: This is an optimization based on the fact that EE:CHID have the same layout in CC and the parameters of CSR_RESOURCE_ALLOCATOR.DEALLOCATE_CHANNEL.
   ;       If the structure layout is changed this code won't be correct.
   rename(r4, deallocateChannelParameters)
   and_shr CC, deallocateChannelParameters, CC.EE_AND_CHID_SHIFT, CC.EE_AND_CHID_MASK
   
   ; Issue CSR_RESOURCE_ALLOCATOR.DEALLOCATE_CHANNEL.
   activate_accelerator CSR_RESOURCE_ALLOCATOR, CSR_RESOURCE_ALLOCATOR.DEALLOCATE_CHANNEL, CSR_RESOURCE_ALLOCATOR.DEALLOCATE_CHANNEL_HINT

   ; Store the channel index for the future usage by INTERRUPT_ENGINE.GENERATE_INTERRUPT.
   rename(deallocateChannelParameters, generateInterruptParameters)
   shl physicalChannelIndex, generateInterruptParameters, INTERRUPT_ENGINE.GENERATE_INTERRUPT.CHANNEL_INDEX_SHIFT

   ; Store the originator EE for the future usage by INTERRUPT_ENGINE.GENERATE_INTERRUPT.
   rename(r0, temp)
   shl originatorEE, temp, INTERRUPT_ENGINE.GENERATE_INTERRUPT.ORIGINATOR_EE_SHIFT
   or generateInterruptParameters, generateInterruptParameters, temp

   ; Add missing constant fields to the input parameters.
   or_imm generateInterruptParameters, generateInterruptParameters, INTERRUPT_ENGINE.GENERATE_INTERRUPT.CHANNEL_STATE_CHANGE

   ; Update the channel state to NOT_ALLOCATED.
   update_state CC.CHSTATE_NOT_ALLOCATED, physicalChannelIndex, CHANNEL

   ; Go to send the interrupt.
   jump SendInterruptAndGoIdle

   ; Forget all the aliases.
   forgetall()

   ; ********************************************************
   ; * Allocate Event                                       *
   ; ********************************************************
AllocateEvent:
   rename(r1, virtualEventIndex)
   rename(r2, EE)
   
   ; Attempt to allocate the event.
   rename(r4, allocateEventParameters)
   shl EE, allocateEventParameters, CSR_RESOURCE_ALLOCATOR.ROUTINE.EE_SHIFT
   
   rename(r0, temp)
   shl virtualEventIndex, temp, CSR_RESOURCE_ALLOCATOR.ROUTINE.VIRTUAL_CHANNEL_INDEX_SHIFT
   or allocateEventParameters, allocateEventParameters, temp
   
   activate_accelerator CSR_RESOURCE_ALLOCATOR, CSR_RESOURCE_ALLOCATOR.ALLOCATE_EVENT, CSR_RESOURCE_ALLOCATOR.ALLOCATE_EVENT_HINT
   forget(allocateEventParameters)
 
   ; At this point we don't check yet whether the event was allocated successfully or not.
   ; In any case we need to generate a corresponding interrupt.
   ; We'll fill the parameters commond to both cases and only then will do the check.
    
   ; Start parameter preparations for Generate INTERRUPT_ENGINE.GENERATE_INTERRUPT.
   rename(r4, generateInterruptParameters)
   shl EE, generateInterruptParameters, INTERRUPT_ENGINE.GENERATE_INTERRUPT.ORIGINATOR_EE_SHIFT
   
   ; Make sure the allocation was successful. 
   and_imm ACCELERATOR_STATUS_REGISTER, temp, ACCELERATOR_STATUS_REGISTER.STATUS_MASK
   bneq temp, EventAllocationError, ACCELERATOR_STATUS_REGISTER.STATUS.SUCCESS
   
   ; We'll need the physical event index.
   ; TODO: we should probably take it from  ACCELERATOR_RETURN_VALUE_LSB_REGISTER instead.
   rename(r3, physicalEventIndex)
   vir2phy physicalEventIndex, EE, virtualEventIndex, EVENT
   ; TODO: In theory we need to check the returned value for validity, but if everything is okay there's no chance for an error here since
   ; the channel was successfully allocated just a moment ago.

   shl physicalEventIndex, temp, INTERRUPT_ENGINE.GENERATE_INTERRUPT.CHANNEL_INDEX_SHIFT
   or generateInterruptParameters, generateInterruptParameters, temp
   
   ; Add missing constant fields to the input parameters.
   or_imm generateInterruptParameters, generateInterruptParameters, INTERRUPT_ENGINE.GENERATE_INTERRUPT.EVENT_STATE_CHANGE
   
   ; Zero out the event scratchpad.
   and_imm temp, temp, 0
   store_single physicalEventIndex, temp, EC_RAM.ELEMENT_SIZE, EC_RAM.SCRATCHPAD0_LOW.OFFSET, SHRAM_ID_USE, SHRAM_ID_EV_CONTEXT, EC_RAM.SCRATCHPAD0_LOW.MSB
   store_single physicalEventIndex, temp, EC_RAM.ELEMENT_SIZE, EC_RAM.SCRATCHPAD0_HIGH.OFFSET, SHRAM_ID_USE, SHRAM_ID_EV_CONTEXT, EC_RAM.SCRATCHPAD0_HIGH.MSB
   
   ; Update the event state to ALLOCATED.
   update_state CC.CHSTATE_ALLOCATED, physicalEventIndex, EVENT

   jump SendInterruptAndGoIdle
   
EventAllocationError:
   ; Add virtual event index to INTERRUPT_ENGINE.GENERATE_INTERRUPT parameters.
   shl virtualEventIndex, temp, INTERRUPT_ENGINE.GENERATE_INTERRUPT.CHANNEL_INDEX_SHIFT
   or generateInterruptParameters, generateInterruptParameters, temp
   
   ; Add EE to INTERRUPT_ENGINE.GENERATE_INTERRUPT parameters.
   shl EE, temp, INTERRUPT_ENGINE.GENERATE_INTERRUPT.EE_SHIFT
   or generateInterruptParameters, generateInterruptParameters, temp

   ; Add the constant error information to INTERRUPT_ENGINE.GENERATE_INTERRUPT parameters.
   or_imm generateInterruptParameters, generateInterruptParameters, INTERRUPT_ENGINE.GENERATE_INTERRUPT.GLOBAL_EVENT_ERROR_LSB
   or_imm generateInterruptParameters, generateInterruptParameters, INTERRUPT_ENGINE.GENERATE_INTERRUPT.GLOBAL_EVENT_ERROR_MSB

   ; Create the error log.
   rename(r5, errorLog)
   
   ; Create the error log.
   shl EE, errorLog, ERROR_LOG.EE_SHIFT
   
   shl virtualEventIndex, temp, ERROR_LOG.CHANNEL_EVENT_INDEX_SHIFT
   or errorLog, errorLog, temp
   
   or_imm errorLog,  errorLog, ERROR_LOG.EVENT_ERROR
   or_imm errorLog,  errorLog, ERROR_LOG.ERROR_CODE.ALLOCATION_OUT_OF_RESOURCES << ERROR_LOG.ERROR_CODE_SHIFT
   
   jump WriteErrorLogAndGenerateInterrupt
 
   ; Forget all the aliases.
   forgetall()

   ; ********************************************************
   ; * Deallocate Event                                     *
   ; ********************************************************
DeallocateEvent:
   rename(r1, physicalEventIndex)
   rename(r2, originatorEE)

   ; Read the event context, we're interested only in one returned value of the three, therefore there's no need to rename them.
   rename(r3, CC)
   load_channel_context CC, r5, r6, physicalEventIndex, EVENT
   
   ; Extract EE and Virtual event index from CC.
   ; TODO: This is an optimization based on the fact that EE:CHID have the same layout in CC and the parameters of CSR_RESOURCE_ALLOCATOR.DEALLOCATE_EVENT.
   ;       If the structure layout is changed this code won't be correct.
   rename(r4, deallocateEventParameters)
   and_shr CC, deallocateEventParameters, CC.EE_AND_EVCHID_SHIFT, CC.EE_AND_EVCHID_MASK
   
   ; Issue CSR_RESOURCE_ALLOCATOR.DEALLOCATE_EVENT.
   ; The returned status is always success and therefore it's not checked.
   activate_accelerator CSR_RESOURCE_ALLOCATOR, CSR_RESOURCE_ALLOCATOR.DEALLOCATE_EVENT, CSR_RESOURCE_ALLOCATOR.DEALLOCATE_EVENT_HINT
   
   ; Store the event index for the future usage by INTERRUPT_ENGINE.GENERATE_INTERRUPT.
   rename(deallocateEventParameters, generateInterruptParameters)
   shl physicalEventIndex, generateInterruptParameters, INTERRUPT_ENGINE.GENERATE_INTERRUPT.CHANNEL_INDEX_SHIFT

   ; Store the originator EE for the future usage by INTERRUPT_ENGINE.GENERATE_INTERRUPT.
   rename(r0, temp)
   shl originatorEE, temp, INTERRUPT_ENGINE.GENERATE_INTERRUPT.ORIGINATOR_EE_SHIFT
   or generateInterruptParameters, generateInterruptParameters, temp

   ; Add missing constant fields to the input parameters.
   or_imm generateInterruptParameters, generateInterruptParameters, INTERRUPT_ENGINE.GENERATE_INTERRUPT.EVENT_STATE_CHANGE

   ; Update the event state to NOT_ALLOCATED.
   update_state CC.CHSTATE_NOT_ALLOCATED, physicalEventIndex, EVENT

   ; Go to send the interrupt.
   jump SendInterruptAndGoIdle

   ; Forget all the aliases.
   forgetall()

   ; ********************************************************
   ; * Start Channel                                        *
   ; ********************************************************
StartChannel:
   rename(r1, physicalChannelIndex)
   rename(r2, originatorEE)
   
   ; Set STOP_REGISTER[physicalChannelIndex] and CHAIN_REGISTER[physicalChannelIndex] to 0.
   rename(r15, temp)
   and_imm temp, temp, 0
   set_bit STOP_REGISTER, STOP_REGISTER, physicalChannelIndex, temp
   set_bit CHAIN_REGISTER, CHAIN_REGISTER, physicalChannelIndex, temp
   
   ; Unmask channel doorbells.
   set_bit CHANNEL_DORBELL_MASK_REGISTER, CHANNEL_DORBELL_MASK_REGISTER, physicalChannelIndex, temp
   
   ; Disable channel empty interrupt.
   or_imm temp, temp, 1
   set_bit CHANNEL_EMPTY_MASK_REGISTER, CHANNEL_EMPTY_MASK_REGISTER, physicalChannelIndex, temp
   
   ; Call RE_ENGINE.ENABLE_CHANNEL.
   ; The returned status is always success and therefore it's not checked.
   move physicalChannelIndex, r4
   activate_accelerator RE_ENGINE, RE_ENGINE.ENABLE_CHANNEL, RE_ENGINE.ENABLE_CHANNEL_HINT

   ; Call IPA_IF.START.

   ; Read the channel context, we're interested only in one returned value of the three, therefore there's no need to rename them.
   rename(r3, CC)
   load_channel_context CC, r0, r13, physicalChannelIndex, CHANNEL

   ; Extract CC.CHTYPE.
   and_shr CC, r5, CC.CHTYPE_SHIFT, CC.CHTYPE_MASK
   bneq r5, NonXdciStartChannel, CC.CHTYPE.XDCI
   
   ; Reset GEVNTCOUNT.

   ; Extract EE from CC.
   rename(r14, EE)
   and_shr CC, EE, CC.EE_SHIFT, CC.EE_MASK

   ; Extract ERINDEX from CC.
   rename(r16, virtualEventIndex)
   and_shr CC, virtualEventIndex, CC.ERINDEX_SHIFT, CC.ERINDEX_MASK

   ; Get the physical event ring index.
   rename(temp, physicalEventIndex)
   vir2phy physicalEventIndex, EE, virtualEventIndex, EVENT

   ; Extract GEVNTCOUNT_HI from the event scratch.
   rename(r6, GEVNTCOUNT_HI)
   load_single physicalEventIndex, GEVNTCOUNT_HI, EC_RAM.ELEMENT_SIZE, EC_RAM.SCRATCHPAD0_HIGH.OFFSET, SHRAM_ID_USE, SHRAM_ID_EV_CONTEXT, EC_RAM.SCRATCHPAD0_HIGH.MSB
   and_imm GEVNTCOUNT_HI, GEVNTCOUNT_HI, 0xff

   ; Extract GEVNTCOUNT_LO from the event scratch.
   rename(r5, GEVNTCOUNT_LO)
   load_single physicalEventIndex, GEVNTCOUNT_LO, EC_RAM.ELEMENT_SIZE, EC_RAM.SCRATCHPAD0_LOW.OFFSET, SHRAM_ID_USE, SHRAM_ID_EV_CONTEXT, EC_RAM.SCRATCHPAD0_LOW.MSB
   rename(physicalEventIndex, temp)

   rename(r7, transferParameters)
   shl physicalChannelIndex, transferParameters, READ_WRITE_ENGINE.PHYSICAL_CHANNEL_INDEX_SHIFT
   or_imm transferParameters, transferParameters, READ_WRITE_ENGINE.FOUR_BYTE_BLOCKING_TRANSFER_LSB
   or_imm transferParameters, transferParameters, READ_WRITE_ENGINE.FOUR_BYTE_BLOCKING_TRANSFER_MSB

   activate_accelerator READ_WRITE_ENGINE, READ_WRITE_ENGINE.READ, READ_WRITE_ENGINE.READ_SYNC_HINT
   beq ACCELERATOR_STATUS_REGISTER, NonXdciStartChannel, ACCELERATOR_STATUS_REGISTER.STATUS.OUT_OF_BUFFERS

   move transferParameters, r9
   rename(transferParameters, eventCount)
   move ACCELERATOR_RETURN_VALUE_LSB_REGISTER, eventCount

   rename(r9, transferParameters)
   ;shl physicalChannelIndex, transferParameters, READ_WRITE_ENGINE.PHYSICAL_CHANNEL_INDEX_SHIFT
   ;or_imm transferParameters, transferParameters, READ_WRITE_ENGINE.FOUR_BYTE_NON_BLOCKING_TRANSFER_LSB
   ;or_imm transferParameters, transferParameters, READ_WRITE_ENGINE.FOUR_BYTE_NON_BLOCKING_TRANSFER_MSB

   activate_accelerator READ_WRITE_ENGINE, READ_WRITE_ENGINE.WRITE, READ_WRITE_ENGINE.WRITE_SYNC_HINT
   forget(GEVNTCOUNT_LO)
   forget(GEVNTCOUNT_HI)
   forget(eventCount)
   forget(transferParameters)
   forget(virtualEventIndex)
   forget(EE)

NonXdciStartChannel:
   ; Extract CC.CHDIR.
   rename(r6, ipaIfParameter2)
   and_shl CC, ipaIfParameter2, CC.CHDIR_TO_IPA_IF.DIRECTION_SHL, CC.CHDIR_MASK

   ; Extract CC.EE.
   rename(r7, ipaIfParameter3)
   and_shr CC, ipaIfParameter3, CC.EE_TO_IPA_IF.EE_SHR, CC.EE_MASK

   ; Extract CC.CHID.
   rename(r13, shiftedVirtualChannelIndex)
   and_shl CC, shiftedVirtualChannelIndex, CC.CHID_TO_IPA_IF.VIRTUAL_CHANNEL_INDEX_SHL, CC.CHID_MASK
   or ipaIfParameter3, ipaIfParameter3, shiftedVirtualChannelIndex
   forget(shiftedVirtualChannelIndex)

   ; ACCELERATOR_STATUS_REGISTER isn't checked here because it always contains SUCCEESS value after IPA_IF.START.
   activate_accelerator IPA_IF, IPA_IF.START, IPA_IF.START_HINT
   forget(ipaIfParameter2)
   forget(ipaIfParameter3)

   ; Read EE_n_GSI_CH_k_QOS register from IPA_IF.
   rename(r5, gsiChQosAddressLow)
   rename(r6, gsiChQosAddressHigh)

   and_shl CC, gsiChQosAddressLow, CC.EE_TO_GSI_CH_QOS_ADDRESS.EE_SHL, CC.EE_MASK
   and_shr CC, temp, CC.CHID_TO_GSI_CH_QOS_ADDRESS.CHID_SHR, CC.CHID_MASK
   or gsiChQosAddressLow, gsiChQosAddressLow, temp
   or_imm gsiChQosAddressLow, gsiChQosAddressLow, GSI_CH_QOS_BASE_ADDRESS & LOW_SIXTEEN_BIT_MASK
   or_imm gsiChQosAddressLow, gsiChQosAddressLow, GSI_CH_QOS_BASE_ADDRESS & HIGH_SIXTEEN_BIT_MASK
   
   and_imm gsiChQosAddressHigh, gsiChQosAddressHigh, 0

   rename(r7, transferParameters)
   shl physicalChannelIndex, transferParameters, READ_WRITE_ENGINE.PHYSICAL_CHANNEL_INDEX_SHIFT
   or_imm transferParameters, transferParameters, (READ_WRITE_ENGINE.FOUR_BYTE_BLOCKING_TRANSFER | READ_WRITE_ENGINE.INTERNAL_TRANSFER) & LOW_SIXTEEN_BIT_MASK
   or_imm transferParameters, transferParameters, (READ_WRITE_ENGINE.FOUR_BYTE_BLOCKING_TRANSFER | READ_WRITE_ENGINE.INTERNAL_TRANSFER) & HIGH_SIXTEEN_BIT_MASK

   activate_accelerator READ_WRITE_ENGINE, READ_WRITE_ENGINE.READ, READ_WRITE_ENGINE.READ_SYNC_HINT
   forget(gsiChQosAddressLow)
   forget(gsiChQosAddressHigh)
   forget(transferParameters)

   ; Out of the 3 possible return values only one is considered an error - ACCELERATOR_STATUS_REGISTER.STATUS.OUT_OF_BUFFERS.
   ; The other two - ACCELERATOR_STATUS_REGISTER.STATUS.SUCCESS and ACCELERATOR_STATUS_REGISTER.STATUS.BECAME_FULL indicate successful completion.
   beq ACCELERATOR_STATUS_REGISTER, OutOfBuffersDuringReadError, ACCELERATOR_STATUS_REGISTER.STATUS.OUT_OF_BUFFERS

   ; Load the channel's scratchpad part where DB_MODE indication is kept.
   rename(r14, channelScratchpad)
   load_single physicalChannelIndex, channelScratchpad, CC_RAM.ELEMENT_SIZE, CC_RAM.DB_MODE.OFFSET, SHRAM_ID_USE, SHRAM_ID_CH_CONTEXT, CC_RAM.DB_MODE.MSB
   
   ; The register value is returned in the LSB register.
   and_shl ACCELERATOR_RETURN_VALUE_LSB_REGISTER, temp, GSI_CH_QOS.USE_DB_ENG_TO_CC.DB_MODE_SHL, GSI_CH_QOS.USE_DB_ENG_MASK
   
   ; We need to save DB_MODE indication now in the channel's scratchpad.
   or channelScratchpad, channelScratchpad, temp
   store_single physicalChannelIndex, channelScratchpad, CC_RAM.ELEMENT_SIZE, CC_RAM.DB_MODE.OFFSET, SHRAM_ID_USE, SHRAM_ID_CH_CONTEXT, CC_RAM.DB_MODE.MSB
   
   ; Update the channel status to the STARTED.
   update_state CC.CHSTATE_STARTED, physicalChannelIndex, CHANNEL

   ; Prepare the parameters for INTERRUPT_ENGINE.GENERATE_INTERRUPT.

   ; Shift the channel index to the right position.
   rename(r4, generateInterruptParameters)
   shl physicalChannelIndex, generateInterruptParameters, INTERRUPT_ENGINE.GENERATE_INTERRUPT.CHANNEL_INDEX_SHIFT

   ; Store the originator EE in the input parameters.
   shl originatorEE, temp, INTERRUPT_ENGINE.GENERATE_INTERRUPT.ORIGINATOR_EE_SHIFT
   or generateInterruptParameters, generateInterruptParameters, temp

   ; Set the type field.
   or_imm generateInterruptParameters, generateInterruptParameters, INTERRUPT_ENGINE.GENERATE_INTERRUPT.CHANNEL_STATE_CHANGE

   ; Go to send the interrupt.
   jump SendInterruptAndGoIdle

   ; Forget all the aliases.
   forgetall()

   ; ********************************************************
   ; * Reset Channel                                        *
   ; ********************************************************
ResetChannel:
   rename(r1, physicalChannelIndex)
   rename(r2, originatorEE)

   ; Issue RE_ENGINE.RESET_CHANNEL.
   ; The returned status is always success and therefore it's not checked.
   rename(r4, resetChannelParameters)
   shl physicalChannelIndex, resetChannelParameters, RE_ENGINE.ROUTINE.PHYSICAL_CHANNEL_INDEX_SHIFT
   activate_accelerator RE_ENGINE, RE_ENGINE.RESET_CHANNEL, RE_ENGINE.RESET_CHANNEL_HINT

   ; Issue IPA_IF.RESET.

   ; Read the channel context, we're interested only in one returned value of the three, therefore there's no need to rename them.
   rename(r3, CC)
   load_channel_context CC, r0, r13, physicalChannelIndex, CHANNEL

   rename(r7, ipaIfParameter3)
   and_shr CC, ipaIfParameter3, CC.EE_TO_IPA_IF.EE_SHR, CC.EE_MASK
   and_shl CC, CC, CC.CHID_TO_IPA_IF.VIRTUAL_CHANNEL_INDEX_SHL, CC.CHID_MASK
   rename(CC, shiftedVirtualChannelIndex)
   or ipaIfParameter3, ipaIfParameter3, shiftedVirtualChannelIndex
   forget(shiftedVirtualChannelIndex)

   ; Prepare the user data needed for IPA_IF.RESET:
   ; - Physical channel index
   ; - Originator EE
   rename(r0, temp)
   rename(resetChannelParameters, ipaIfParameter0)
   shl physicalChannelIndex, ipaIfParameter0, IPA_IF.USER_DATA.PHYSICAL_CHANNEL_INDEX_SHIFT
   shl originatorEE, temp, IPA_IF.USER_DATA.ORIGINATOR_EE_SHIFT
   or ipaIfParameter0, ipaIfParameter0, temp
   
   activate_accelerator IPA_IF, IPA_IF.RESET, IPA_IF.RESET_HINT

   ; Out of the 3 possible return values only one is considered an error - ACCELERATOR_STATUS_REGISTER.STATUS.OUT_OF_BUFFERS_IPA_IF.
   ; The other two - ACCELERATOR_STATUS_REGISTER.STATUS.SUCCESS and ACCELERATOR_STATUS_REGISTER.STATUS.BECAME_FULL_IPA_IF indicate successful completion.
   beq ACCELERATOR_STATUS_REGISTER, OutOfBuffersDuringResetChannelError, ACCELERATOR_STATUS_REGISTER.STATUS.OUT_OF_BUFFERS_IPA_IF

   go_idle

OutOfBuffersDuringResetChannelError:
   rename(r5, errorDescription)
   
   ; Generate the error description.
   and_imm errorDescription, errorDescription, 0
   or_imm errorDescription, errorDescription, (ERROR_LOG.ERROR_CODE.OUT_OF_BUFFERS << ERROR_LOG.ERROR_CODE_SHIFT) | (IPA_IF << ERROR_LOG.ACCELERATOR_OPCODE_SHIFT) | (IPA_IF.RESET << ERROR_LOG.ROUTINE_OPCODE_SHIFT)
   
   jump OutOfBuffersOriginatorEEChannelError
 
   ; Forget all the aliases.
   forgetall()

@gsi_iram_ptr_periph_if_tlv_in_2:
   ; The input parameters are delivered via R13-R18, but we need only R13 and R16.
   rename(r13, userData)
   rename(r16, status)

   ; TODO: Any need to check the returned status?
   ;       Seems like not, but better verify with Ayala Miller and Ron Plewinski.

   ; Extract the physical channel index from the user data.
   rename(r0, physicalChannelIndex)
   and_shr userData, physicalChannelIndex, IPA_IF.USER_DATA.PHYSICAL_CHANNEL_INDEX_SHIFT, IPA_IF.USER_DATA.PHYSICAL_CHANNEL_INDEX_MASK

   ; Extract the originator EE from the user data.
   ; Put it directly in the right position for INTERRUPT_ENGINE.GENERATE_INTERRUPT activation.
   rename(r8, shiftedOriginatorEE)
   and_shl userData, shiftedOriginatorEE, IPA_IF.USER_DATA.ORIGINATOR_EE_TO_INTERRUPT_ENGINE.GENERATE_INTERRUPT.ORIGINATOR_EE_SHL, IPA_IF.USER_DATA.ORIGINATOR_EE_MASK
   forget(userData)

   ; Update the channel state.
   update_state CC.CHSTATE_ALLOCATED, physicalChannelIndex, CHANNEL

   ; Issue INTERRUPT_ENGINE.GENERATE_INTERRUPT.

   ; Put the physical channel index into the INTERRUPT_ENGINE.GENERATE_INTERRUPT parameters.
   rename(r4, generateInterruptParameters)
   shl physicalChannelIndex, generateInterruptParameters, INTERRUPT_ENGINE.GENERATE_INTERRUPT.CHANNEL_INDEX_SHIFT

   ; Add originator EE to the parameters.
   or generateInterruptParameters, generateInterruptParameters, shiftedOriginatorEE

   ; Store interrupt type in the parameters.
   or_imm generateInterruptParameters, generateInterruptParameters, INTERRUPT_ENGINE.GENERATE_INTERRUPT.CHANNEL_STATE_CHANGE

   ; Go to send the interrupt.
   jump SendInterruptAndGoIdle

   ; Forget all the aliases.
   forgetall()

   ; ********************************************************
   ; * Reset Event                                          *
   ; ********************************************************
ResetEvent:
   rename(r1, physicalEventIndex)
   rename(r2, originatorEE)

   ; Update the event state.
   update_state CC.CHSTATE_ALLOCATED, physicalEventIndex, EVENT

   ; Issue INTERRUPT_ENGINE.GENERATE_INTERRUPT.

   ; Put the physical channel index into the INTERRUPT_ENGINE.GENERATE_INTERRUPT parameters.
   rename(r4, generateInterruptParameters)
   shl physicalEventIndex, generateInterruptParameters, INTERRUPT_ENGINE.GENERATE_INTERRUPT.CHANNEL_INDEX_SHIFT

   ; Add originator EE to the parameters.
   rename(r0, temp)
   shl originatorEE, temp, INTERRUPT_ENGINE.GENERATE_INTERRUPT.ORIGINATOR_EE_SHIFT
   or generateInterruptParameters, generateInterruptParameters, temp

   ; Store interrupt type in the parameters.
   or_imm generateInterruptParameters, generateInterruptParameters, INTERRUPT_ENGINE.GENERATE_INTERRUPT.EVENT_STATE_CHANGE

   ; Go to send the interrupt.
   jump SendInterruptAndGoIdle

   ; Forget all the aliases.
   forgetall()

   ; ********************************************************
   ; * Cancel Interrupt Moderation                          *
   ; ********************************************************
CancelInterruptModeration:
   rename(r1, physicalChannelIndex)
   rename(r2, originatorEE)
   
   ; Read the channel context, we're interested only in one returned value of the three, therefore there's no need to rename them.
   rename(r3, CC)
   load_channel_context CC, r5, r6, physicalChannelIndex, CHANNEL
   
   ; Extract EE from CC.
   rename(r14, EE)
   and_shr CC, EE, CC.EE_SHIFT, CC.EE_MASK

   ; Extract ERINDEX from CC.
   rename(r16, virtualEventIndex)
   and_shr CC, virtualEventIndex, CC.ERINDEX_SHIFT, CC.ERINDEX_MASK

   ; Get the physical event ring index.
   rename(r0, physicalEventIndex)
   vir2phy physicalEventIndex, EE, virtualEventIndex, EVENT

   ; Construct INTERRUPT_ENGINE.CANCEL_INTERRUPT_MODERATION parameters.
   rename(r4, cancelInterruptModerationParameters)
   shl physicalEventIndex, cancelInterruptModerationParameters, INTERRUPT_ENGINE.STOP_INTERRUPT_MODERATION.PHYSICAL_EVENT_INDEX_SHIFT
   forget(physicalEventIndex)
   ; Set the memory type to MEMTYPE_NORMAL_NON_CACHEABLE
   or_imm cancelInterruptModerationParameters, cancelInterruptModerationParameters, MEMTYPE_NORMAL_NON_CACHEABLE << INTERRUPT_ENGINE.STOP_INTERRUPT_MODERATION.MEMORY_TYPE_SHIFT

CancelInterruptModerationRetry:
   activate_accelerator INTERRUPT_ENGINE, INTERRUPT_ENGINE.CANCEL_INTERRUPT_MODERATION, INTERRUPT_ENGINE.CANCEL_INTERRUPT_MODERATION_HINT
   forget(cancelInterruptModerationParameters)

   ; Add return code in originator EE scratch
   rename(r0, scratchpad)
   load_single originatorEE, scratchpad, EEC_RAM.ELEMENT_SIZE, EEC_RAM.INTER_EE_COMMAND_RETURN_CODE.OFFSET, SHRAM_ID_USE, SHRAM_ID_EE_SCRATCH, EEC_RAM.INTER_EE_COMMAND_RETURN_CODE.MSB
   and_imm scratchpad, scratchpad, EEC.INTER_EE_COMMAND_RETURN_CODE_CLEAN_MASK

   beq ACCELERATOR_STATUS_REGISTER, CancelInterruptModerationPendingInterruptCancelled, ACCELERATOR_STATUS_REGISTER.STATUS.SUCCESS
   beq ACCELERATOR_STATUS_REGISTER, CancelInterruptModerationNoPendingInterrupt, ACCELERATOR_STATUS_REGISTER.STATUS.OUT_OF_BUFFERS
   jump CancelInterruptModerationRetry

CancelInterruptModerationPendingInterruptCancelled:
   or_shl scratchpad, scratchpad, EEC.INTER_EE_COMMAND_RETURN_CODE_SHIFT, EEC.INTER_EE_COMMAND_RETURN_CODE_SUCCESS
   jump CancelInterruptModerationUpdateContext

CancelInterruptModerationNoPendingInterrupt:
   or_shl scratchpad, scratchpad, EEC.INTER_EE_COMMAND_RETURN_CODE_SHIFT, EEC.INTER_EE_COMMAND_RETURN_CODE_NO_PENDING_INTERRUPT

CancelInterruptModerationUpdateContext:
   store_single originatorEE, scratchpad, EEC_RAM.ELEMENT_SIZE, EEC_RAM.INTER_EE_COMMAND_RETURN_CODE.OFFSET, SHRAM_ID_USE, SHRAM_ID_EE_SCRATCH, EEC_RAM.INTER_EE_COMMAND_RETURN_CODE.MSB
   forget(scratchpad)

   ; Store the channel index for the future usage by INTERRUPT_ENGINE.GENERATE_INTERRUPT.
   rename(r4, generateInterruptParameters)
   shl physicalChannelIndex, generateInterruptParameters, INTERRUPT_ENGINE.GENERATE_INTERRUPT.CHANNEL_INDEX_SHIFT

   ; Store the originator EE for the future usage by INTERRUPT_ENGINE.GENERATE_INTERRUPT.
   rename(r0, temp)
   shl originatorEE, temp, INTERRUPT_ENGINE.GENERATE_INTERRUPT.ORIGINATOR_EE_SHIFT
   or generateInterruptParameters, generateInterruptParameters, temp

   ; Add missing constant fields to the input parameters.
   or_imm generateInterruptParameters, generateInterruptParameters, INTERRUPT_ENGINE.GENERATE_INTERRUPT.CHANNEL_STATE_CHANGE

   ; Go to send the interrupt.
   jump SendInterruptAndGoIdle

   ; Forget all the aliases.
   forgetall()

   ; ********************************************************
   ; * Generic EE Command Interrupt                         *
   ; ********************************************************
@gsi_iram_ptr_ee_generic_cmd:
   rename(r0, temp)
   
   ; Input parameters from SW.
   rename(r4, operationKind)
   rename(r5, rwParameter2)
   rename(r6, rwParameter3)
   rename(r7, rwParameter4)
   rename(r8, rwParameter5)
   rename(r9, rwParameter6)

   ; Prepare index register we'll need.
   rename(r1, index)
   and_imm index, index, 0
   
   ; Allocate a register for the operation completion code.
   rename(r2, completionCode)
   and_imm completionCode, completionCode, 0
   
   ; Load the parameters from the SW -> GSI data communication area.
   load_mul_imm operationKind, rwParameter2, rwParameter3, rwParameter4, ALL_FOUR_REGISTERS_ENABLE, DRAM.REGISTER_ACCESS_SW_COMMUNICATION_IN_PARAMETER1
   load_mul_imm rwParameter5, rwParameter6, temp, temp, TWO_FIRST_REGISTERS_ENABLE, DRAM.REGISTER_ACCESS_SW_COMMUNICATION_IN_PARAMETER5
   nop
   
   ; Check whether the requested operation is read or write.
   beq operationKind, PerformRead, READ_WRITE_ENGINE.READ_OPERATION
   beq operationKind, PerformWrite, READ_WRITE_ENGINE.WRITE_OPERATION
   
   ; Any other kind of operation isn't supported and is aborted at this stage.
FinishOperation:
   go_idle
   
PerformRead:
   activate_accelerator READ_WRITE_ENGINE, READ_WRITE_ENGINE.READ
   
   ; Make sure the read was successful, otherwise respond with an error.
   bneq ACCELERATOR_STATUS_REGISTER, ReadWriteError, ACCELERATOR_STATUS_REGISTER.STATUS.SUCCESS

   ; Check whether the read we've just issued was blocking or not.
   and_shr rwParameter4, temp, READ_WRITE_ENGINE.BLOCKING_SHIFT, READ_WRITE_ENGINE.BLOCKING_MASK
   bneq temp, FinishOperation, 1

   ; Return the read value to the user.
   and_imm temp, temp, 0
   store_mul_imm temp, ACCELERATOR_RETURN_VALUE_LSB_REGISTER, ACCELERATOR_RETURN_VALUE_MSB_REGISTER, temp, DRAM.REGISTER_ACCESS_SW_COMMUNICATION_OUT_COMPLETION_CODE

MarkSuccessfullCompletion:   
   or_imm completionCode, completionCode, READ_WRITE_ENGINE.OPERATION_COMPLETED_SUCCESSFULLY
   store_single index, completionCode, 0, 0, DRAM.REGISTER_ACCESS_SW_COMMUNICATION_OUT_COMPLETION_CODE, 0
   go_idle
   
PerformWrite:
   activate_accelerator READ_WRITE_ENGINE, READ_WRITE_ENGINE.WRITE
   
   ; Make sure the write was successful, otherwise respond with an error.
   bneq ACCELERATOR_STATUS_REGISTER, ReadWriteError, ACCELERATOR_STATUS_REGISTER.STATUS.SUCCESS
   
   ; Check whether the write we've just issued was blocking or not.
   and_shr rwParameter6, temp, READ_WRITE_ENGINE.BLOCKING_SHIFT, READ_WRITE_ENGINE.BLOCKING_MASK
   bneq temp, FinishOperation, 1

   ; Mark the operation completion.
   jump MarkSuccessfullCompletion

ReadWriteError:
   or_imm completionCode, completionCode, READ_WRITE_ENGINE.OPERATION_COMPLETED_WITH_ERROR
   store_single index, completionCode, 0, 0, DRAM.REGISTER_ACCESS_SW_COMMUNICATION_OUT_COMPLETION_CODE, 0
   go_idle
   
   ; Forget all the aliases.
   forgetall()

   ; *********************************************************
   ; * Handle Channel Doorbell: R13=PH_CHID(5) + DB_VAL (12) *
   ; *********************************************************
@gsi_iram_ptr_ch_db:
   ; The input parameters are delivered via R13.
   rename(r13, inputParameters)

   ; Extract the physical channel index from the input parameters.
   rename(r2, physicalChannelIndex)
   and_shr inputParameters, physicalChannelIndex, DOORBELL_ENGINE.PHYSICAL_CHANNEL_INDEX_SHIFT, DOORBELL_ENGINE.PHYSICAL_CHANNEL_INDEX_MASK
   
   ; Read MAX_OUTSTANDING_TRES and run Prefect Control flow only if it's not zero.
   rename(r5, maxOutstandingTREs)
   load_single physicalChannelIndex, maxOutstandingTREs, CC_RAM.ELEMENT_SIZE, CC_RAM.MAX_OUTSTANDING_TRES.OFFSET, SHRAM_ID_USE, SHRAM_ID_CH_CONTEXT, CC_RAM.MAX_OUTSTANDING_TRES.MSB
   nop
   and_shr maxOutstandingTREs, maxOutstandingTREs, CC.MAX_OUTSTANDING_TRES_SHIFT, CC.MAX_OUTSTANDING_TRES_MASK
   bneq maxOutstandingTREs, RunPrefetchControl, 0
   forget(maxOutstandingTREs)
   
   ; Execute the standard DB handling if no Prefetch Control is required.
   ; Forward the input data as is to RE_ENGINE.
   rename(r4, updateDoorbellInputParameters)
   move inputParameters, updateDoorbellInputParameters
   forget(inputParameters)
   
   ; Call RE_ENGINE.UPDATE_DOORBELL.
   ; The returned status is always success and therefore it's not checked.
   activate_accelerator RE_ENGINE, RE_ENGINE.UPDATE_DOORBELL, RE_ENGINE.UPDATE_DOORBELL_HINT
   forget(updateDoorbellInputParameters)
   
   jump UlDlSynchronizationCheck
   
RunPrefetchControl:
   ; Mask the channel doorbells.
   rename(r0 ,temp)
   and_imm temp, temp, 0
   or_imm temp, temp, 1
   set_bit CHANNEL_DORBELL_MASK_REGISTER, CHANNEL_DORBELL_MASK_REGISTER, physicalChannelIndex, temp

   ; Execute Prefetch Control flow.
   call PrefetchControl
   
UlDlSynchronizationCheck:
   ; Check whether UL/DL Synchronization is active.
   rename(r1, ulDlSyncActive)
   load_single physicalChannelIndex, ulDlSyncActive, CC_RAM.ELEMENT_SIZE, CC_RAM.UL_DL_SYNC_ACTIVE.OFFSET, SHRAM_ID_USE, SHRAM_ID_CH_CONTEXT, CC_RAM.UL_DL_SYNC_ACTIVE.MSB
   nop
   and_imm ulDlSyncActive, ulDlSyncActive, CC.UL_DL_SYNC_ACTIVE_MASK
   beq ulDlSyncActive, NoUlDlSync, 0

   ; Mark that we're in polling mode.
   rename(r3, channelScratchpad)
   load_single physicalChannelIndex, channelScratchpad, CC_RAM.ELEMENT_SIZE, CC_RAM.POLLING_MODE.OFFSET, SHRAM_ID_USE, SHRAM_ID_CH_CONTEXT, CC_RAM.POLLING_MODE.MSB
   nop
   or_imm channelScratchpad, channelScratchpad, CC.POLLING_MODE_MASK
   store_single physicalChannelIndex, channelScratchpad, CC_RAM.ELEMENT_SIZE, CC_RAM.POLLING_MODE.OFFSET, SHRAM_ID_USE, SHRAM_ID_CH_CONTEXT, CC_RAM.POLLING_MODE.MSB

   ; For UL channel configure an interrupt, for DL channel unmask empty interrupt.
   rename(r5, CC)
   load_channel_context CC, r14, r15, physicalChannelIndex, CHANNEL
   rename(r6, virtualChannelIndex)
   and_shr CC, virtualChannelIndex, CC.CHID_SHIFT, CC.CHID_MASK
   bneq virtualChannelIndex, DlChannel, UL_DL_SYNC_UL_VIRTUAL_CHANNEL

UlChannel:   
   call ConfigureUlDlSyncTimer
   jump NoUlDlSync
   
DlChannel:
   ; For DL channel unmask empty interrupt.
   and_imm temp, temp, 0
   set_bit CHANNEL_EMPTY_MASK_REGISTER, CHANNEL_EMPTY_MASK_REGISTER, physicalChannelIndex, temp
   
NoUlDlSync:
   go_idle

   ; Forget all the aliases.
   forgetall()

   ; **********************************************************
   ; * Handle New Ring Element: R13=PH_CHID(5) + RE_LPTR (12) *
   ; **********************************************************
@gsi_iram_ptr_new_re:
   ; The input parameters are delivered via R13.
   rename(r13, inputParameters)

   ; Extract the local ring element pointer from the input parameters.
   rename(r14, localRingElementPointer)
   and_shr inputParameters, localRingElementPointer, RE_ENGINE.LOCAL_RING_ELEMENT_POINTER_SHIFT, RE_ENGINE.LOCAL_RING_ELEMENT_POINTER_MASK

   ; Load the transfer ring element (TRE) into four registers.
   ; We pick up the registers in such a way that it will be easier to issue IPA_IF.PROCESS_DESCRIPTOR afterwards.
   rename(r8, TRE[0])
   rename(r9, TRE[1])
   rename(r6, TRE[2])
   rename(r7, TRE[3])
   load_mul_reg TRE[0], TRE[1], TRE[2], TRE[3], ALL_FOUR_REGISTERS_ENABLE, localRingElementPointer
   forget(localRingElementPointer)

   ; While the load is being done extract the physical channel index from the input parameters.
   rename(r2, physicalChannelIndex)
   and_shr inputParameters, physicalChannelIndex, RE_ENGINE.PHYSICAL_CHANNEL_INDEX_SHIFT, RE_ENGINE.PHYSICAL_CHANNEL_INDEX_MASK
   forget(inputParameters)

   ; Read the channel context.
   rename(r1, CC)
   rename(r18, CC_2)
   load_channel_context CC, r17, CC_2, physicalChannelIndex, CHANNEL

   ; Extract CC.CHTYPE.
   and_shr CC, r5, CC.CHTYPE_SHIFT, CC.CHTYPE_MASK
   beq r5, XdciNewRe, CC.CHTYPE.XDCI
   forget(CC_2)

   ; At this point we must make sure that the received TRE is correct.
   ; For this purpose we check TRE.TYPE field and assume that the only allowed values are TRE.TYPE.TRANSFER and TRE.TYPE.IMMEDIATE_COMMAND.
   rename(r3, treType)
   and_shr TRE[3], treType, TRE.TYPE_SHIFT, TRE.TYPE_MASK
   beq treType, CorrectTreType, TRE.TYPE.TRANSFER
   ;beq treType, CorrectTreType, TRE.TYPE.BUBBLE
   bneq treType, MalformedRingElementError, TRE.TYPE.IMMEDIATE_COMMAND
   forget(treType)

CorrectTreType:
   ; Extract TRE.CHAIN bit and save it in the channel bitmask register.
   rename(r14, treChain)
   and_shr TRE[3], treChain, TRE.CHAIN_SHIFT, TRE.CHAIN_MASK
   set_bit CHAIN_REGISTER, CHAIN_REGISTER, physicalChannelIndex, treChain

   ; Now we need to prepare the remaining parameters for IPA_IF.PROCESS_DESCRIPTOR.

   ; Turn on bit 40 of the buffer address if needed.
   rename(TRE[1], bufferAddressHigh)
   rename(r3, assertBitmask)
   load_single physicalChannelIndex, assertBitmask, CC_RAM.ELEMENT_SIZE, CC_RAM.ASSERT_BIT_40.OFFSET, SHRAM_ID_USE, SHRAM_ID_CH_CONTEXT, CC_RAM.ASSERT_BIT_40.MSB
   nop
   and_shl assertBitmask, assertBitmask, CC.ASSERT_BIT_40_TO_ADDRESS_BIT_40_IN_MSB_SHL, CC.ASSERT_BIT_40_MASK
   or bufferAddressHigh, bufferAddressHigh, assertBitmask
   forget(assertBitmask)
   
   ; Prepare the user data for IPA_IF.PROCESS_DESCRIPTOR.
   ; We'll need TRE.CHAIN, TRE.IEOB, TRE.IEOT, TRE.BEI, TRE.SCT, TRE.TYPE (contained in TRE[3]) and physical channel index.
   ; We'll copy TRE[3] to the user data as is and will store the channel index in the unused bits.
   rename(r4, ipaIfParameter0)
   and_imm TRE[3], ipaIfParameter0, TRE.SCT_MASK | TRE.IEOB_MASK | TRE.IEOT_MASK | TRE.BEI_MASK | TRE.TYPE_MASK
   or ipaIfParameter0, ipaIfParameter0, treChain
   rename(r3, temp)
   shl physicalChannelIndex, temp, IPA_IF.USER_DATA.PHYSICAL_CHANNEL_INDEX_SHIFT
   or ipaIfParameter0, ipaIfParameter0, temp
   
   ; Now finish processing the fields copied from TRE.
   and_imm TRE[2], TRE[2], IPA_IF.BUFFER_LENGTH_MASK
   rename(TRE[2], ipaIfParameter2)
   and_shl TRE[3], temp, TRE.SCT_TO_IPA_IF.SCT_SHL, TRE.SCT_MASK
   or ipaIfParameter2, ipaIfParameter2, temp
   and_imm TRE[3], TRE[3], IPA_IF.DESCRIPTOR_TYPE_MASK
   rename(TRE[3], ipaIfParameter3)
   shl treChain, temp, IPA_IF.CHAIN_SHIFT
   or ipaIfParameter2, ipaIfParameter2, temp

   ; Process the fields copied from CC.
   and_shr CC, temp, CC.EE_TO_IPA_IF.EE_SHR, CC.EE_MASK
   or ipaIfParameter3, ipaIfParameter3, temp

   and_shl CC, temp, CC.CHID_TO_IPA_IF.VIRTUAL_CHANNEL_INDEX_SHL, CC.CHID_MASK
   or ipaIfParameter3, ipaIfParameter3, temp

   ; Finally we're ready to call IPA_IF.PROCESS_DESCRIPTOR.
   activate_accelerator IPA_IF, IPA_IF.PROCESS_DESCRIPTOR, IPA_IF.PROCESS_DESCRIPTOR_HINT
   forget(ipaIfParameter0)
   forget(ipaIfParameter2)
   forget(ipaIfParameter3)
  
   ; POP's activate accelerator changes the status register, so we need to save it for future check.
   move ACCELERATOR_STATUS_REGISTER, temp
   
   ; We may now call RE_ENGINE.POP.
   ; The returned status is always success and therefore it's not checked.
   rename(r4, popParameters)
   move physicalChannelIndex, popParameters
   activate_accelerator RE_ENGINE, RE_ENGINE.POP, RE_ENGINE.POP_HINT
   forget(popParameters)

   ; Out of the 3 possible return values only one is considered an error - ACCELERATOR_STATUS_REGISTER.STATUS.OUT_OF_BUFFERS_IPA_IF.
   ; The other two - ACCELERATOR_STATUS_REGISTER.STATUS.SUCCESS and ACCELERATOR_STATUS_REGISTER.STATUS.BECAME_FULL_IPA_IF indicate successful completion.
   beq temp, OutOfBuffersDuringProcessDescriptorError, ACCELERATOR_STATUS_REGISTER.STATUS.OUT_OF_BUFFERS_IPA_IF
   
   ; If STOP_REGISTER[physicalChannelIndex] == 1 and TRE.CHAIN == 0 then we need to jump to the stop sequence.

   ; Check TRE.CHAIN.
   beq treChain, NoStopSequence, 1

   ; Check STOP_REGISTER[physicalChannelIndex].
   check_bit STOP_REGISTER, temp, physicalChannelIndex, 1
   beq temp, DoStopSequence, 1

NoStopSequence:
   go_idle

OutOfBuffersDuringProcessDescriptorError:
   rename(r5, errorDescription)
   
   ; Put the physical channel index in R1 as required by OutOfBuffersChannelError procedure.
   forget(CC)
   move physicalChannelIndex, r1
   
   ; Add error description.
   and_imm errorDescription, errorDescription, 0
   or_imm errorDescription, errorDescription, (ERROR_LOG.ERROR_CODE.OUT_OF_BUFFERS << ERROR_LOG.ERROR_CODE_SHIFT) | (IPA_IF << ERROR_LOG.ACCELERATOR_OPCODE_SHIFT) | (IPA_IF.PROCESS_DESCRIPTOR << ERROR_LOG.ROUTINE_OPCODE_SHIFT)
   
   jump OutOfBuffersChannelError

DoStopSequence:
   ; Prepare the parameters for the stop sequence - stop originator EE in R2 and physical channel index in R4.
   move physicalChannelIndex, r1
   forget(physicalChannelIndex)
   rename(r2, stopOriginatorEE)
   rename(r1, physicalChannelIndex)
   load_single physicalChannelIndex, stopOriginatorEE, CC_RAM.ELEMENT_SIZE, CC_RAM.STOP_ORIGINATOR_EE.OFFSET, SHRAM_ID_USE, SHRAM_ID_CH_CONTEXT, CC_RAM.STOP_ORIGINATOR_EE.MSB
   nop
   and_shr stopOriginatorEE, stopOriginatorEE, CC.STOP_ORIGINATOR_EE_SHIFT, CC.STOP_ORIGINATOR_EE_MASK

   ; Continue to the stop flow.
   jump InternalStopSequenceEntryPoint
   
   ; Forget all the aliases.
   forgetall()

XdciNewRe:
   rename(r2, physicalChannelIndex)
   rename(r1, CC)
   rename(r7, TRB3)
   rename(r0, temp)

   ; Extract EE from CC.
   rename(r14, EE)
   and_shr CC, EE, CC.EE_SHIFT, CC.EE_MASK

   ; Check for Link TRB
   and_shr TRB3, temp, 4, 0x3f0
   beq temp, XdciNewReBubble, 0x8

   ; Check for HWO=1
   and_imm TRB3, temp, 1
   beq temp, XdciNewReCorrectTRB, 0
   forget(TRB3)

   ; We should call RE_ENGINE.POP.
   ; The returned status is always success and therefore it's not checked.
   rename(r4, popParameters)
   move physicalChannelIndex, popParameters
   activate_accelerator RE_ENGINE, RE_ENGINE.POP, RE_ENGINE.POP_HINT
   forget(popParameters)  

   ; Mask the channel doorbells.
   set_bit CHANNEL_DORBELL_MASK_REGISTER, CHANNEL_DORBELL_MASK_REGISTER, physicalChannelIndex, temp

   ; Disable channel.
   rename(r4, disableChannelInput)
   rename(r5, disableChannelUserData)

   ; Store physical channel index in the input.
   shl physicalChannelIndex, disableChannelInput, RE_ENGINE.ROUTINE.PHYSICAL_CHANNEL_INDEX_SHIFT

   ; Store physical channel index in the user data.
   move physicalChannelIndex, disableChannelUserData

   ; Store the error type in the user data.
   or_imm disableChannelUserData, disableChannelUserData, RE_ENGINE.USER_DATA.ERROR_TYPE_XDCI_WRONG_HWO << RE_ENGINE.USER_DATA.ERROR_TYPE_SHIFT

   activate_accelerator RE_ENGINE, RE_ENGINE.DISABLE_CHANNEL, RE_ENGINE.DISABLE_CHANNEL_HINT
   forget(disableChannelInput)
   forget(disableChannelUserData)

   go_idle

   rename(r7, ipaIfParameter3)

XdciNewReBubble:
   ; Set Transfer type to BUBBLE.
   and_imm ipaIfParameter3, ipaIfParameter3, 0
   ;or_shl ipaIfParameter3, ipaIfParameter3, IPA_IF.DESCRIPTOR_TYPE_SHIFT, IPA_IF.DESCRIPTOR_TYPE.BUBBLE
   or_imm ipaIfParameter3, ipaIfParameter3, IPA_IF.DESCRIPTOR_TYPE.BUBBLE_SHIFTED
   jump XdciNewReFinish

XdciNewReCorrectTRB:
   rename(r8, TRB0)
   rename(r9, TRB1)
   rename(r6, TRB2)

   ; Get channel scratch 0.
   rename(r18, xDCIChannelScratch0)
   load_single physicalChannelIndex, xDCIChannelScratch0, CC_RAM.ELEMENT_SIZE, CC_RAM.SCRATCHPAD0_LOW.OFFSET, SHRAM_ID_USE, SHRAM_ID_CH_CONTEXT, CC_RAM.SCRATCHPAD0_LOW.MSB

   ; Prepare the user data for IPA_IF.PROCESS_DESCRIPTOR.
   rename(r4, ipaIfUserData)
   ; Extract TRB0,bits 10:31 and set to user data.
   shr TRB0, ipaIfUserData, IPA_IF.USER_DATA.BUFFER_ADDRESS_LO_SHIFT
   ; Extract TRB1,bits 0:7 and set to user data.
   shl TRB1, temp, IPA_IF.USER_DATA.BUFFER_ADDRESS_HI_SHIFT
   or ipaIfUserData, ipaIfUserData, temp

   ; Extract CC.CHDIR.
   rename(r5, direction)
   and_shr CC, direction, CC.CHDIR_SHIFT, CC.CHDIR_MASK

   ; Check for direction.
   beq direction, XdciNewReOut, CC.CHDIR.OUTBOUND

   ; Check for IN ZLP.
   beq ipaIfUserData, XdciNewReBubble, 0

   ; Set Transfer length.
   and_shr xDCIChannelScratch0, TRB2, 17, 0xf8000000
   jump XdciNewReOutInFinish

XdciNewReOut:
   ; Extract CONST_BUFF_SIZE from the channel scratch and convert to bytes
   rename(r15, CONST_BUFF_SIZE)
   and_shr xDCIChannelScratch0, CONST_BUFF_SIZE, 17, 0xf8000000
   forget(xDCIChannelScratch0)

   and_imm TRB2, TRB2, 0xffff

   ; Set Transfer length.
   sub CONST_BUFF_SIZE, TRB2, TRB2
   forget(CONST_BUFF_SIZE)

   ; Check for OUT ZLP.
   beq TRB2, XdciNewReBubble, 0

XdciNewReOutInFinish:
   ; Set Transfer type to TRANSFER.
   and_imm ipaIfParameter3, ipaIfParameter3, 0
   or_shl ipaIfParameter3, ipaIfParameter3, IPA_IF.DESCRIPTOR_TYPE_SHIFT, IPA_IF.DESCRIPTOR_TYPE.TRANSFER

   ; Set Transfer direction.
   shl direction, temp, IPA_IF.DIRECTION_SHIFT
   or TRB2, TRB2, temp

XdciNewReFinish:
   ; Process the fields copied from CC.
   or ipaIfParameter3, ipaIfParameter3, EE
   rename(temp, virtualChannelIndex)
   and_shl CC, virtualChannelIndex, CC.CHID_TO_IPA_IF.VIRTUAL_CHANNEL_INDEX_SHL, CC.CHID_MASK
   or ipaIfParameter3, ipaIfParameter3, virtualChannelIndex
   rename(virtualChannelIndex, temp)

   ; Finally we're ready to call IPA_IF.PROCESS_DESCRIPTOR.
   activate_accelerator IPA_IF, IPA_IF.PROCESS_DESCRIPTOR, IPA_IF.PROCESS_DESCRIPTOR_HINT
   forget(ipaIfUserData)
   forget(direction)
   forget(TRB0)
   forget(TRB1)
   forget(TRB2)
   forget(ipaIfParameter3)
   
   ; POP's activate accelerator changes the status register, so we need to save it for future check.
   move ACCELERATOR_STATUS_REGISTER, temp

   ; We may now call RE_ENGINE.POP.
   ; The returned status is always success and therefore it's not checked.
   rename(r4, popParameters)
   move physicalChannelIndex, popParameters
   activate_accelerator RE_ENGINE, RE_ENGINE.POP, RE_ENGINE.POP_HINT
   forget(popParameters)
   
   ; Out of the 3 possible return values only one is considered an error - ACCELERATOR_STATUS_REGISTER.STATUS.OUT_OF_BUFFERS_IPA_IF.
   ; The other two - ACCELERATOR_STATUS_REGISTER.STATUS.SUCCESS and ACCELERATOR_STATUS_REGISTER.STATUS.BECAME_FULL_IPA_IF indicate successful completion.
   beq temp, OutOfBuffersDuringProcessDescriptorError, ACCELERATOR_STATUS_REGISTER.STATUS.OUT_OF_BUFFERS_IPA_IF

   go_idle

   ; Forget all the aliases.
   forgetall()

@gsi_iram_ptr_periph_if_tlv_in_0:
   ; The input parameters are delivered via R13-R18, but we need only R13, R15 and R16.
   rename(r13, userData)
   rename(r15, actualLengthAndEOT)
   rename(r16, status)
   rename(r0, temp)

   ; Determine the physical channel index (EE and virtual channel index are returned by IPA IF together with the status).
   rename(r14, EE)
   and_shr status, EE, IPA_IF.EE_SHIFT, IPA_IF.EE_MASK 
   rename(r1, virtualChannelIndex)
   and_shr status, virtualChannelIndex, IPA_IF.VIRTUAL_CHANNEL_INDEX_SHIFT, IPA_IF.VIRTUAL_CHANNEL_INDEX_MASK

   vir2phy virtualChannelIndex, EE, virtualChannelIndex, CHANNEL
   rename(virtualChannelIndex, physicalChannelIndex)

   ; The returned status is always 0 (SUCCESS), so we don't do any error checks.
   forget(status)

   ; Obtain the current read pointer value to use it for event generation in the future.
   rename(r3, readPointer)
   load_rd_ptr readPointer, physicalChannelIndex

   ; Issue RE_ENGINE.COMPLETE.
   ; The returned status is always success and therefore it's not checked.
   move physicalChannelIndex, r4
   activate_accelerator RE_ENGINE, RE_ENGINE.COMPLETE, RE_ENGINE.COMPLETE_HINT

   ; Execute Prefetch Control flow if running in DB mode and MAX_OUTSTANDING_TRES isn't 0.
   rename(r5, maxOutstandingTREs)   
   load_single physicalChannelIndex, temp, CC_RAM.ELEMENT_SIZE, CC_RAM.DB_MODE.OFFSET, SHRAM_ID_USE, SHRAM_ID_CH_CONTEXT, CC_RAM.DB_MODE.MSB
   load_single physicalChannelIndex, maxOutstandingTREs, CC_RAM.ELEMENT_SIZE, CC_RAM.MAX_OUTSTANDING_TRES.OFFSET, SHRAM_ID_USE, SHRAM_ID_CH_CONTEXT, CC_RAM.MAX_OUTSTANDING_TRES.MSB

   and_shr temp, temp, CC.DB_MODE_SHIFT, CC.DB_MODE_MASK
   beq temp, SkipPrefetchControl, 0

   and_shr maxOutstandingTREs, maxOutstandingTREs, CC.MAX_OUTSTANDING_TRES_SHIFT, CC.MAX_OUTSTANDING_TRES_MASK
   beq maxOutstandingTREs, SkipPrefetchControl, 0
   forget(maxOutstandingTREs)
   
   move physicalChannelIndex, r2
   call PrefetchControl

SkipPrefetchControl:
   ; Read the channel context for the later usage.
   rename(r2, CC)
   rename(r18, CC_2)
   load_channel_context CC, temp, CC_2, physicalChannelIndex, CHANNEL

   ; Extract CC.CHTYPE.
   and_shr CC, r5, CC.CHTYPE_SHIFT, CC.CHTYPE_MASK
   beq r5, XdciIpaIfDescProcComp, CC.CHTYPE.XDCI
   forget(CC_2)

   ; IPA_IF.DESCRIPTOR_TYPE.BUBBLE support
   ;and_shr status, temp, IPA_IF.DESCRIPTOR_TYPE_SHIFT, IPA_IF.DESCRIPTOR_TYPE_MASK
   ;bneq temp, NotBubble, IPA_IF.DESCRIPTOR_TYPE.BUBBLE
   ;go_idle

;NotBubble:

   ; Extract ERINDEX from CC.
   rename(r9, virtualEventIndex)
   and_shr CC, virtualEventIndex, CC.ERINDEX_SHIFT, CC.ERINDEX_MASK

   ; In case of eventless channel we skip the event generation logic.
   beq virtualEventIndex, EventGenerationCompleted, CC.ERINDEX.UNALLOCATED_EVENT
   
   ; Extract the actual length and EOT parameters into the separate registers.
   rename(r16, EOT)
   and_shr actualLengthAndEOT, EOT, IPA_IF.EOT_SHIFT, IPA_IF.EOT_MASK

   and_shr actualLengthAndEOT, actualLengthAndEOT, IPA_IF.ACTUAL_LENGTH_SHIFT, IPA_IF.ACTUAL_LENGTH_MASK
   rename(actualLengthAndEOT, actualLength)

   ; Prepare TCE[2] for the event generation.
   rename(r7, TCE[2])

   ; if(IEOT && EOT) TCE.CODE = TCE.CODE_EOT
CheckForEotEvent:
   and_shr userData, temp, IPA_IF.USER_DATA.IEOT_SHIFT, IPA_IF.USER_DATA.IEOT_MASK
   beq temp, CheckForOverflowEvent, 0

   or_imm actualLength, TCE[2], TCE.CODE_EOT
   beq EOT, GenerateEvent, 1

   ; if(CHTYPE.MHI && CC.CHDIR.INBOUND && !EOT && !CHAIN) TCE.CODE = TCE.CODE_OVERFLOW
CheckForOverflowEvent:
   and_imm CC, temp, CC.CHTYPE_MASK | CC.CHDIR_MASK
   bneq temp, CheckForEobEvent, (CC.CHTYPE.MHI << CC.CHTYPE_SHIFT) | (CC.CHDIR.INBOUND << CC.CHDIR_SHIFT)
   
   bneq EOT, CheckForEobEvent, 0
   
   and_shr userData, temp, IPA_IF.USER_DATA.CHAIN_SHIFT, IPA_IF.USER_DATA.CHAIN_MASK 
  
   or_imm actualLength, TCE[2], TCE.CODE_OVERFLOW
   beq temp, GenerateEvent, 0

   ; if(IEOB) TCE.CODE = TCE.CODE_EOB
CheckForEobEvent:
   and_shr userData, temp, IPA_IF.USER_DATA.IEOB_SHIFT, IPA_IF.USER_DATA.IEOB_MASK   
   
   or_imm actualLength, TCE[2], TCE.CODE_EOB
   beq temp, GenerateEvent, 1
   
   forget(EOT)
   forget(actualLength)
   
DoNotGenerateEvent:
   jump EventGenerationCompleted

GenerateEvent:
   ; Now we need to construct the rest of TCE.

   ; Read RBASE from the DRAM into TCE[1] and TCE[0].
   rename(r5, TCE[0])
   rename(r6, TCE[1])
   load_single physicalChannelIndex, TCE[0], CC_RAM.ELEMENT_SIZE, CC_RAM.RBASE_LOW.OFFSET, SHRAM_ID_USE, SHRAM_ID_CH_CONTEXT, CC_RAM.RBASE_LOW.MSB
   load_single physicalChannelIndex, TCE[1], CC_RAM.ELEMENT_SIZE, CC_RAM.RBASE_HIGH.OFFSET, SHRAM_ID_USE, SHRAM_ID_CH_CONTEXT, CC_RAM.RBASE_HIGH.MSB
   
   ; Clean bit 40 of the address if necessary.
   load_single physicalChannelIndex, temp, CC_RAM.ELEMENT_SIZE, CC_RAM.ASSERT_BIT_40.OFFSET, SHRAM_ID_USE, SHRAM_ID_CH_CONTEXT, CC_RAM.ASSERT_BIT_40.MSB
   
   ; Clean the offset part of the address while the scratchpad loading is being done.
   and_imm TCE[0], TCE[0], CC_RAM.RBASE_LOW.POINTER_CLEAN_MASK
   
   and_shr temp, temp, CC.ASSERT_BIT_40_SHIFT, CC.ASSERT_BIT_40_MASK
   bneq temp, DoNotCleanBit40, 1
   and_imm TCE[1], TCE[1], BIT_40_CLEAN_MASK
DoNotCleanBit40:

   ; Combine RBASE with the offset.
   or TCE[0], TCE[0], readPointer
   forget(readPointer)
   
   ; Put the virtual channel index in TCE[3].
   rename(r8, TCE[3])
   and_shl CC, TCE[3], CC.CHID_TO_TCE.CHID_SHL, CC.CHID_MASK
   
   ; Set the type to TCE or ICCE (depending on the corresponding TRE type).
   ; The conversion from TRE type to the corresponding TCE type is easily done by OR-ing with TCE.TYPE_TRE_TO_TCE.
   and_shl userData, temp, IPA_IF.USER_DATA.TYPE_TO_TCE.TYPE_SHL, IPA_IF.USER_DATA.TYPE_MASK
   or_imm temp, temp, TCE.TYPE_TRE_TO_TCE
   or TCE[3], TCE[3], temp

   ; For MHI channels add MHI_CHANNEL_INDEX_BASE to the GSI channel index.
   and_shr CC, temp, CC.CHTYPE_SHIFT, CC.CHTYPE_MASK
   bneq temp, NotMhiChannel, CC.CHTYPE.MHI
   
   ; Read MHI_CHANNEL_INDEX_BASE from EEC.
   load_single EE, temp, EEC_RAM.ELEMENT_SIZE, EEC_RAM.MHI_CHANNEL_INDEX_BASE.OFFSET, SHRAM_ID_USE, SHRAM_ID_EE_SCRATCH, EEC_RAM.MHI_CHANNEL_INDEX_BASE.MSB
   nop
   and_imm temp, temp, EEC.MHI_CHANNEL_INDEX_BASE_MASK
   add TCE[3], TCE[3], temp
NotMhiChannel:
   
   ; Get the physical event ring index.
   rename(r4, generateEventParameter0)
   vir2phy generateEventParameter0, EE, virtualEventIndex, EVENT
   forget(virtualEventIndex)

   ; Make sure the translation was successful.
   and_imm temp, temp, 0
   or_imm temp, temp, VIR2PHY_FAILURE
   sub temp, temp, generateEventParameter0
   beq temp, NonAllocatedEventAccessError, 0

   ; TODO: Here we also exploit the fact that as a result descriptor type field will be set to 0 which corresponds to the transfer descriptor as we need.
   shl generateEventParameter0, generateEventParameter0, EVENT_ENGINE.GENERATE_EVENT.PHYSICAL_EVENT_INDEX_SHIFT
   shl EE, temp, EVENT_ENGINE.GENERATE_EVENT.EE_SHIFT
   or generateEventParameter0, generateEventParameter0, temp
   shl physicalChannelIndex, temp, EVENT_ENGINE.GENERATE_EVENT.PHYSICAL_CHANNEL_INDEX_SHIFT
   or generateEventParameter0, generateEventParameter0, temp
   ; Set the memory type to MEMTYPE_NORMAL_NON_CACHEABLE
   or_imm generateEventParameter0, generateEventParameter0, MEMTYPE_NORMAL_NON_CACHEABLE << EVENT_ENGINE.GENERATE_EVENT.MEMORY_TYPE_SHIFT

   ; Now it's the time to generate the user data.
   ; This will simply be a parameter to INTERRUPT_ENGINE.GENERATE_INTERRUPT that must be called from the completion interrupt handler.
   rename(r9, generateEventUserData)

   and_shr generateEventParameter0, generateEventUserData, EVENT_ENGINE.GENERATE_EVENT.PHYSICAL_EVENT_INDEX_TO_INTERRUPT_ENGINE.GENERATE_INTERRUPT.CHANNEL_INDEX_SHR, EVENT_ENGINE.GENERATE_EVENT.PHYSICAL_EVENT_INDEX_MASK
   shl EE, temp, INTERRUPT_ENGINE.GENERATE_INTERRUPT.ORIGINATOR_EE_SHIFT
   or generateEventUserData, generateEventUserData, temp

   ; BEI bit in the user data serves as the interrupt moderation indication.
   and_shl userData, temp, IPA_IF.USER_DATA.BEI_TO_INTERRUPT_ENGINE.GENERATE_INTERRUPT.ENABLE_INTERRUPT_MODERATION_SHL, IPA_IF.USER_DATA.BEI_MASK
   or generateEventUserData, generateEventUserData, temp

   or_imm generateEventUserData, generateEventUserData, INTERRUPT_ENGINE.GENERATE_INTERRUPT.DESCRIPTOR_PROCESSING_SUCCEESS

   call GenerateEventAndCheckForError
   forget(generateEventParameter0)
   forget(TCE[0])
   forget(TCE[1])
   forget(TCE[2])
   forget(TCE[3])
   forget(generateEventUserData)

EventGenerationCompleted:
   ; There's a chance we'll need to run UL/DL Synchronization code now.
   ; The following conditions must hold in order to do so:
   ;   1) This is a particular predefined DL channel.
   ;   2) UL/DL Synchronization is active.
   ;   3) The corresponding predefined UL channel is working in Polling Mode.
   rename(r3, virtualChannelIndex)
   and_shr CC, virtualChannelIndex, CC.CHID_SHIFT, CC.CHID_MASK
   bneq virtualChannelIndex, FinishCompletionFlow, UL_DL_SYNC_DL_VIRTUAL_CHANNEL

   rename(virtualChannelIndex, ulDlSyncActive)
   load_single physicalChannelIndex, ulDlSyncActive, CC_RAM.ELEMENT_SIZE, CC_RAM.UL_DL_SYNC_ACTIVE.OFFSET, SHRAM_ID_USE, SHRAM_ID_CH_CONTEXT, CC_RAM.UL_DL_SYNC_ACTIVE.MSB
   nop
   and_imm ulDlSyncActive, ulDlSyncActive, CC.UL_DL_SYNC_ACTIVE_MASK
   beq ulDlSyncActive, FinishCompletionFlow, 0
   
   ; Determine the physical index of the corresponding UL channel.
   rename(ulDlSyncActive, ulVirtualChannelIndex)
   and_imm ulVirtualChannelIndex, ulVirtualChannelIndex, 0
   or_imm ulVirtualChannelIndex, ulVirtualChannelIndex, UL_DL_SYNC_UL_VIRTUAL_CHANNEL
   
   rename(CC, ulPhysicalChannelIndex)
   vir2phy ulPhysicalChannelIndex, EE, ulVirtualChannelIndex, CHANNEL
   
   rename(ulVirtualChannelIndex, ulChannelScratchpad)
   load_single ulPhysicalChannelIndex, ulChannelScratchpad, CC_RAM.ELEMENT_SIZE, CC_RAM.POLLING_MODE.OFFSET, SHRAM_ID_USE, SHRAM_ID_CH_CONTEXT, CC_RAM.POLLING_MODE.MSB
   nop

   and_shr ulChannelScratchpad, temp, CC.POLLING_MODE_SHIFT, CC.POLLING_MODE_MASK
   beq temp, FinishCompletionFlow, 0
   
   ; At this point we know that we must execute the UL/DL Synchronization code.
   ; But the further actions are different depending whether Stop Timer Mode is active or not.
   and_shr ulChannelScratchpad, temp, CC.NOT_STOP_TIMER_MODE_SHIFT, CC.NOT_STOP_TIMER_MODE_MASK
   beq temp, InStopTimer, 0

NotInStopTimer:
   ; Check whether we're at the end of the burst and go back into Stop Timer Mode if so.

   ; Read GSI_PERIPH_PENDING register from IPA_IF.
   rename(r5, gsiPeriphPendingAddressLow)
   rename(r6, gsiPeriphPendingAddressHigh)

   and_imm gsiPeriphPendingAddressLow, gsiPeriphPendingAddressLow, 0
   or_imm gsiPeriphPendingAddressLow, gsiPeriphPendingAddressLow, GSI_PERIPH_PENDING_ADDRESS

   and_imm gsiPeriphPendingAddressHigh, gsiPeriphPendingAddressHigh, 0

   rename(r7, transferParameters)
   shl physicalChannelIndex, transferParameters, READ_WRITE_ENGINE.PHYSICAL_CHANNEL_INDEX_SHIFT
   or_imm transferParameters, transferParameters, (READ_WRITE_ENGINE.FOUR_BYTE_BLOCKING_TRANSFER | READ_WRITE_ENGINE.INTERNAL_TRANSFER) & LOW_SIXTEEN_BIT_MASK
   or_imm transferParameters, transferParameters, (READ_WRITE_ENGINE.FOUR_BYTE_BLOCKING_TRANSFER_MSB | READ_WRITE_ENGINE.INTERNAL_TRANSFER) & HIGH_SIXTEEN_BIT_MASK

   activate_accelerator READ_WRITE_ENGINE, READ_WRITE_ENGINE.READ, READ_WRITE_ENGINE.READ_SYNC_HINT
   forget(gsiPeriphPendingAddressLow)
   forget(gsiPeriphPendingAddressHigh)
   forget(transferParameters)

   ; Out of the 3 possible return values only one is considered an error - ACCELERATOR_STATUS_REGISTER.STATUS.OUT_OF_BUFFERS.
   ; The other two - ACCELERATOR_STATUS_REGISTER.STATUS.SUCCESS and ACCELERATOR_STATUS_REGISTER.STATUS.BECAME_FULL indicate successful completion.
   beq ACCELERATOR_STATUS_REGISTER, OutOfBuffersDuringReadError, ACCELERATOR_STATUS_REGISTER.STATUS.OUT_OF_BUFFERS

   ; The register value is returned in the LSB register.
   ; If there're pending acks we don't go back into Stop Timer Mode.
   check_bit ACCELERATOR_RETURN_VALUE_LSB_REGISTER, temp, physicalChannelIndex, 1
   bneq temp, FinishCompletionFlow, 0

   and_imm ulChannelScratchpad, ulChannelScratchpad, CC.NOT_STOP_TIMER_MODE_CLEAN_MASK
   store_single physicalChannelIndex, ulChannelScratchpad, CC_RAM.ELEMENT_SIZE, CC_RAM.NOT_STOP_TIMER_MODE.OFFSET, SHRAM_ID_USE, SHRAM_ID_CH_CONTEXT, CC_RAM.NOT_STOP_TIMER_MODE.MSB
   
   go_idle

InStopTimer:
   ; First of all we stop the UL/DL Synchronization timer.
   rename(r4, ulDlTimerId)
   and_shr ulChannelScratchpad, ulDlTimerId, CC.UL_DL_SYNC_TIMER_ID_SHIFT, CC.UL_DL_SYNC_TIMER_ID_MASK
   activate_accelerator TIMER, TIMER.STOP_AND_RELEASE_TIMER, TIMER.STOP_AND_RELEASE_TIMER_HINT

   ; Now we mark in CC that we're not in Stop Timer Mode.
   or_imm ulChannelScratchpad, ulChannelScratchpad, CC.NOT_STOP_TIMER_MODE_MASK
   store_single ulPhysicalChannelIndex, ulChannelScratchpad, CC_RAM.ELEMENT_SIZE, CC_RAM.NOT_STOP_TIMER_MODE.OFFSET, SHRAM_ID_USE, SHRAM_ID_CH_CONTEXT, CC_RAM.NOT_STOP_TIMER_MODE.MSB

   rename(r7, readOperationTransferParameters)
   shl physicalChannelIndex, readOperationTransferParameters, READ_WRITE_ENGINE.PHYSICAL_CHANNEL_INDEX_SHIFT
   
   rename(ulDlTimerId, readOperationUserData)
   shl ulPhysicalChannelIndex, readOperationUserData, READ_WRITE_ENGINE.USER_DATA.PHYSICAL_CHANNEL_INDEX_SHIFT
   or_imm readOperationUserData, readOperationUserData, READ_WRITE_ENGINE.USER_DATA.RETURN_POINT.HANDLE_NEW_RE << READ_WRITE_ENGINE.USER_DATA.RETURN_POINT_SHIFT

   jump ReadMhiDoorbell
  
   forgetall()

   ; We'll return to this point after reading the MHI doorbell.
ReadWriteEngineReturnPointHandleNewRe:
   rename(r13, readOperationUserData)
   rename(r14, mhiDoorbell)
   
   ; Extract the physical channel index.
   rename(r2, ulPhysicalChannelIndex)
   and_shr readOperationUserData, ulPhysicalChannelIndex, READ_WRITE_ENGINE.USER_DATA.PHYSICAL_CHANNEL_INDEX_SHIFT, READ_WRITE_ENGINE.USER_DATA.PHYSICAL_CHANNEL_INDEX_MASK
   
   ; At this point we need to execute a part of the flow that can be reached also from the Timer Expiration ISR.
   call UlDlSynchHandlerForUlChannel
   
FinishCompletionFlow:
   go_idle
   
   forgetall()

   ; The error flow below is called from several places, therefore it's necessary that all the callers will have physical channel index in R1.
OutOfBuffersDuringReadError:
   rename(r1, physicalChannelIndex)
   rename(r5, errorDescription)
   
   ; Add error description.
   and_imm errorDescription, errorDescription, 0
   or_imm errorDescription, errorDescription, (ERROR_LOG.ERROR_CODE.OUT_OF_BUFFERS << ERROR_LOG.ERROR_CODE_SHIFT) | (READ_WRITE_ENGINE << ERROR_LOG.ACCELERATOR_OPCODE_SHIFT) | (READ_WRITE_ENGINE.READ << ERROR_LOG.ROUTINE_OPCODE_SHIFT)
   
   jump OutOfBuffersChannelError
   
   forgetall()
   
OutOfBuffersDuringWriteError:
   rename(r1, physicalChannelIndex)
   rename(r5, errorDescription)
   
   ; Add error description.
   and_imm errorDescription, errorDescription, 0
   or_imm errorDescription, errorDescription, (ERROR_LOG.ERROR_CODE.OUT_OF_BUFFERS << ERROR_LOG.ERROR_CODE_SHIFT) | (READ_WRITE_ENGINE << ERROR_LOG.ACCELERATOR_OPCODE_SHIFT) | (READ_WRITE_ENGINE.WRITE << ERROR_LOG.ROUTINE_OPCODE_SHIFT)
   
   jump OutOfBuffersChannelError
   
   forgetall()
   
   ; The error flow below is called from several places, therefore it's necessary that all the callers will have CC in R2.
NonAllocatedEventAccessError:
   rename(r2, CC)
   rename(r4, generateInterruptParameters)
   rename(r5, errorLog)
   rename(r0, temp)
   
   ; Put EE and virtual channel index in INTERRUPT_ENGINE.GENERATE_INTERRUPT.
   and_shl CC, generateInterruptParameters, CC.EE_TO_INTERRUPT_ENGINE.GENERATE_INTERRUPT.EE_SHL, CC.EE_MASK
   and_shr CC, temp, CC.CHID_TO_INTERRUPT_ENGINE.GENERATE_INTERRUPT.CHANNEL_INDEX_SHR, CC.CHID_MASK
   or generateInterruptParameters, generateInterruptParameters, temp

   ; Use EE also as Originator EE, so the interrupt will be always sent to the channel owner.
   and_shl CC, temp, CC.EE_TO_INTERRUPT_ENGINE.GENERATE_INTERRUPT.ORIGINATOR_EE_SHL, CC.EE_MASK
   or generateInterruptParameters, generateInterruptParameters, temp

   ; Add constant error information.
   or_imm generateInterruptParameters, generateInterruptParameters, INTERRUPT_ENGINE.GENERATE_INTERRUPT.GLOBAL_CHANNEL_ERROR_LSB
   or_imm generateInterruptParameters, generateInterruptParameters, INTERRUPT_ENGINE.GENERATE_INTERRUPT.GLOBAL_CHANNEL_ERROR_MSB
   
   ; Create the error log.
   and_shl CC, errorLog, CC.EE_TO_ERROR_LOG.EE_SHL, CC.EE_MASK
   
   and_shl CC, temp, CC.CHID_TO_ERROR_LOG.CHID_SHL, CC.CHID_MASK
   or errorLog, errorLog, temp
   
   or_imm errorLog, errorLog, ERROR_LOG.CHANNEL_ERROR
   or_imm errorLog, errorLog, ERROR_LOG.ERROR_CODE.NON_ALLOCATED_EVENT_ACCESS << ERROR_LOG.ERROR_CODE_SHIFT
   
   jump WriteErrorLogAndGenerateInterrupt
   
   ; Forget all the aliases.
   forgetall()

XdciIpaIfDescProcComp:
   rename(r13, ipaIfUserData)
   rename(r15, actualLengthAndEOT)
   rename(r14, EE)
   rename(r1, physicalChannelIndex)
   rename(r2, CC)
   rename(r3, readCurrent)
   rename(r18, CC_2)
   rename(r0, temp)

   ; Obtain current queue address.
   rename(r17, readNext)
   and_shr CC_2, readNext, CC.RP_SHIFT, CC.RP_MASK
   forget(CC_2)

   ; Read RBASE LSB from the channel context in DRAM.
   rename(r18, readBaseLsb)
   load_single physicalChannelIndex, readBaseLsb, CC_RAM.ELEMENT_SIZE, CC_RAM.RBASE_LOW.OFFSET, SHRAM_ID_USE, SHRAM_ID_CH_CONTEXT, CC_RAM.RBASE_LOW.MSB

   ; Check for Link TRB
   and_imm readBaseLsb, temp, 0xffff
   sub readNext, temp, temp
   beq temp, XdciIpaIfDescProcCompExit, 0

   ; Extract ERINDEX from CC.
   rename(r16, virtualEventIndex)
   and_shr CC, virtualEventIndex, CC.ERINDEX_SHIFT, CC.ERINDEX_MASK

   ; Check for first TRB
   sub readCurrent, temp, readBaseLsb
   bneq temp, XdciIpaIfDescProcCompDoorbell, 0
   forget(readBaseLsb)
   forget(readCurrent)

   ; Reset GEVNTCOUNT.
   rename(r4, transferUserData)

   ; Get the physical event ring index.
   rename(temp, physicalEventIndex)
   vir2phy physicalEventIndex, EE, virtualEventIndex, EVENT

   ; Extract GEVNTCOUNT_HI from the event scratch.
   rename(r6, GEVNTCOUNT_HI)
   load_single physicalEventIndex, GEVNTCOUNT_HI, EC_RAM.ELEMENT_SIZE, EC_RAM.SCRATCHPAD0_HIGH.OFFSET, SHRAM_ID_USE, SHRAM_ID_EV_CONTEXT, EC_RAM.SCRATCHPAD0_HIGH.MSB
   and_imm GEVNTCOUNT_HI, GEVNTCOUNT_HI, 0xff

   ; Extract GEVNTCOUNT_LO from the event scratch.
   rename(r5, GEVNTCOUNT_LO)
   load_single physicalEventIndex, GEVNTCOUNT_LO, EC_RAM.ELEMENT_SIZE, EC_RAM.SCRATCHPAD0_LOW.OFFSET, SHRAM_ID_USE, SHRAM_ID_EV_CONTEXT, EC_RAM.SCRATCHPAD0_LOW.MSB
   rename(physicalEventIndex, temp)

   rename(r7, transferParameters)
   shl physicalChannelIndex, transferParameters, READ_WRITE_ENGINE.PHYSICAL_CHANNEL_INDEX_SHIFT
   or_imm transferParameters, transferParameters, READ_WRITE_ENGINE.FOUR_BYTE_BLOCKING_TRANSFER_LSB
   or_imm transferParameters, transferParameters, READ_WRITE_ENGINE.FOUR_BYTE_BLOCKING_TRANSFER_MSB

   activate_accelerator READ_WRITE_ENGINE, READ_WRITE_ENGINE.READ, READ_WRITE_ENGINE.READ_SYNC_HINT
   beq ACCELERATOR_STATUS_REGISTER, XdciIpaIfDescProcCompDoorbell, ACCELERATOR_STATUS_REGISTER.STATUS.OUT_OF_BUFFERS

   move transferParameters, r9
   rename(transferParameters, eventCount)
   move ACCELERATOR_RETURN_VALUE_LSB_REGISTER, eventCount

   rename(r9, transferParameters)
   ;shl physicalChannelIndex, transferParameters, READ_WRITE_ENGINE.PHYSICAL_CHANNEL_INDEX_SHIFT
   ;or_imm transferParameters, transferParameters, READ_WRITE_ENGINE.FOUR_BYTE_NON_BLOCKING_TRANSFER_LSB
   ;or_imm transferParameters, transferParameters, READ_WRITE_ENGINE.FOUR_BYTE_NON_BLOCKING_TRANSFER_MSB

   activate_accelerator READ_WRITE_ENGINE, READ_WRITE_ENGINE.WRITE, READ_WRITE_ENGINE.WRITE_SYNC_HINT
   forget(transferUserData)
   forget(GEVNTCOUNT_LO)
   forget(GEVNTCOUNT_HI)
   forget(eventCount)
   forget(transferParameters)

XdciIpaIfDescProcCompDoorbell:
   ; DOORBELL EE with next queue address.
   rename(r4, transferUserData)

   rename(r7, writeNextLsb)
   load_rd_ptr writeNextLsb, physicalChannelIndex
   
   ; Get channel scratch 0.
   rename(r18, xDCIChannelScratch0)
   load_single physicalChannelIndex, xDCIChannelScratch0, CC_RAM.ELEMENT_SIZE, CC_RAM.SCRATCHPAD0_LOW.OFFSET, SHRAM_ID_USE, SHRAM_ID_CH_CONTEXT, CC_RAM.SCRATCHPAD0_LOW.MSB

   ; Extract LAST_TRB_ADDRESS_LO from the channel scratch.
   rename(r5, LAST_TRB_ADDRESS_LO)
   and_shr xDCIChannelScratch0, LAST_TRB_ADDRESS_LO, LAST_TRB_ADDRESS_LO.SHIFT, LAST_TRB_ADDRESS_LO.MASK

   ; Check for Last TRB
   sub readNext, temp, LAST_TRB_ADDRESS_LO
   bneq temp, XdciIpaIfDescProcCompNoWraparound, 0
   forget(LAST_TRB_ADDRESS_LO)
   forget(readNext)

   load_single physicalChannelIndex, writeNextLsb, CC_RAM.ELEMENT_SIZE, CC_RAM.RBASE_LOW.OFFSET, SHRAM_ID_USE, SHRAM_ID_CH_CONTEXT, CC_RAM.RBASE_LOW.MSB

XdciIpaIfDescProcCompNoWraparound:
   ; calculate EE_n_EV_CH_k_DOORBELL_0 address.
   rename(r5, EE_n_EV_CH_k_DOORBELL_LO)
   and_imm EE_n_EV_CH_k_DOORBELL_LO, EE_n_EV_CH_k_DOORBELL_LO, 0
   ; Set EE_0_EV_CH_0_DOORBELL offset
   or_imm EE_n_EV_CH_k_DOORBELL_LO, EE_n_EV_CH_k_DOORBELL_LO, 0x22100
   ; Add 16384*n
   shl EE, temp, 14
   add EE_n_EV_CH_k_DOORBELL_LO, EE_n_EV_CH_k_DOORBELL_LO, temp
   ; Add 0x8*k
   shl virtualEventIndex, temp, 3
   add EE_n_EV_CH_k_DOORBELL_LO, EE_n_EV_CH_k_DOORBELL_LO, temp

   rename(r6, EE_n_EV_CH_k_DOORBELL_HI)
   and_imm EE_n_EV_CH_k_DOORBELL_HI, EE_n_EV_CH_k_DOORBELL_HI, 0

   rename(r9, transferParameters)
   shl physicalChannelIndex, transferParameters, READ_WRITE_ENGINE.PHYSICAL_CHANNEL_INDEX_SHIFT
   or_imm transferParameters, transferParameters, (READ_WRITE_ENGINE.FOUR_BYTE_BLOCKING_TRANSFER | READ_WRITE_ENGINE.INTERNAL_TRANSFER) & LOW_SIXTEEN_BIT_MASK
   or_imm transferParameters, transferParameters, (READ_WRITE_ENGINE.FOUR_BYTE_BLOCKING_TRANSFER_MSB | READ_WRITE_ENGINE.INTERNAL_TRANSFER) & HIGH_SIXTEEN_BIT_MASK

   ; write EE_n_EV_CH_k_DOORBELL_0 data.
   activate_accelerator READ_WRITE_ENGINE, READ_WRITE_ENGINE.WRITE, READ_WRITE_ENGINE.WRITE_SYNC_HINT
   forget(transferUserData)
   forget(EE_n_EV_CH_k_DOORBELL_LO)
   forget(EE_n_EV_CH_k_DOORBELL_HI)
   forget(writeNextLsb)
   forget(transferParameters)

   ; Check for IN ZLP.
   beq ipaIfUserData, XdciIpaIfDescProcCompExit, 0

   ; Start next xDCI transfer.

   ; Extract user data to TRB0,bits 10:31.
   rename(r5, TRB0)
   shl ipaIfUserData, TRB0, IPA_IF.USER_DATA.BUFFER_ADDRESS_LO_SHIFT
   ; Extract user data to TRB1,bits 0:7.
   rename(r6, TRB1)
   shr ipaIfUserData, TRB1, IPA_IF.USER_DATA.BUFFER_ADDRESS_HI_SHIFT
   forget(ipaIfUserData)

   ; Set the physical channel index to user data.
   rename(r9, generateEventUserData)
   shl physicalChannelIndex, generateEventUserData, EVENT_ENGINE.GENERATE_EVENT.XDCI_PHYSICAL_CHANNEL_INDEX_SHIFT
   ; Set XDCI indication to user data.
   or_imm generateEventUserData, generateEventUserData, EVENT_ENGINE.GENERATE_EVENT.XDCI_MASK

   ; Get the physical event ring index.
   rename(r4, generateEventParameter0)
   vir2phy generateEventParameter0, EE, virtualEventIndex, EVENT
   forget(virtualEventIndex)

   ; Set the physical event ring index to input parameter.
   shl generateEventParameter0, generateEventParameter0, EVENT_ENGINE.GENERATE_EVENT.PHYSICAL_EVENT_INDEX_SHIFT
   ; The descriptor type set to 0 which corresponds to the transfer descriptor as we need.
   ; Set EE to input parameter.
   shl EE, temp, EVENT_ENGINE.GENERATE_EVENT.EE_SHIFT
   or generateEventParameter0, generateEventParameter0, temp
   ; Set the physical channel index to input parameter.
   shl physicalChannelIndex, temp, EVENT_ENGINE.GENERATE_EVENT.PHYSICAL_CHANNEL_INDEX_SHIFT
   or generateEventParameter0, generateEventParameter0, temp
   ; Set the memory type to MEMTYPE_NORMAL_NON_CACHEABLE
   or_imm generateEventParameter0, generateEventParameter0, MEMTYPE_NORMAL_NON_CACHEABLE << EVENT_ENGINE.GENERATE_EVENT.MEMORY_TYPE_SHIFT

   ; Init TRB3.
   rename(r8, TRB3)
   and_imm TRB3, TRB3, 0

   ; Extract CC.CHDIR.
   rename(r17, direction)
   and_shr CC, direction, CC.CHDIR_SHIFT, CC.CHDIR_MASK

   ; Check for direction.
   beq direction, XdciIpaIfDescProcCompStartTransferOut, CC.CHDIR.OUTBOUND
   forget(direction)

   ; Set TRB2 IN.
   rename(r7, TRB2)
   and_shr actualLengthAndEOT, TRB2, IPA_IF.ACTUAL_LENGTH_SHIFT, IPA_IF.ACTUAL_LENGTH_MASK
   forget(actualLengthAndEOT)

   ; Set TRB3 IN.
   ; (1 << 11) /* IOC:1, 11 */ | (TRB_CONTROL_NORMAL << 4) /* TRBCTL:6, 9:4 */ | 1 /* HWO:1, 0 */.
   or_imm TRB3, TRB3, 0x811

   ; Check for IPA ZLT.
   beq TRB2, XdciIpaIfDescProcCompStartTransferOutIn, 0

   ; Check whether ZLP is needed.

   ; Extract MPS from the EE scratch.
   rename(temp, MPS)
   rename(r17, xDCIEEScratch0)
   load_single EE, xDCIEEScratch0, EEC_RAM.ELEMENT_SIZE, EEC_RAM.SCRATCHPAD0.OFFSET, SHRAM_ID_USE, SHRAM_ID_EE_SCRATCH, EEC_RAM.SCRATCHPAD0_LOW
   nop
   and_shr xDCIEEScratch0, MPS, 15, 0x8000
   forget(xDCIEEScratch0)
   forget(EE)
   beq MPS, XdciIpaIfDescProcCompStartTransferInSS, 1
   rename(MPS, temp)

   ; HS MPS is 512
   and_imm TRB2, temp, 0xfe00
   jump XdciIpaIfDescProcCompStartTransferInZLP
   
XdciIpaIfDescProcCompStartTransferInSS:
   ; SS MPS is 1024
   and_imm TRB2, temp, 0xfc00
   
XdciIpaIfDescProcCompStartTransferInZLP:
   ; Check whether transfer length is the MPS multiplication.
   sub TRB2, temp, temp
   bneq temp, XdciIpaIfDescProcCompStartTransferOutIn, 0

   ; Optimization: clear IOC.
   ; (TRB_CONTROL_NORMAL << 4) /* TRBCTL:6, 9:4 */ | 1 /* HWO:1, 0 */.
   ;and_imm TRB3, TRB3, 0xfffff7ff

   activate_accelerator EVENT_ENGINE, EVENT_ENGINE.GENERATE_EVENT, EVENT_ENGINE.GENERATE_EVENT_HINT

   ; Start xDCI ZLP.

   ; Set TRB0 ZLP.
   and_imm TRB0, TRB0, 0

   ; Set TRB2 ZLP.
   and_imm TRB2, TRB2, 0

   ; Set TRB3 ZLP.
   ; (1 << 11) /* IOC:1, 11 */ | (TRB_CONTROL_NORMAL << 4) /* TRBCTL:6, 9:4 */ | 1 /* HWO:1, 0 */.
   ;or_imm TRB3, TRB3, 0x800
   jump XdciIpaIfDescProcCompStartTransferOutIn

XdciIpaIfDescProcCompStartTransferOut:
   ; Extract CONST_BUFF_SIZE from the channel scratch, convert to bytes and set TRB2 OUT.
   and_shr xDCIChannelScratch0, TRB2, 17, 0xf8000000
   forget(xDCIChannelScratch0)

   ; Set TRB3 OUT.
   ; (1 << 11) /* IOC:1, 11 */ | (TRB_CONTROL_NORMAL << 4) /* TRBCTL:6, 9:4 */ | (1 << 3) /* CSP:1, 3 */ | 1 /* HWO:1, 0 */.
   or_imm TRB3, TRB3, 0x819

XdciIpaIfDescProcCompStartTransferOutIn:
   activate_accelerator EVENT_ENGINE, EVENT_ENGINE.GENERATE_EVENT, EVENT_ENGINE.GENERATE_EVENT_HINT

XdciIpaIfDescProcCompExit:
   go_idle

   ; Forget all the aliases.
   forgetall()

@gsi_iram_ptr_event_gen_comp:
   ; The input parameters are delivered via R13 and R14.
   rename(r13, status)
   rename(r14, userData)
   rename(r0, temp)
   rename(r4, generateInterruptParameters)
   rename(r5, errorLog)

   ; Check for XDCI.
   and_imm userData, temp, EVENT_ENGINE.GENERATE_EVENT.XDCI_MASK
   beq temp, XdciEventCenComp, EVENT_ENGINE.GENERATE_EVENT.XDCI_MASK

   ; Make sure event generation was successful.
   and_imm status, status, EVENT_ENGINE.STATUS_MASK
   beq status, EventRingEmptyError, EVENT_ENGINE.STATUS.EVENT_QUEUE_FULL

   ; Issue INTERRUPT_ENGINE.GENERATE_INTERRUPT.
   move userData, generateInterruptParameters
   jump SendInterruptAndGoIdle

EventRingEmptyError:
   ; In case of an error we need to convert the physical event index from the user data to virtual event index and EE. 
   rename(r1, physicalEventIndex)
   and_shr userData, physicalEventIndex, INTERRUPT_ENGINE.GENERATE_INTERRUPT.CHANNEL_INDEX_SHIFT, INTERRUPT_ENGINE.GENERATE_INTERRUPT.CHANNEL_INDEX_MASK

   ; Read the event context, we're interested only in one returned value of the three, therefore there's no need to rename them.
   rename(r2, CC)
   load_channel_context CC, r6, r7, physicalEventIndex, EVENT
   
   ; Put EE and virtual event index in INTERRUPT_ENGINE.GENERATE_INTERRUPT parameters.
   and_shl CC, generateInterruptParameters, CC.EE_TO_INTERRUPT_ENGINE.GENERATE_INTERRUPT.EE_SHL, CC.EE_MASK
   and_shr CC, temp, CC.CHID_TO_INTERRUPT_ENGINE.GENERATE_INTERRUPT.CHANNEL_INDEX_SHR, CC.CHID_MASK
   or generateInterruptParameters, generateInterruptParameters, temp
   
   ; Use EE also as Originator EE, so the interrupt will be always sent to the event owner.
   and_shl CC, temp, CC.EE_TO_INTERRUPT_ENGINE.GENERATE_INTERRUPT.ORIGINATOR_EE_SHL, CC.EE_MASK
   or generateInterruptParameters, generateInterruptParameters, temp

   ; Add constant error information. 
   or_imm generateInterruptParameters, generateInterruptParameters, INTERRUPT_ENGINE.GENERATE_INTERRUPT.GLOBAL_EVENT_ERROR_LSB
   or_imm generateInterruptParameters, generateInterruptParameters, INTERRUPT_ENGINE.GENERATE_INTERRUPT.GLOBAL_EVENT_ERROR_MSB
   
   ; Create the error log.
   and_shl CC, errorLog, CC.EE_TO_ERROR_LOG.EE_SHL, CC.EE_MASK
   
   and_shl CC, temp, CC.CHID_TO_ERROR_LOG.CHID_SHL, CC.CHID_MASK
   or errorLog, errorLog, temp
   
   or_imm errorLog, errorLog, ERROR_LOG.EVENT_ERROR
   or_imm errorLog, errorLog, ERROR_LOG.ERROR_CODE.EVENT_RING_EMPTY << ERROR_LOG.ERROR_CODE_SHIFT
   
   jump WriteErrorLogAndGenerateInterrupt

   ; Forget all the aliases.
   forgetall()

   ; ********************************************************
   ; * Doorbell Stop Channel                                *
   ; ********************************************************
DoorbellStopChannel:
   rename(r1, physicalChannelIndex)
   rename(r2, originatorEE)
   
   ; Mask doorbells to the channel being stopped.
   rename(r0, temp)
   and_imm temp, temp, 0
   or_imm temp, temp, 1
   set_bit CHANNEL_DORBELL_MASK_REGISTER, CHANNEL_DORBELL_MASK_REGISTER, physicalChannelIndex, temp
   
   ; Unmask empty interrupt for this channel to get notified when all the transactions are done.
   and_imm temp, temp, 0
   set_bit CHANNEL_EMPTY_MASK_REGISTER, CHANNEL_EMPTY_MASK_REGISTER, physicalChannelIndex, temp
   
   ; Change the channel's state into STOP_IN_PROGRESS.
   ; TODO: this is my own extension to the original flow needed in gsi_iram_ptr_ch_empty ISR in order to understand that the interrupt was accepted due to Doorbell Stop flow.
   ;       Ask Ayala Miller whether this code addition is okay. If not - use a field in the channel context for the same purpose.
   update_state CC.CHSTATE_STOP_IN_PROGRESS, physicalChannelIndex, CHANNEL
   
   ; Save the originator EE in RAM part of CC.
   rename(r3, channelScratchpad)
   load_single physicalChannelIndex, channelScratchpad, CC_RAM.ELEMENT_SIZE, CC_RAM.STOP_ORIGINATOR_EE.OFFSET, SHRAM_ID_USE, SHRAM_ID_CH_CONTEXT, CC_RAM.STOP_ORIGINATOR_EE.MSB
   nop
   and_imm channelScratchpad, channelScratchpad, CC.STOP_ORIGINATOR_EE_CLEAN_MASK
   shl originatorEE, originatorEE, CC.STOP_ORIGINATOR_EE_SHIFT
   or channelScratchpad, channelScratchpad, originatorEE
   store_single physicalChannelIndex, channelScratchpad, CC_RAM.ELEMENT_SIZE, CC_RAM.STOP_ORIGINATOR_EE.OFFSET, SHRAM_ID_USE, SHRAM_ID_CH_CONTEXT, CC_RAM.STOP_ORIGINATOR_EE.MSB

   go_idle

   ; Forget all the aliases.
   forgetall()

   ; ********************************************************
   ; * Stop Channel                                         *
   ; ********************************************************
StopChannel:
   rename(r1, physicalChannelIndex)
   rename(r2, originatorEE)
 
InternalStopSequenceEntryPoint:
   ; We'll need a register initialized to 1 later.
   rename(r13, one)
   and_imm one, one, 0
   or_imm one, one, 1
   
   ; Read the channel context, we're interested only in one returned value of the three, therefore there's no need to rename them.
   rename(r0, CC)
   load_channel_context CC, r3, r6, physicalChannelIndex, CHANNEL

   ; Extract CC.CHDIR.
   rename(r14, channelDirection)
   and_shr CC, channelDirection, CC.CHDIR_SHIFT, CC.CHDIR_MASK
   beq channelDirection, NotIpaConsumerChannelOrChainIsZero, CC.CHDIR.INBOUND

   ; Extract the CHAIN bit value for this channel.
   rename(r3, chainBit)
   check_bit CHAIN_REGISTER, chainBit, physicalChannelIndex, 1
   beq chainBit, NotIpaConsumerChannelOrChainIsZero, 0
   forget(chainBit)

IpaConsumerChannelAndChainIsOne:
   ; Save the originator EE in RAM part of CC for the other flows.
   rename(r6, channelScratchpad)
   rename(r3, shiftedOriginatorEE)
   load_single physicalChannelIndex, channelScratchpad, CC_RAM.ELEMENT_SIZE, CC_RAM.STOP_ORIGINATOR_EE.OFFSET, SHRAM_ID_USE, SHRAM_ID_CH_CONTEXT, CC_RAM.STOP_ORIGINATOR_EE.MSB
   nop
   and_imm channelScratchpad, channelScratchpad, CC.STOP_ORIGINATOR_EE_CLEAN_MASK
   shl originatorEE, shiftedOriginatorEE, CC.STOP_ORIGINATOR_EE_SHIFT
   or channelScratchpad, channelScratchpad, shiftedOriginatorEE
   store_single physicalChannelIndex, channelScratchpad, CC_RAM.ELEMENT_SIZE, CC_RAM.STOP_ORIGINATOR_EE.OFFSET, SHRAM_ID_USE, SHRAM_ID_CH_CONTEXT, CC_RAM.STOP_ORIGINATOR_EE.MSB

   ; Set STOP_REGISTER[physicalChannelIndex] to 1.
   set_bit STOP_REGISTER, STOP_REGISTER, physicalChannelIndex, one

   ; End the flow here in this case.
   go_idle

NotIpaConsumerChannelOrChainIsZero:
   ; Change the channel's state into STOP_IN_PROGRESS.
   update_state CC.CHSTATE_STOP_IN_PROGRESS, physicalChannelIndex, CHANNEL

   ; Mask the channel doorbells.
   set_bit CHANNEL_DORBELL_MASK_REGISTER, CHANNEL_DORBELL_MASK_REGISTER, physicalChannelIndex, one
   forget(one)
   
   ; Issue RE_ENGINE.DISABLE_CHANNEL.
   move physicalChannelIndex, r4

   ; Configure user data now:
   rename(r5, disableChannelUserData)

   ; Store physical channel index in the user data.
   shl physicalChannelIndex, disableChannelUserData, RE_ENGINE.USER_DATA.PHYSICAL_CHANNEL_INDEX_SHIFT
   
   ; Store originator EE in the user data.
   shl originatorEE, shiftedOriginatorEE, RE_ENGINE.USER_DATA.ORIGINATOR_EE_SHIFT
   or disableChannelUserData, disableChannelUserData, shiftedOriginatorEE

   activate_accelerator RE_ENGINE, RE_ENGINE.DISABLE_CHANNEL, RE_ENGINE.DISABLE_CHANNEL_HINT
   forget(disableChannelUserData)
   
   ; Out of the 3 possible return values only one is considered an error - ACCELERATOR_STATUS_REGISTER.STATUS.OUT_OF_BUFFERS.
   ; The other two - ACCELERATOR_STATUS_REGISTER.STATUS.SUCCESS and ACCELERATOR_STATUS_REGISTER.STATUS.BECAME_FULL indicate successful completion.
   beq ACCELERATOR_STATUS_REGISTER, OutOfBuffersDuringDisableChannelError, ACCELERATOR_STATUS_REGISTER.STATUS.OUT_OF_BUFFERS

   go_idle

OutOfBuffersDuringDisableChannelError:
   rename(r5, errorDescription)
   
   ; Add error description.
   and_imm errorDescription, errorDescription, 0
   or_imm errorDescription, errorDescription, (ERROR_LOG.ERROR_CODE.OUT_OF_BUFFERS << ERROR_LOG.ERROR_CODE_SHIFT) | (RE_ENGINE << ERROR_LOG.ACCELERATOR_OPCODE_SHIFT) | (RE_ENGINE.DISABLE_CHANNEL << ERROR_LOG.ROUTINE_OPCODE_SHIFT)
   
   jump OutOfBuffersOriginatorEEChannelError
   
   ; Forget all the aliases.
   forgetall()

XdciEventCenComp:
   rename(r14, userData)

   ; Extract physical channel index from user data.
   rename(r1, physicalChannelIndex)
   and_shr userData, physicalChannelIndex, EVENT_ENGINE.GENERATE_EVENT.XDCI_PHYSICAL_CHANNEL_INDEX_SHIFT, EVENT_ENGINE.GENERATE_EVENT.XDCI_PHYSICAL_CHANNEL_INDEX_MASK
   forget(userData)

   ; DEPCMDn Update Transfer
   rename(r4, transferUserData)

   ; Extract DEPCMD_LO from the channel scratch 1.
   rename(r5, DEPCMD_LO)
   load_single physicalChannelIndex, DEPCMD_LO, CC_RAM.ELEMENT_SIZE, CC_RAM.SCRATCHPAD0_HIGH.OFFSET, SHRAM_ID_USE, SHRAM_ID_CH_CONTEXT, CC_RAM.SCRATCHPAD0_HIGH.MSB

   ; Get channel scratch 2.
   rename(r16, xDCIChannelScratch2)
   load_single physicalChannelIndex, xDCIChannelScratch2, CC_RAM.ELEMENT_SIZE, CC_RAM.SCRATCHPAD1_LOW.OFFSET, SHRAM_ID_USE, SHRAM_ID_CH_CONTEXT, CC_RAM.SCRATCHPAD1_LOW.MSB

   ; Extract DEPCMD_HI from the channel scratch.
   rename(r6, DEPCMD_HI)
   and_imm xDCIChannelScratch2, DEPCMD_HI, 0xff

   ; Get channel scratch 0.
   rename(r18, xDCIChannelScratch0)
   load_single physicalChannelIndex, xDCIChannelScratch0, CC_RAM.ELEMENT_SIZE, CC_RAM.SCRATCHPAD0_LOW.OFFSET, SHRAM_ID_USE, SHRAM_ID_CH_CONTEXT, CC_RAM.SCRATCHPAD0_LOW.MSB

   ; Extract XferRscIdx from the channel scratch and set to CmdParam, 22:16.
   rename(r7, DEPCMD)
   and_shr xDCIChannelScratch0, DEPCMD, 4, 0x7f00000

   ; Set DEPUPDXFER to CmdTyp, 3:0.
   or_imm DEPCMD, DEPCMD, 0x7

   rename(r9, transferParameters)
   shl physicalChannelIndex, transferParameters, READ_WRITE_ENGINE.PHYSICAL_CHANNEL_INDEX_SHIFT
   or_imm transferParameters, transferParameters, READ_WRITE_ENGINE.FOUR_BYTE_BLOCKING_TRANSFER_LSB
   or_imm transferParameters, transferParameters, READ_WRITE_ENGINE.FOUR_BYTE_BLOCKING_TRANSFER_MSB

   activate_accelerator READ_WRITE_ENGINE, READ_WRITE_ENGINE.WRITE, READ_WRITE_ENGINE.WRITE_SYNC_HINT

   go_idle

   ; Forget all the aliases.
   forgetall()

@gsi_iram_ptr_ch_dis_comp:
   ; The input parameters are delivered via R13 and R14.
   rename(r13, status)
   rename(r14, userData)

   ; Allocate a temporary register for the calculations.
   rename(r15, temp)

   ; TODO: Is status check needed? Ask Amir Shmul and Ayala Miller.
   ;       After the check the status register can be released.
   forget(status)

   ; Export a possible error indication.
   rename(r0, error)
   and_shr userData, error, RE_ENGINE.USER_DATA.ERROR_TYPE_SHIFT, RE_ENGINE.USER_DATA.ERROR_TYPE_MASK

   ; Export the physical channel index.
   rename(r1, physicalChannelIndex)
   and_imm userData, physicalChannelIndex, RE_ENGINE.USER_DATA.PHYSICAL_CHANNEL_INDEX_MASK

   ; We must check now that channel disabling didn't happen due to an error.
   bneq error, DisableChannelCompleteInErrorHandling, RE_ENGINE.USER_DATA.ERROR_TYPE_NO_ERROR

   ; Read the channel context, we're interested only in one returned value of the three, therefore there's no need to rename them.
   rename(r2, CC)
   load_channel_context CC, r3, r6, physicalChannelIndex, CHANNEL

   ; Extract the originator EE from the user data directly to its position in INTERRUPT_ENGINE.GENERATE_INTERRUPT parameters.
   rename(r18, shiftedOriginatorEE)
   and_shl userData, shiftedOriginatorEE, RE_ENGINE.USER_DATA.ORIGINATOR_EE_TO_INTERRUPT_ENGINE.GENERATE_INTERRUPT.ORIGINATOR_EE_SHL, RE_ENGINE.USER_DATA.ORIGINATOR_EE_MASK

   ; Extract CC.CHDIR.
   rename(r3, channelDirection)
   and_shr CC, channelDirection, CC.CHDIR_SHIFT, CC.CHDIR_MASK

   ; For consumer channel only check if PENDING_REQUEST_REGISTER[physicalChannelIndex] == 1.
   bneq channelDirection, NotIpaConsumerChannel, CC.CHDIR.OUTBOUND

IpaConsumerChannel:   
   check_bit PENDING_REQUEST_REGISTER, temp, physicalChannelIndex, 1
   beq temp, SendChannelStageChangeInterrupt, 1

NotIpaConsumerChannel:
   ; Put EE into IPA_IF parameters.
   rename(r7, ipaIfParameter3)
   and_shr CC, ipaIfParameter3, CC.EE_SHIFT, CC.EE_MASK

   ; Put virtual channel index into IPA_IF parameters.
   rename(r16, shiftedVirtualChannelIndex)
   and_shl CC, shiftedVirtualChannelIndex, CC.CHID_TO_IPA_IF.VIRTUAL_CHANNEL_INDEX_SHL, CC.CHID_MASK
   or ipaIfParameter3, ipaIfParameter3, shiftedVirtualChannelIndex
   forget(CC)

   ; Construct the user data for IPA_IF.
   rename(r4, ipaIfParameter0)
   and_shl userData, ipaIfParameter0, RE_ENGINE.USER_DATA.ORIGINATOR_EE_TO_IPA_IF.USER_DATA.ORIGINATOR_EE_SHL, RE_ENGINE.USER_DATA.ORIGINATOR_EE_MASK   
   shl physicalChannelIndex, temp, IPA_IF.USER_DATA.PHYSICAL_CHANNEL_INDEX_SHIFT
   or ipaIfParameter0, ipaIfParameter0, temp

   ; Issue IPA_IF.STOP.
   activate_accelerator IPA_IF, IPA_IF.STOP, IPA_IF.STOP_HINT
   forget(ipaIfParameter0)
   
   ; Out of the 3 possible return values only one is considered an error - ACCELERATOR_STATUS_REGISTER.STATUS.OUT_OF_BUFFERS_IPA_IF.
   ; The other two - ACCELERATOR_STATUS_REGISTER.STATUS.SUCCESS and ACCELERATOR_STATUS_REGISTER.STATUS.BECAME_FULL_IPA_IF indicate successful completion.
   beq ACCELERATOR_STATUS_REGISTER, OutOfBuffersDuringStopChannelError, ACCELERATOR_STATUS_REGISTER.STATUS.OUT_OF_BUFFERS_IPA_IF
   
   go_idle

OutOfBuffersDuringStopChannelError:
   rename(r2, originatorEE)
   rename(r5, errorDescription)
   
   ; Extract Originator EE from the parameters.
   and_shr userData, originatorEE, RE_ENGINE.USER_DATA.ORIGINATOR_EE_SHIFT, RE_ENGINE.USER_DATA.ORIGINATOR_EE_MASK
    
   ; Construct the error description.
   and_imm errorDescription, errorDescription, 0
   or_imm errorDescription, errorDescription, (ERROR_LOG.ERROR_CODE.OUT_OF_BUFFERS << ERROR_LOG.ERROR_CODE_SHIFT) | (IPA_IF << ERROR_LOG.ACCELERATOR_OPCODE_SHIFT) | (IPA_IF.STOP << ERROR_LOG.ROUTINE_OPCODE_SHIFT)
   
   jump OutOfBuffersOriginatorEEChannelError
 
   ; Forget all the aliases.
   forgetall()
   
XdciChDisComp:
   rename(r1, physicalChannelIndex)
   rename(r0, temp)
   
   ; Unmask channel doorbells.
   and_imm temp, temp, 0
   set_bit CHANNEL_DORBELL_MASK_REGISTER, CHANNEL_DORBELL_MASK_REGISTER, physicalChannelIndex, temp

   ; Enable channel.
   rename(r4, enableChannelInput)

   ; Store physical channel index in the input.
   shl physicalChannelIndex, enableChannelInput, RE_ENGINE.ROUTINE.PHYSICAL_CHANNEL_INDEX_SHIFT

   ; The returned status is always success and therefore it's not checked.
   activate_accelerator RE_ENGINE, RE_ENGINE.ENABLE_CHANNEL, RE_ENGINE.ENABLE_CHANNEL_HINT

   go_idle

   ; Forget all the aliases.
   forgetall()

@gsi_iram_ptr_periph_if_tlv_in_1:
   ; The input parameters are delivered via R13-R18, but we need only R13 and R16.
   rename(r13, userData)
   rename(r16, status)

   ; Allocate a temporary register for the calculations.
   rename(r15, temp)
   
   ; TODO: Status check? Make sure with Ayala Miller and Ron Plewinski it's not needed.
   forget(status)

   ; Extract physical channel index from the user data.
   rename(r1, physicalChannelIndex)
   and_shr userData, physicalChannelIndex, IPA_IF.USER_DATA.PHYSICAL_CHANNEL_INDEX_SHIFT, IPA_IF.USER_DATA.PHYSICAL_CHANNEL_INDEX_MASK
   
   ; Extract the originator EE from the user data directly to its position in INTERRUPT_ENGINE.GENERATE_INTERRUPT parameters.
   rename(r18, shiftedOriginatorEE)
   and_shl userData, shiftedOriginatorEE, IPA_IF.USER_DATA.ORIGINATOR_EE_TO_INTERRUPT_ENGINE.GENERATE_INTERRUPT.ORIGINATOR_EE_SHL, IPA_IF.USER_DATA.ORIGINATOR_EE_MASK
   
   ; Read the channel context, we're interested only in one returned value of the three, therefore there's no need to rename them.
   rename(r2, CC)
   load_channel_context CC, r3, r6, physicalChannelIndex, CHANNEL

   ; Extract CC.CHDIR.
   rename(r3, channelDirection)
   and_shr CC, channelDirection, CC.CHDIR_SHIFT, CC.CHDIR_MASK

   ; For producer channel only check if PENDING_REQUEST_REGISTER[physicalChannelIndex] == 1.
   bneq channelDirection, NotIpaProducerChannel, CC.CHDIR.INBOUND   

   check_bit PENDING_REQUEST_REGISTER, temp, physicalChannelIndex, 1
   beq temp, SendChannelStageChangeInterrupt, 1

NotIpaProducerChannel:
   ; Extract ERINDEX from CC.
   rename(r9, virtualEventIndex)
   and_shr CC, virtualEventIndex, CC.ERINDEX_SHIFT, CC.ERINDEX_MASK
   
   ; In case of eventless channel we go directly to the channel state change and interrupt generation.
   beq virtualEventIndex, UpdateChannelStateAndSendInterrupt, CC.ERINDEX.UNALLOCATED_EVENT

   ; Extract EE from CC.
   rename(r8, EE)
   and_shr CC, EE, CC.EE_SHIFT, CC.EE_MASK

   ; Get the physical event ring index.
   rename(physicalChannelIndex, physicalEventIndex)
   vir2phy physicalEventIndex, EE, virtualEventIndex, EVENT

   ; Make sure the translation was successful.
   and_imm temp, temp, 0
   or_imm temp, temp, VIR2PHY_FAILURE
   sub temp, temp, physicalEventIndex
   beq temp, NonAllocatedEventAccessError, 0

   ; Construct INTERRUPT_ENGINE.STOP_INTERRUPT_MODERATION parameters.
   rename(r4, stopInterruptModerationParameters)
   shl physicalEventIndex, stopInterruptModerationParameters, INTERRUPT_ENGINE.STOP_INTERRUPT_MODERATION.PHYSICAL_EVENT_INDEX_SHIFT
   ; Set the memory type to MEMTYPE_NORMAL_NON_CACHEABLE
   or_imm stopInterruptModerationParameters, stopInterruptModerationParameters, MEMTYPE_NORMAL_NON_CACHEABLE << INTERRUPT_ENGINE.STOP_INTERRUPT_MODERATION.MEMORY_TYPE_SHIFT
   ; Construct INTERRUPT_ENGINE.STOP_INTERRUPT_MODERATION user data.
   ; The user data defined in such a way that we could directly copy it from IPA_IF user data.
   rename(r5, stopInterruptModerationUserData)
   move userData, stopInterruptModerationUserData

StopModeration:   
   activate_accelerator INTERRUPT_ENGINE, INTERRUPT_ENGINE.STOP_INTERRUPT_MODERATION, INTERRUPT_ENGINE.STOP_INTERRUPT_MODERATION_HINT
   forget(stopInterruptModerationParameters)
   forget(stopInterruptModerationUserData)

   ; Out of the 3 possible return values only one is considered an error - ACCELERATOR_STATUS_REGISTER.STATUS.OUT_OF_BUFFERS.
   ; The other two - ACCELERATOR_STATUS_REGISTER.STATUS.SUCCESS and ACCELERATOR_STATUS_REGISTER.STATUS.BECAME_FULL indicate successful completion.
   ; In case of ACCELERATOR_STATUS_REGISTER.STATUS.OUT_OF_BUFFERS we repeat the accelerator activation.
   beq ACCELERATOR_STATUS_REGISTER, StopModeration, ACCELERATOR_STATUS_REGISTER.STATUS.OUT_OF_BUFFERS
   
   go_idle

OutOfBuffersDuringStopInterruptModerationError:
   rename(r5, errorDescription)
   
   ; Create error description.
   and_imm errorDescription, errorDescription, 0
   or_imm errorDescription, errorDescription, (ERROR_LOG.ERROR_CODE.OUT_OF_BUFFERS << ERROR_LOG.ERROR_CODE_SHIFT) | (INTERRUPT_ENGINE << ERROR_LOG.ACCELERATOR_OPCODE_SHIFT) | (INTERRUPT_ENGINE.STOP_INTERRUPT_MODERATION << ERROR_LOG.ROUTINE_OPCODE_SHIFT)
   
   jump OutOfBuffersEventError

   ; Forget all the aliases.
   forgetall()
   
@gsi_iram_ptr_int_mod_stoped:
   rename(r13, status)
   rename(r14, userData)
   
   ; Extract physical channel index from the user data.
   rename(r1, physicalChannelIndex)
   and_shr userData, physicalChannelIndex, INTERRUPT_ENGINE.USER_DATA.PHYSICAL_CHANNEL_INDEX_SHIFT, INTERRUPT_ENGINE.USER_DATA.PHYSICAL_CHANNEL_INDEX_MASK
   
   ; Extract the originator EE from the user data.
   rename(r18, shiftedOriginatorEE)
   and_shl userData, shiftedOriginatorEE, INTERRUPT_ENGINE.USER_DATA.ORIGINATOR_EE_TO_INTERRUPT_ENGINE.GENERATE_INTERRUPT.ORIGINATOR_EE_SHL, INTERRUPT_ENGINE.USER_DATA.ORIGINATOR_EE_MASK
   
UpdateChannelStateAndSendInterrupt:   
   ; Update the channel status to STOPPED.
   update_state CC.CHSTATE_STOPPED, physicalChannelIndex, CHANNEL
   
SendChannelStageChangeInterrupt:   
   ; Generate an interrupt.
   rename(r4, generateInterruptParameters)
   shl physicalChannelIndex, generateInterruptParameters, INTERRUPT_ENGINE.GENERATE_INTERRUPT.CHANNEL_INDEX_SHIFT

   ; Store the originator EE for the future usage by INTERRUPT_ENGINE.GENERATE_INTERRUPT.
   or generateInterruptParameters, generateInterruptParameters, shiftedOriginatorEE

   ; Add missing constant fields to the input parameters.
   or_imm generateInterruptParameters, generateInterruptParameters, INTERRUPT_ENGINE.GENERATE_INTERRUPT.CHANNEL_STATE_CHANGE
   
   jump SendInterruptAndGoIdle
   
   ; Forget all the aliases.
   forgetall()

   ; ********************************************************
   ; * Timer Expiration Interrupt                           *
   ; ********************************************************
@gsi_iram_ptr_timer_expired:
   rename(r13, userData)
   rename(r14, timerId)

   ; R14 also contains status which is always 0, so we ignore it.
   and_shr timerId, timerId, TIMER.TIMER_ID_SHIFT, TIMER.TIMER_ID_MASK
   
   ; Release the timer to be able to allocate it again.
   move timerId, r4
   activate_accelerator TIMER, TIMER.STOP_AND_RELEASE_TIMER, TIMER.STOP_AND_RELEASE_TIMER_HINT
   
   rename(r2, physicalChannelIndex)
   and_shr userData, physicalChannelIndex, TIMER.USER_DATA.PHYSICAL_CHANNEL_INDEX_SHIFT, TIMER.USER_DATA.PHYSICAL_CHANNEL_INDEX_MASK

   rename(r0, timerUsage)
   and_shr userData, timerUsage, TIMER.USER_DATA.TIMER_USAGE_SHIFT, TIMER.USER_DATA.TIMER_USAGE_MASK
   
   beq timerUsage, UlDlSyncTimer, TIMER_USAGE.UL_DL_SYNC_TIMER
   forget(timerUsage)
   
   ; If we've reached this point then the timer purpose is unknown (not supposed to happen).
   ; In this case we abort further ISR execution.
   go_idle
   
UlDlSyncTimer:
   rename(r7, readOperationTransferParameters)
   shl physicalChannelIndex, readOperationTransferParameters, READ_WRITE_ENGINE.PHYSICAL_CHANNEL_INDEX_SHIFT
   
   rename(r4, readOperationUserData)
   shl physicalChannelIndex, readOperationUserData, READ_WRITE_ENGINE.USER_DATA.PHYSICAL_CHANNEL_INDEX_SHIFT
   or_imm readOperationUserData, readOperationUserData, READ_WRITE_ENGINE.USER_DATA.RETURN_POINT.TIMER_EXPIRED << READ_WRITE_ENGINE.USER_DATA.RETURN_POINT_SHIFT
   jump ReadMhiDoorbell
   forget(readOperationTransferParameters)
   forget(readOperationUserData)

   forgetall()

   ; We'll continue from this point after obtaining MHI doorbell.
ReadWriteEngineReturnPointTimerExpired:
   rename(r13, userData)
   rename(r14, mhiDoorbell)
   rename(r0, temp)
   
   ; Extract the physical channel index.
   rename(r2, physicalChannelIndex)
   and_shr userData, physicalChannelIndex, READ_WRITE_ENGINE.USER_DATA.PHYSICAL_CHANNEL_INDEX_SHIFT, READ_WRITE_ENGINE.USER_DATA.PHYSICAL_CHANNEL_INDEX_MASK
   
   call UlDlSynchHandlerForUlChannel

   go_idle

   ; Forget all the aliases.
   forgetall()

@gsi_iram_ptr_ch_empty:
   rename(r2, physicalChannelIndex)
   move r13, physicalChannelIndex

   ; Check whether we entered this ISR due to Doorbell Stop Channel flow.
   rename(r0, temp)
   load_state temp, physicalChannelIndex, CHANNEL
   bneq temp, NotInDoorbellStopChannelFlow, CC.CHSTATE_STOP_IN_PROGRESS
   
InDoorbellStopChannelFlow:   
   ; Mask empty interrupt for this channel and continue to the stop flow.
   and_imm temp, temp, 0
   or_imm temp, temp, 1
   set_bit CHANNEL_EMPTY_MASK_REGISTER, CHANNEL_EMPTY_MASK_REGISTER, physicalChannelIndex, temp

   jump DoStopSequence
   
NotInDoorbellStopChannelFlow:
   ; Check whether we're in Polling Mode.
   rename(r1, channelScratchpad)
   load_single physicalChannelIndex, channelScratchpad, CC_RAM.ELEMENT_SIZE, CC_RAM.POLLING_MODE.OFFSET, SHRAM_ID_USE, SHRAM_ID_CH_CONTEXT, CC_RAM.POLLING_MODE.MSB
   nop

   rename(r3, pollingMode)
   and_shr channelScratchpad, pollingMode, CC.POLLING_MODE_SHIFT, CC.POLLING_MODE_MASK
   beq pollingMode, NotInPollingMode, 0
   forget(pollingMode)
   
   rename(r7, readOperationTransferParameters)
   shl physicalChannelIndex, readOperationTransferParameters, READ_WRITE_ENGINE.PHYSICAL_CHANNEL_INDEX_SHIFT
   
   rename(r4, readOperationUserData)
   shl physicalChannelIndex, readOperationUserData, READ_WRITE_ENGINE.USER_DATA.PHYSICAL_CHANNEL_INDEX_SHIFT
   or_imm readOperationUserData, readOperationUserData, READ_WRITE_ENGINE.USER_DATA.RETURN_POINT.CHANNEL_EMPTY << READ_WRITE_ENGINE.USER_DATA.RETURN_POINT_SHIFT
   jump ReadMhiDoorbell

NotInPollingMode:
   go_idle
   
   ; Forget all the aliases.
   forgetall()
   
   ; We'll continue from this point after obtaining MHI doorbell.
 ReadWriteEngineReturnPointChannelEmpty:
   rename(r13, userData)
   rename(r14, mhiDoorbell)
   rename(r0, temp)
   
   rename(r2, physicalChannelIndex)
   and_shr userData, physicalChannelIndex, READ_WRITE_ENGINE.USER_DATA.PHYSICAL_CHANNEL_INDEX_SHIFT, READ_WRITE_ENGINE.USER_DATA.PHYSICAL_CHANNEL_INDEX_MASK
   
   call GetReadWritePointers
   rename(r17, CC)
   rename(r9, writePointer)

   sub mhiDoorbell, temp, writePointer
   bneq temp, DlChannelNotEqualDoorbells, 0
   forget(writePointer)

DlChannelEqualDoorbells:
   ; Mask empty interrupt.
   and_imm temp, temp, 0
   or_imm temp, temp, 1
   set_bit CHANNEL_EMPTY_MASK_REGISTER, CHANNEL_EMPTY_MASK_REGISTER, physicalChannelIndex, temp
   
   rename(r7, TCE[2])
   and_imm TCE[2], TCE[2], 0
   or_imm TCE[2], TCE[2], TCE.CODE_OOB

   call ChannelModeChange
   jump DlChannelProcessingComplete

DlChannelNotEqualDoorbells:
   rename(r4, updateDoorbellInputParameters)

   shl mhiDoorbell, updateDoorbellInputParameters, RE_ENGINE.ROUTINE.DOORBELL_VALUE_SHIFT
   or updateDoorbellInputParameters, updateDoorbellInputParameters, physicalChannelIndex

   activate_accelerator RE_ENGINE, RE_ENGINE.UPDATE_DOORBELL, RE_ENGINE.UPDATE_DOORBELL_HINT

DlChannelProcessingComplete:
   go_idle

   ; The event isn't allocated, we need to place CC in R2 and continue to the error handling flow.
EventIsNotAllocatedInChannelEmptyHandler:
   forget(physicalChannelIndex)
   move CC, r2
   jump NonAllocatedEventAccessError

   ; Forget all the aliases.
   forgetall()
   
ReadMhiDoorbell:
   rename(r2, physicalChannelIndex)
   
   ; Read the MHI doorbell address from CC.
   rename(r5, mhiDoorbellAddressLow)
   rename(r6, mhiDoorbellAddressHigh)
   load_single physicalChannelIndex, mhiDoorbellAddressLow, CC_RAM.ELEMENT_SIZE, CC_RAM.MHI_DOORBELL_ADDRESS_LOW.OFFSET, SHRAM_ID_USE, SHRAM_ID_CH_CONTEXT, CC_RAM.MHI_DOORBELL_ADDRESS_LOW.MSB
   load_single physicalChannelIndex, mhiDoorbellAddressHigh, CC_RAM.ELEMENT_SIZE, CC_RAM.MHI_DOORBELL_ADDRESS_HIGH.OFFSET, SHRAM_ID_USE, SHRAM_ID_CH_CONTEXT, CC_RAM.MHI_DOORBELL_ADDRESS_HIGH.MSB

   rename(r7, transferParameters)
   or_imm transferParameters, transferParameters, READ_WRITE_ENGINE.FOUR_BYTE_NON_BLOCKING_TRANSFER_LSB
   or_imm transferParameters, transferParameters, READ_WRITE_ENGINE.FOUR_BYTE_NON_BLOCKING_TRANSFER_MSB

   activate_accelerator READ_WRITE_ENGINE, READ_WRITE_ENGINE.READ, READ_WRITE_ENGINE.READ_ASYNC_HINT
   
   ; Out of the 3 possible return values only one is considered an error - ACCELERATOR_STATUS_REGISTER.STATUS.OUT_OF_BUFFERS.
   ; The other two - ACCELERATOR_STATUS_REGISTER.STATUS.SUCCESS and ACCELERATOR_STATUS_REGISTER.STATUS.BECAME_FULL indicate successful completion.
   beq ACCELERATOR_STATUS_REGISTER, ReadMhiDoorbellFailed, ACCELERATOR_STATUS_REGISTER.STATUS.OUT_OF_BUFFERS
   
   go_idle

ReadMhiDoorbellFailed:
   move physicalChannelIndex, r1
   jump OutOfBuffersDuringReadError
   
   ; Forget all the aliases.
   forgetall()

@gsi_iram_ptr_read_eng_comp:
   rename(r14, readDataLsb)
   rename(r15, readDataMsb)
   rename(r0, temp)
   rename(r1, index)
   rename(r2, completionCode)
   
   ; Save the read register value in the shared ram.
   and_imm temp, temp, 0
   store_mul_imm temp, readDataLsb, readDataMsb, temp, DRAM.REGISTER_ACCESS_SW_COMMUNICATION_OUT_COMPLETION_CODE
   
MarkCompletion:   
   and_imm index, index, 0   
   and_imm completionCode, completionCode, 0
   or_imm completionCode, completionCode, READ_WRITE_ENGINE.OPERATION_COMPLETED_SUCCESSFULLY
   store_single index, completionCode, 0, 0, DRAM.REGISTER_ACCESS_SW_COMMUNICATION_OUT_COMPLETION_CODE, 0
   
   go_idle
   
   ; Forget all the aliases.
   forgetall()

@gsi_iram_ptr_write_eng_comp:
   ; Mark the operation completion.
   jump MarkCompletion
   
   ; ********************************************************
   ; * Functions                                            *
   ; ********************************************************

   ; ********************************************************
   ; * Manage Prefetch List                                 *
   ; ********************************************************
   ; Parameters:
   ;   R2 - physical channel index
   ; Modified registers:
   ;   R0, R4, R5, R6, R7, R8, R9, R16, R17, R18
PrefetchControl:
   rename(r2, physicalChannelIndex)
   rename(r0, temp)
   
   ; Read MAX_OUTSTANDING_TRES.
   rename(r5, maxOutstandingTREs)
   load_single physicalChannelIndex, maxOutstandingTREs, CC_RAM.ELEMENT_SIZE, CC_RAM.MAX_OUTSTANDING_TRES.OFFSET, SHRAM_ID_USE, SHRAM_ID_CH_CONTEXT, CC_RAM.MAX_OUTSTANDING_TRES.MSB
   
   ; Obtain the read and write pointers.
   call GetReadWritePointers
   rename(r18, ringSize)
   rename(r8, readPointer)
   rename(r9, writePointer)
   
   ; Do this AND_SHR and not right after LOAD_SINGLE to eliminate the NOP needed for the data to get loaded.
   and_shr maxOutstandingTREs, maxOutstandingTREs, CC.MAX_OUTSTANDING_TRES_SHIFT, CC.MAX_OUTSTANDING_TRES_MASK
   
   ; Read the last doorbell value reported to RE Engine from a register.
   rename(r6, reEngineDB)
   
   ; Calculate the delta between the read and the write pointers. This is the maximal number of TREs available for processing at the moment.
   rename(r7, availableTREs)
   sub writePointer, availableTREs, readPointer
   
   ; If the delta is negative we must add the ring size to it.
   and_imm availableTREs, temp, SIGN_BIT_MASK
   beq temp, WpRpDeltaCalculationDone, 0
   add availableTREs, availableTREs, ringSize
WpRpDeltaCalculationDone:
   
   ; We need to compare now availableTREs to maxOutstandingTREs.
   sub maxOutstandingTREs, temp, availableTREs
   and_imm temp, temp, SIGN_BIT_MASK
   bneq temp, MaxOutstandingTREsBelowAvailableTREs, 0
   
MaxOutstandingTREsNotBelowAvailableTREs:
   ; If writePointer is equal to reEngineDB there's nothing to do here any more.
   sub writePointer, temp, reEngineDB
   beq temp, PrefetchControlDone, 0
   
   ; Issue RE_ENGINE.UPDATE_DOORBELL with the current write pointer.
   rename(r4, updateDoorbellInputParameters)
   shl writePointer, updateDoorbellInputParameters, RE_ENGINE.ROUTINE.DOORBELL_VALUE_SHIFT
   or updateDoorbellInputParameters, updateDoorbellInputParameters, physicalChannelIndex
   activate_accelerator RE_ENGINE, RE_ENGINE.UPDATE_DOORBELL, RE_ENGINE.UPDATE_DOORBELL_HINT
   
   ; Unmask the channel doorbells.
   and_imm temp, temp, 0
   set_bit CHANNEL_DORBELL_MASK_REGISTER, CHANNEL_DORBELL_MASK_REGISTER, physicalChannelIndex, temp

   return
   
MaxOutstandingTREsBelowAvailableTREs:
   ; Read OUTSTANDING_THRESHOLD parameter from CC.
   rename(availableTREs, outstandingThreshold)
   load_single physicalChannelIndex, outstandingThreshold, CC_RAM.ELEMENT_SIZE, CC_RAM.OUTSTANDING_THRESHOLD.OFFSET, SHRAM_ID_USE, SHRAM_ID_CH_CONTEXT, CC_RAM.OUTSTANDING_THRESHOLD.MSB
   
   ; Calculate the available outstanding space.
   rename(r16, reeDbRpDelta)
   sub reEngineDB, reeDbRpDelta, readPointer

   ; Do this AND_SHR and not right after LOAD_SINGLE to eliminate the NOP needed for the data to get loaded.
   and_shr outstandingThreshold, outstandingThreshold, CC.OUTSTANDING_THRESHOLD_SHIFT, CC.OUTSTANDING_THRESHOLD_MASK
   
   ; If the delta is negative we must add the ring size to it.
   and_imm reeDbRpDelta, temp, SIGN_BIT_MASK
   beq temp, ReeDbRpDeltaCalculationDone, 0
   add reeDbRpDelta, reeDbRpDelta, ringSize
ReeDbRpDeltaCalculationDone:
   rename(r17, availableOutstandingSpace)
   sub maxOutstandingTREs, availableOutstandingSpace, reeDbRpDelta
   
   ; If availableOutstandingSpace is below outstandingThreshold there's nothing to do here any more.
   sub availableOutstandingSpace, temp, outstandingThreshold
   and_imm temp, temp, SIGN_BIT_MASK
   bneq temp, PrefetchControlDone, 0

   ; Issue RE_ENGINE.UPDATE_DOORBELL.
   add reEngineDB, updateDoorbellInputParameters, availableOutstandingSpace
   
   ; If the value is above the ring size we must subtract it from the sum.
   sub updateDoorbellInputParameters, temp, ringSize
   and_imm temp, temp, SIGN_BIT_MASK
   bneq temp, newReEngineDBCalculationDone, 0
   sub updateDoorbellInputParameters, updateDoorbellInputParameters, ringSize
newReEngineDBCalculationDone:
   
   shl updateDoorbellInputParameters, updateDoorbellInputParameters, RE_ENGINE.ROUTINE.DOORBELL_VALUE_SHIFT
   or updateDoorbellInputParameters, updateDoorbellInputParameters, physicalChannelIndex
   activate_accelerator RE_ENGINE, RE_ENGINE.UPDATE_DOORBELL, RE_ENGINE.UPDATE_DOORBELL_HINT

PrefetchControlDone:
   return
   
   ; Forget all the aliases.
   forgetall()

   ; ********************************************************
   ; * UL/DL Synchronization Timer configuration            *
   ; ********************************************************
   ; Parameters:
   ;   R2 - physical channel index
   ; Modified registers:
   ;   R4, R5, R6
ConfigureUlDlSyncTimer:
   rename(r2, physicalChannelIndex)

   ; Configure the timer.
   ; TODO: Define timer interface and configuration parameters.
   rename(r4, timerConfiguration)
   and_imm timerConfiguration, timerConfiguration, 0
   or_imm timerConfiguration, timerConfiguration, TIMER.TIMER_CONFGURATION_UL_DL_SYNC

   ; Save the timer purpose and physical channel index in the user data.
   ; This will also initialize TIMER_USAGE to 0 which corresponds to UL_DL_SYNC_TIMER.
   rename(r5, timerUserData)
   shl physicalChannelIndex, timerUserData, TIMER.USER_DATA.PHYSICAL_CHANNEL_INDEX_SHIFT

   activate_accelerator TIMER, TIMER.REGISTER_TIMER, TIMER.REGISTER_TIMER_HINT
   forget(timerConfiguration)
   forget(timerUserData)

   ; Out of the 3 possible return values only one is considered an error - ACCELERATOR_STATUS_REGISTER.STATUS.OUT_OF_BUFFERS.
   ; The other two - ACCELERATOR_STATUS_REGISTER.STATUS.SUCCESS and ACCELERATOR_STATUS_REGISTER.STATUS.BECAME_FULL indicate successful completion.
   rename(r6, activationStatus)
   and_imm ACCELERATOR_STATUS_REGISTER, activationStatus, ACCELERATOR_STATUS_REGISTER.STATUS_MASK
   beq activationStatus, OutOfBuffersDuringRegisterTimerError, ACCELERATOR_STATUS_REGISTER.STATUS.OUT_OF_BUFFERS
   forget(activationStatus)

   ; We need to save the timer ID in CC to be accessed by other ISRs.
   rename(r4, shiftedTimerId)
   rename(r6, channelScratchpad)
   load_single physicalChannelIndex, channelScratchpad, CC_RAM.ELEMENT_SIZE, CC_RAM.POLLING_MODE.OFFSET, SHRAM_ID_USE, SHRAM_ID_CH_CONTEXT, CC_RAM.POLLING_MODE.MSB
   and_shl ACCELERATOR_STATUS_REGISTER, shiftedTimerId, ACCELERATOR_STATUS_REGISTER.TIMER_ID_TO_CC.UL_DL_SYNC_TIMER_ID_SHL, ACCELERATOR_STATUS_REGISTER.TIMER_ID_MASK
   and_imm channelScratchpad, channelScratchpad, CC.UL_DL_SYNC_TIMER_ID_CLEAN_MASK
   or channelScratchpad, channelScratchpad, shiftedTimerId
   store_single physicalChannelIndex, channelScratchpad, CC_RAM.ELEMENT_SIZE, CC_RAM.POLLING_MODE.OFFSET, SHRAM_ID_USE, SHRAM_ID_CH_CONTEXT, CC_RAM.POLLING_MODE.MSB

   return

OutOfBuffersDuringRegisterTimerError:
   rename(r5, errorDescription)
   
   ; Put the physical channel index in R1 as required by OutOfBuffersChannelError procedure.
   move physicalChannelIndex, r1

   ; Add error description.
   and_imm errorDescription, errorDescription, 0
   or_imm errorDescription, errorDescription, (ERROR_LOG.ERROR_CODE.OUT_OF_BUFFERS << ERROR_LOG.ERROR_CODE_SHIFT) | (TIMER << ERROR_LOG.ACCELERATOR_OPCODE_SHIFT) | (TIMER.REGISTER_TIMER << ERROR_LOG.ROUTINE_OPCODE_SHIFT)
   
   jump OutOfBuffersChannelError

   ; Forget all the aliases.
   forgetall()

   ; ********************************************************
   ; * UL/DL Synchronization Read Pointers                  *
   ; ********************************************************
   ; Parameters:
   ;   R2 - physical channel index
   ; Return values:
   ;   R17 - CC
   ;   R18 - ring size
   ;   R8 - read pointer
   ;   R9 - write pointer
GetReadWritePointers:
   rename(r2, physicalChannelIndex)

   rename(r17, CC)
   rename(r18, ringSize)
   rename(r8, readPointer)
   rename(r9, writePointer)
   load_channel_context CC, writePointer, readPointer, physicalChannelIndex, CHANNEL

   ; Extract the ring size.
   and_shr readPointer, ringSize, CC.RLEN_SHIFT, CC.RLEN_MASK

   ; Extract the pointers.
   and_shr readPointer, readPointer, CC.RP_SHIFT, CC.RP_MASK
   and_shr writePointer, writePointer, CC.WP_SHIFT, CC.WP_MASK

   return

   ; Forget all the aliases.
   forgetall()
   
   ; ********************************************************
   ; * UL/DL Synchronization Handler for UL Channel         *
   ; ********************************************************
   ; Parameters:
   ;   R2 - physical channel index of UL channel
   ;   R14 - MHI doorbell
   ; Modified registers:
   ;   R0, R3, R4, R5, R6, R7, R8, R9, R17, R18
UlDlSynchHandlerForUlChannel:
   rename(r2, physicalChannelIndex)
   rename(r14, mhiDoorbell)
   
   call GetReadWritePointers
   rename(r17, CC)
   rename(r8, readPointer)
   rename(r9 , writePointer)

   ; Check whether the last written doorbell is the same as the new doorbell from MHI channel.
   rename(r0, temp)
   sub mhiDoorbell, temp, writePointer
   beq temp, EqualDoorbells, 0

NotEqualDoorbells:
   ; If the doorbells aren't equal we inform RE_ENGINE about the new doorbell value and reconfigure the timer.
   rename(r4, updateDoorbellInputParameters)

   shl mhiDoorbell, updateDoorbellInputParameters, RE_ENGINE.ROUTINE.DOORBELL_VALUE_SHIFT
   or updateDoorbellInputParameters, updateDoorbellInputParameters, physicalChannelIndex

   activate_accelerator RE_ENGINE, RE_ENGINE.UPDATE_DOORBELL, RE_ENGINE.UPDATE_DOORBELL_HINT
   forget(updateDoorbellInputParameters)

   jump ConfigureUlDlSyncTimer

EqualDoorbells:
   ; Compare the read and the write pointers.
   sub writePointer, temp, readPointer
   beq temp, NoMoreTREs, 0
   forget(readPointer)
   forget(writePointer)
   
   jump ConfigureUlDlSyncTimer

NoMoreTREs:
   rename(r7, TCE[2])
   and_imm TCE[2], TCE[2], 0
   or_imm TCE[2], TCE[2], TCE.CODE_DB_MODE

   ; Fall through to ChannelModeChange.
   forgetall()

   ; ********************************************************
   ; * UL/DL Synchronization Channel Mode Change            *
   ; ********************************************************
   ; Parameters:
   ;   R2 - physical channel index
   ;   R7 - TCE.CODE that encodes the channel mode
   ;   R17 - CC
   ; Modified registers:
   ;   R0, R3, R4, R5, R6, R7, R8, R9, R18
ChannelModeChange:
   rename(r2, physicalChannelIndex)
   rename(r7, TCE[2])   
   rename(r17, CC)
   rename(r0, temp)
   
   ; Mark that we're not in polling mode.
   rename(r1, channelScratchpad)
   load_single physicalChannelIndex, channelScratchpad, CC_RAM.ELEMENT_SIZE, CC_RAM.POLLING_MODE.OFFSET, SHRAM_ID_USE, SHRAM_ID_CH_CONTEXT, CC_RAM.POLLING_MODE.MSB
   nop
   and_imm channelScratchpad, channelScratchpad, CC.POLLING_MODE_CLEAN_MASK
   store_single physicalChannelIndex, channelScratchpad, CC_RAM.ELEMENT_SIZE, CC_RAM.POLLING_MODE.OFFSET, SHRAM_ID_USE, SHRAM_ID_CH_CONTEXT, CC_RAM.POLLING_MODE.MSB
   forget(channelScratchpad)
   
   ; Generate an event.
   rename(r4, generateEventParameter0)
   rename(r5, TCE[0])
   rename(r6, TCE[1])
   rename(r8, TCE[3])
   rename(r9, generateEventUserData)

   ; Extract ERINDEX from CC.
   rename(r18, virtualEventIndex)
   and_shr CC, virtualEventIndex, CC.ERINDEX_SHIFT, CC.ERINDEX_MASK

   ; Extract EE from CC.
   rename(r3, EE)
   and_shr CC, EE, CC.EE_SHIFT, CC.EE_MASK

   ; Get the physical event ring index.
   vir2phy generateEventParameter0, EE, virtualEventIndex, EVENT
   forget(virtualEventIndex)

   ; Make sure the translation was successful.
   and_imm temp, temp, 0
   or_imm temp, temp, VIR2PHY_FAILURE
   sub temp, temp, generateEventParameter0
   beq temp, EventIsNotAllocated, 0

   ; TODO: Here we also exploit the fact that as a result descriptor type field will be set to 0 which corresponds to the transfer descriptor as we need.
   shl generateEventParameter0, generateEventParameter0, EVENT_ENGINE.GENERATE_EVENT.PHYSICAL_EVENT_INDEX_SHIFT
   shl EE, temp, EVENT_ENGINE.GENERATE_EVENT.EE_SHIFT
   or generateEventParameter0, generateEventParameter0, temp
   shl physicalChannelIndex, temp, EVENT_ENGINE.GENERATE_EVENT.PHYSICAL_CHANNEL_INDEX_SHIFT
   or generateEventParameter0, generateEventParameter0, temp
   ; Set the memory type to MEMTYPE_NORMAL_NON_CACHEABLE
   or_imm generateEventParameter0, generateEventParameter0, MEMTYPE_NORMAL_NON_CACHEABLE << EVENT_ENGINE.GENERATE_EVENT.MEMORY_TYPE_SHIFT

   ; Construct the TCE.
   and_imm TCE[0], TCE[0], 0
   and_imm TCE[1], TCE[1], 0
   and_shl CC, TCE[3], CC.CHID_TO_TCE.CHID_SHL, CC.CHID_MASK
   or_imm TCE[3], TCE[3], TCE.TYPE_TCE

   ; For MHI channels add MHI_CHANNEL_INDEX_BASE to the GSI channel index.
   and_shr CC, temp, CC.CHTYPE_SHIFT, CC.CHTYPE_MASK
   bneq temp, NotMhiChannelInChannelModeChange, CC.CHTYPE.MHI
   
   ; Read MHI_CHANNEL_INDEX_BASE from EEC.
   load_single EE, temp, EEC_RAM.ELEMENT_SIZE, EEC_RAM.MHI_CHANNEL_INDEX_BASE.OFFSET, SHRAM_ID_USE, SHRAM_ID_EE_SCRATCH, EEC_RAM.MHI_CHANNEL_INDEX_BASE.MSB
   nop
   and_imm temp, temp, EEC.MHI_CHANNEL_INDEX_BASE_MASK
   add TCE[3], TCE[3], temp
NotMhiChannelInChannelModeChange:
   
   ; Construct the user data.
   and_shr generateEventParameter0, generateEventUserData, EVENT_ENGINE.GENERATE_EVENT.PHYSICAL_EVENT_INDEX_TO_INTERRUPT_ENGINE.GENERATE_INTERRUPT.CHANNEL_INDEX_SHR, EVENT_ENGINE.GENERATE_EVENT.PHYSICAL_EVENT_INDEX_MASK
   shl EE, temp, INTERRUPT_ENGINE.GENERATE_INTERRUPT.ORIGINATOR_EE_SHIFT
   or generateEventUserData, generateEventUserData, temp
   or_imm generateEventUserData, generateEventUserData, INTERRUPT_ENGINE.GENERATE_INTERRUPT.DESCRIPTOR_PROCESSING_SUCCEESS

   ; Fall through to GenerateEventAndCheckForError.
   move physicalChannelIndex, r1
   forgetall()
   
   ; ********************************************************
   ; * UL/DL Synchronization Event Generation Handling      *
   ; ********************************************************
   ; Parameters:
   ;   R1 - physical channel index
   ;   R4-R9 - parameters for EVENT_ENGINE.GENERATE_EVENT
   ; Modified registers:
   ;   R4, R5, R6, R7, R8, R9
GenerateEventAndCheckForError:
   rename(r1, physicalChannelIndex)
   activate_accelerator EVENT_ENGINE, EVENT_ENGINE.GENERATE_EVENT, EVENT_ENGINE.GENERATE_EVENT_HINT

   ; Out of the 3 possible return values only one is considered an error - ACCELERATOR_STATUS_REGISTER.STATUS.OUT_OF_BUFFERS.
   ; The other two - ACCELERATOR_STATUS_REGISTER.STATUS.SUCCESS and ACCELERATOR_STATUS_REGISTER.STATUS.BECAME_FULL indicate successful completion.
   beq ACCELERATOR_STATUS_REGISTER, GenerateEventError, ACCELERATOR_STATUS_REGISTER.STATUS.OUT_OF_BUFFERS
   
   ; Any other status value except for OUT_OF_BUFFERS denotes successful activation in which case we'll go directly to "return" below.
GenerateEventNoError:
   return
   
GenerateEventError:
   rename(r4, generateEventParameter0)
   rename(r9, temp)

   and_shr generateEventParameter0, generateEventParameter0, EVENT_ENGINE.GENERATE_EVENT.PHYSICAL_EVENT_INDEX_SHIFT, EVENT_ENGINE.GENERATE_EVENT.PHYSICAL_EVENT_INDEX_MASK
   rename(generateEventParameter0, physicalEventIndex)
   
   ; Check whether the event is in UL/DL synchronization mode.
   ; If this is the case we don't generate OUT_OF_BUFFERS error.
   ; TODO: The architectural definition of this flow may change in which case the implementation will be different.
   rename(r5, ulDlSyncActive)
   load_single physicalEventIndex, ulDlSyncActive, EC_RAM.ELEMENT_SIZE, EC_RAM.UL_DL_SYNC_ACTIVE.OFFSET, SHRAM_ID_USE, SHRAM_ID_EV_CONTEXT, EC_RAM.UL_DL_SYNC_ACTIVE.MSB
   nop
   and_imm ulDlSyncActive, ulDlSyncActive, EC.UL_DL_SYNC_ACTIVE_MASK
   beq ulDlSyncActive, OutOfBuffersDuringGenerateEventError, 0
   forget(ulDlSyncActive)
   
   ; At this point we're in UL/DL Synchronization flow.
   ; We need to compare MHI and GSI doorbells.
   rename(r8, writePointer)
   load_channel_context temp, writePointer, temp, physicalEventIndex, EVENT
   and_shr writePointer, writePointer, CC.WP_SHIFT, CC.WP_MASK
   
   ; Read the doorbell value from the MHI EC.
   rename(r5, mhiDoorbellAddressLow)
   rename(r6, mhiDoorbellAddressHigh)
   load_single physicalEventIndex, mhiDoorbellAddressLow, EC_RAM.ELEMENT_SIZE, EC_RAM.MHI_RP_ADDRESS_LOW.OFFSET, SHRAM_ID_USE, SHRAM_ID_EV_CONTEXT, EC_RAM.MHI_RP_ADDRESS_LOW.MSB
   load_single physicalEventIndex, mhiDoorbellAddressHigh, EC_RAM.ELEMENT_SIZE, EC_RAM.MHI_RP_ADDRESS_HIGH.OFFSET, SHRAM_ID_USE, SHRAM_ID_EV_CONTEXT, EC_RAM.MHI_RP_ADDRESS_HIGH.MSB
   ; TODO: the current recommendation is to add 8 to the address of RP and this was to get the address of WP.
   ;       The question is whether it's possible that a carry will be created in this operation. Ayala Miller will check, till then I'm doing it as recommended.
   and_imm temp, temp, 0
   or_imm temp, temp, 8
   add mhiDoorbellAddressLow, mhiDoorbellAddressLow, temp

   rename(r7, transferParameters)
   shl physicalEventIndex, transferParameters, READ_WRITE_ENGINE.PHYSICAL_CHANNEL_INDEX_SHIFT
   or_imm transferParameters, transferParameters, READ_WRITE_ENGINE.EIGHT_BYTE_BLOCKING_TRANSFER_LSB
   or_imm transferParameters, transferParameters, READ_WRITE_ENGINE.EIGHT_BYTE_BLOCKING_TRANSFER_MSB

   activate_accelerator READ_WRITE_ENGINE, READ_WRITE_ENGINE.READ, READ_WRITE_ENGINE.READ_SYNC_HINT
   
   ; Out of the 3 possible return values only one is considered an error - ACCELERATOR_STATUS_REGISTER.STATUS.OUT_OF_BUFFERS.
   ; The other two - ACCELERATOR_STATUS_REGISTER.STATUS.SUCCESS and ACCELERATOR_STATUS_REGISTER.STATUS.BECAME_FULL indicate successful completion.
   beq ACCELERATOR_STATUS_REGISTER, OutOfBuffersDuringReadError, ACCELERATOR_STATUS_REGISTER.STATUS.OUT_OF_BUFFERS
   
   ; We need only the low 16 bits of the doorbell.
   rename(mhiDoorbellAddressLow, mhiDoorbell)
   move ACCELERATOR_RETURN_VALUE_LSB_REGISTER, mhiDoorbell
   and_imm mhiDoorbell, mhiDoorbell, LOW_SIXTEEN_BIT_MASK
   
   ; Are the doorbells equal?
   sub writePointer, temp, mhiDoorbell
   beq temp, GenerateEventNoError, 0
   
   ; If the doorbells aren't equal we inform RE_ENGINE about the new doorbell value.

   ; TODO: this is a non-trivial piece of code involving address calculation and the usage of READ_WRITE_ENGINE.
   ;       Since the whole sequence isn't 100% final I'm delaying the implementation to a further stage.
   forget(mhiDoorbell)
   
OutOfBuffersDuringGenerateEventError:
   rename(r5, errorDescription)
   
   ; Put the physical channel index in R1 as required by OutOfBuffersEventError procedure.
   forget(physicalChannelIndex)
   move physicalEventIndex, r1
   
   ; Add error description.
   and_imm errorDescription, errorDescription, 0
   or_imm errorDescription, errorDescription, (ERROR_LOG.ERROR_CODE.OUT_OF_BUFFERS << ERROR_LOG.ERROR_CODE_SHIFT) | (EVENT_ENGINE << ERROR_LOG.ACCELERATOR_OPCODE_SHIFT) | (EVENT_ENGINE.GENERATE_EVENT << ERROR_LOG.ROUTINE_OPCODE_SHIFT)
   
   jump OutOfBuffersEventError

   ; Forget all the aliases.
   forgetall()

   ; The event isn't allocated, we need to place CC in R2 and continue to the error handling flow.
EventIsNotAllocated:
   rename(r17, CC)
   move CC, r2
   jump NonAllocatedEventAccessError

   ; Forget all the aliases.
   forgetall()
   
   ; ********************************************************
   ; * Error sequences                                      *
   ; ********************************************************

   ; ********************************************************
   ; * A generic flow to create the error log and continue  *
   ; * with the error interrupt generation                  *
   ; ********************************************************

   ; Parameters:
   ;   R4 - interrupt description (INTERRUPT_ENGINE.GENERATE_INTERRUPT input)
   ;   R5 - error log to write into the EE context
WriteErrorLogAndGenerateInterrupt:
   rename(r4, generateInterruptParameters)
   rename(r5, errorLog)

   rename(r0, temp)
   rename(r6, errorLogTargetEE)
   ; TODO: There's a chance we'll want to save the error log in the context of the target EE and not in the context of the originator EE.
   ;       In this case the commented out code below should be used.
   ; The EE for which the error is generated is taken from the error log itself.
   ;and_shr errorLog, errorLogTargetEE, ERROR_LOG.EE_SHIFT, ERROR_LOG.EE_MASK
   
   ; To store the error log we'll use originator EE as an index into the EE context array.
   and_shr generateInterruptParameters, errorLogTargetEE, INTERRUPT_ENGINE.GENERATE_INTERRUPT.ORIGINATOR_EE_SHIFT, INTERRUPT_ENGINE.GENERATE_INTERRUPT.ORIGINATOR_EE_MASK
   
   ; Read the error log from the EE context.
   load_single errorLogTargetEE, temp, EEC_RAM.ELEMENT_SIZE, EEC_RAM.ERROR_LOG.OFFSET, SHRAM_ID_USE, SHRAM_ID_EE_SCRATCH, EEC_RAM.ERROR_LOG.MSB
   nop
   
   ; If the error log is already present there we won't override it with the new error information, i.e. First Error Reported policy.
   bneq temp, SkipErrorLogUpdate, 0
   
   ; Store the error log into the EE context.
   store_single errorLogTargetEE, errorLog, EEC_RAM.ELEMENT_SIZE, EEC_RAM.ERROR_LOG.OFFSET, SHRAM_ID_USE, SHRAM_ID_EE_SCRATCH, EEC_RAM.ERROR_LOG.MSB

SkipErrorLogUpdate:   
   jump SendInterruptAndGoIdle
   
   ; Forget all the aliases.
   forgetall()
   
   ; ********************************************************
   ; * Malformed Ring Element                               *
   ; ********************************************************

   ; Parameters:
   ;   R2 - physical channel index
MalformedRingElementError:
   rename(r2, physicalChannelIndex)

   ; We should call RE_ENGINE.POP.
   ; The returned status is always success and therefore it's not checked.
   rename(r4, popParameters)
   move physicalChannelIndex, popParameters
   activate_accelerator RE_ENGINE, RE_ENGINE.POP, RE_ENGINE.POP_HINT
   forget(popParameters)
   
   ; Disable the channel now.
   rename(r4, disableChannelInput)
   shl physicalChannelIndex, disableChannelInput, RE_ENGINE.ROUTINE.PHYSICAL_CHANNEL_INDEX_SHIFT

   ; Put the physical channel index also in the user data.
   rename(r5, disableChannelUserData)
   shl physicalChannelIndex, disableChannelUserData, RE_ENGINE.USER_DATA.PHYSICAL_CHANNEL_INDEX_SHIFT

   ; Store the error type in the user data.
   or_imm disableChannelUserData, disableChannelUserData, RE_ENGINE.USER_DATA.ERROR_TYPE_MALFORMED_TRE << RE_ENGINE.USER_DATA.ERROR_TYPE_SHIFT

   ; After RE_ENGINE.DISABLE_CHANNEL we'll return to DisableChannelCompleteInErrorHandling.
   ; TODO: What should we do if RE_ENGINE.DISABLE_CHANNEL ends with OUT_OF_BUFFERS error? Should we go directly to the interrupt generation?
   activate_accelerator RE_ENGINE, RE_ENGINE.DISABLE_CHANNEL, RE_ENGINE.DISABLE_CHANNEL_HINT

   go_idle

   ; Forget all the aliases.
   forgetall()

   ; Parameters:
   ;   R1 - physical channel index
DisableChannelCompleteInErrorHandling:
   rename(r0, error)
   beq error, XdciChDisComp, RE_ENGINE.USER_DATA.ERROR_TYPE_XDCI_WRONG_HWO
   forget(error)

   rename(r1, physicalChannelIndex)
   rename(r2, temp)

   ; We need to update the channel status to ERROR.
   update_state CC.CHSTATE_ERROR, physicalChannelIndex, CHANNEL

   ; We need to clean CHAIN_REGISTER[physicalChannelIndex] bit.
   ; This is required because the SW most likely will want to stop the channel with malformed TRE and stop will never complete if CHAIN_REGISTER[physicalChannelIndex] is set.
   and_imm temp, temp, 0
   set_bit CHAIN_REGISTER, CHAIN_REGISTER, physicalChannelIndex, temp

   ; Read the channel context, we're interested only in one returned value of the three, therefore there's no need to rename them.
   rename(r3, CC)
   load_channel_context CC, r4, r5, physicalChannelIndex, CHANNEL

   ; Issue INTERRUPT_ENGINE.GENERATE_INTERRUPT.
   rename(r4, generateInterruptData)

   ; Store the virtual channel index in INTERRUPT_ENGINE.GENERATE_INTERRUPT parameters.
   and_shr CC, generateInterruptData, CC.CHID_TO_INTERRUPT_ENGINE.GENERATE_INTERRUPT.CHANNEL_INDEX_SHR, CC.CHID_MASK

   ; Store EE in INTERRUPT_ENGINE.GENERATE_INTERRUPT parameters.
   and_shl CC, temp, CC.EE_TO_INTERRUPT_ENGINE.GENERATE_INTERRUPT.EE_SHL, CC.EE_MASK
   or generateInterruptData, generateInterruptData, temp
   
   ; Store Originator EE in INTERRUPT_ENGINE.GENERATE_INTERRUPT parameters (the same as EE in this case).
   and_shl CC, temp, CC.EE_TO_INTERRUPT_ENGINE.GENERATE_INTERRUPT.ORIGINATOR_EE_SHL, CC.EE_MASK
   or generateInterruptData, generateInterruptData, temp

   ; Add the constant error fields.
   or_imm generateInterruptData, generateInterruptData, INTERRUPT_ENGINE.GENERATE_INTERRUPT.GLOBAL_CHANNEL_ERROR_LSB
   or_imm generateInterruptData, generateInterruptData, INTERRUPT_ENGINE.GENERATE_INTERRUPT.GLOBAL_CHANNEL_ERROR_MSB

   ; Create the error log.
   rename(r5, errorLog)   
   and_shl CC, errorLog, CC.EE_TO_ERROR_LOG.EE_SHL, CC.EE_MASK
   
   and_shl CC, temp, CC.CHID_TO_ERROR_LOG.CHID_SHL, CC.CHID_MASK
   or errorLog, errorLog, temp
   
   or_imm errorLog, errorLog, ERROR_LOG.CHANNEL_ERROR
   or_imm errorLog, errorLog, ERROR_LOG.ERROR_CODE.MALFORMED_TRE << ERROR_LOG.ERROR_CODE_SHIFT
   
   jump WriteErrorLogAndGenerateInterrupt

   ; Forget all the aliases.
   forgetall()

   ; ********************************************************
   ; * Out Of Buffers                                       *
   ; ********************************************************

   ; Parameters:
   ;   R1 - physical channel index
   ;   R5 - error description
OutOfBuffersChannelError:
   rename(r1, physicalChannelIndex)
   rename(r5, errorDescription)
   rename(r0, temp)
   rename(r3, CC)
   rename(r4, generateInterruptParameters)
   
   ; Read the channel context.
   load_channel_context CC, r14, r15, physicalChannelIndex, CHANNEL
   
   ; Put EE and virtual channel index in INTERRUPT_ENGINE.GENERATE_INTERRUPT parameters.
   and_shr CC, generateInterruptParameters, CC.CHID_TO_INTERRUPT_ENGINE.GENERATE_INTERRUPT.CHANNEL_INDEX_SHR, CC.CHID_MASK
   and_shl CC, temp, CC.EE_TO_INTERRUPT_ENGINE.GENERATE_INTERRUPT.EE_SHL, CC.EE_MASK
   or generateInterruptParameters, generateInterruptParameters, temp

   ; Add Originator EE (same as EE) to INTERRUPT_ENGINE.GENERATE_INTERRUPT parameters.
   shl temp, temp, INTERRUPT_ENGINE.GENERATE_INTERRUPT.EE_TO_INTERRUPT_ENGINE.GENERATE_INTERRUPT.ORIGINATOR_EE_SHL
   or generateInterruptParameters, generateInterruptParameters, temp
   
   ; Add constant error information.
OutOfBuffersChannelErrorCommonFlow:
   or_imm generateInterruptParameters, generateInterruptParameters, INTERRUPT_ENGINE.GENERATE_INTERRUPT.GLOBAL_CHANNEL_ERROR_LSB
   or_imm generateInterruptParameters, generateInterruptParameters, INTERRUPT_ENGINE.GENERATE_INTERRUPT.GLOBAL_CHANNEL_ERROR_MSB
 
   ; Create the error log. The partial information is already present in the register - accelerator and routine encoding, error code.
   rename(errorDescription, errorLog)
   
   and_shl CC, temp, CC.EE_TO_ERROR_LOG.EE_SHL, CC.EE_MASK
   or errorLog, errorLog, temp
   
   and_shl CC, temp, CC.CHID_TO_ERROR_LOG.CHID_SHL, CC.CHID_MASK
   or errorLog, errorLog, temp
   
   or_imm errorLog, errorLog, ERROR_LOG.CHANNEL_ERROR
   
   jump WriteErrorLogAndGenerateInterrupt
 
   ; Forget all the aliases.
   forgetall()

   ; Parameters:
   ;   R1 - physical channel index
   ;   R2 - originator EE
   ;   R5 - error description
OutOfBuffersOriginatorEEChannelError:
   rename(r1, physicalChannelIndex)
   rename(r2, originatorEE)
   rename(r5, errorDescription)
   rename(r0, temp)
   rename(r3, CC)
   rename(r4, generateInterruptParameters)
   
   ; Read the channel context.
   load_channel_context CC, r14, r15, physicalChannelIndex, CHANNEL
   
   ; Put EE and virtual channel index in INTERRUPT_ENGINE.GENERATE_INTERRUPT parameters.
   and_shr CC, generateInterruptParameters, CC.CHID_TO_INTERRUPT_ENGINE.GENERATE_INTERRUPT.CHANNEL_INDEX_SHR, CC.CHID_MASK
   and_shl CC, temp, CC.EE_TO_INTERRUPT_ENGINE.GENERATE_INTERRUPT.EE_SHL, CC.EE_MASK
   or generateInterruptParameters, generateInterruptParameters, temp

   ; Add Originator EE to INTERRUPT_ENGINE.GENERATE_INTERRUPT parameters.
   shl originatorEE, temp, INTERRUPT_ENGINE.GENERATE_INTERRUPT.ORIGINATOR_EE_SHIFT
   or generateInterruptParameters, generateInterruptParameters, temp

   jump OutOfBuffersChannelErrorCommonFlow
 
   ; Forget all the aliases.
   forgetall()
   
   ; Parameters:
   ;   R1 - physical event index
   ;   R5 - error description
OutOfBuffersEventError:
   rename(r1, physicalEventIndex)
   rename(r5, errorDescription)
   rename(r0, temp)
   rename(r3, CC)
   rename(r4, generateInterruptParameters)
   
   ; Read the channel context.
   load_channel_context CC, temp, temp, physicalEventIndex, EVENT
   
   ; Put EE and virtual event index in INTERRUPT_ENGINE.GENERATE_INTERRUPT parameters.
   and_shr CC, generateInterruptParameters, CC.EVCHID_TO_INTERRUPT_ENGINE.GENERATE_INTERRUPT.EVENT_INDEX_SHR, CC.EVCHID_MASK
   and_shl CC, temp, CC.EE_TO_INTERRUPT_ENGINE.GENERATE_INTERRUPT.EE_SHL, CC.EE_MASK
   or generateInterruptParameters, generateInterruptParameters, temp

   ; Add Originator EE (same as EE) to INTERRUPT_ENGINE.GENERATE_INTERRUPT parameters.
   shl temp, temp, INTERRUPT_ENGINE.GENERATE_INTERRUPT.EE_TO_INTERRUPT_ENGINE.GENERATE_INTERRUPT.ORIGINATOR_EE_SHL
   or generateInterruptParameters, generateInterruptParameters, temp

   ; Add constant error information.
   or_imm generateInterruptParameters, generateInterruptParameters, INTERRUPT_ENGINE.GENERATE_INTERRUPT.GLOBAL_EVENT_ERROR_LSB
   or_imm generateInterruptParameters, generateInterruptParameters, INTERRUPT_ENGINE.GENERATE_INTERRUPT.GLOBAL_EVENT_ERROR_MSB
   
   ; Create the error log. The partial information is already present in the register - accelerator and routine encoding, error code.
   rename(errorDescription, errorLog)
   
   and_shl CC, temp, CC.EE_TO_ERROR_LOG.EE_SHL, CC.EE_MASK
   or errorLog, errorLog, temp
   
   and_shl CC, temp, CC.EVCHID_TO_ERROR_LOG.EVCHID_SHL, CC.EVCHID_MASK
   or errorLog, errorLog, temp
   
   or_imm errorLog, errorLog, ERROR_LOG.EVENT_ERROR
   
   jump WriteErrorLogAndGenerateInterrupt
   
   ; Forget all the aliases.
   forgetall()

   ; ********************************************************
   ; * DRAM related constants                               *
   ; ********************************************************
.definitions:
   ; ********************************************************
   ; * DRAM layout                                          *
   ; ********************************************************
.data:
   ; In Stingray the data layout becomes dynamic, so there's no need in the static labels in the .data section anymore.

; Test data.
; GSI_UNUSED_SHRAM_OFFSET
   skip(0xBA0)
DRAM.REGISTER_ACCESS_SW_COMMUNICATION_IN_PARAMETER1:
   skip(4)
DRAM.REGISTER_ACCESS_SW_COMMUNICATION_IN_PARAMETER2:
   skip(4)
DRAM.REGISTER_ACCESS_SW_COMMUNICATION_IN_PARAMETER3:
   skip(4)
DRAM.REGISTER_ACCESS_SW_COMMUNICATION_IN_PARAMETER4:
   skip(4)
DRAM.REGISTER_ACCESS_SW_COMMUNICATION_IN_PARAMETER5:
   skip(4)
DRAM.REGISTER_ACCESS_SW_COMMUNICATION_IN_PARAMETER6:
   skip(4)

DRAM.REGISTER_ACCESS_SW_COMMUNICATION_OUT_COMPLETION_CODE:
   skip(4)
DRAM.REGISTER_ACCESS_SW_COMMUNICATION_OUT_READ_DATA_LSB:
   skip(4)
DRAM.REGISTER_ACCESS_SW_COMMUNICATION_OUT_READ_DATA_MSB:
   skip(4)
